#!/bin/bash
# LaunchAgent wrapper for the LiteLLM spend Prometheus exporter.
#
# Named descriptively (NOT python3) so the macOS "App Background Activity"
# notification keys on a meaningful basename. Resolves the venv python that
# has prometheus_client (created by install.sh) and execs the exporter.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EXPORTER="$SCRIPT_DIR/../litellm_spend_exporter.py"
VENV_PY="${LITELLM_SPEND_VENV:-$HOME/.local/share/claude-watch/litellm-spend-venv/bin/python}"

if [ ! -x "$VENV_PY" ]; then
    echo "litellm-spend-exporter: venv python not found at $VENV_PY; run install.sh" >&2
    exit 1
fi

exec "$VENV_PY" "$EXPORTER"
