      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, kind) (agent_psi_api_errors{window=\"300\",model!=\"all\",kind!=\"refusal\",kind!=\"auth\"})",
          "legendFormat": "{{model}} · {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
