{
  "title": "agent-PSI — Claude Code fleet pressure",
  "uid": "agent-psi",
  "tags": [
    "claude",
    "agent-psi"
  ],
  "timezone": "browser",
  "editable": true,
  "style": "dark",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Live subagents",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "agent_psi_live_agents",
          "legendFormat": "live subagents",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#268bd2",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Total live SUB-AGENT transcripts this scrape (workers active within the live window, default 900s). The main loop is deliberately excluded — it is a dispatcher, not a worker."
    },
    {
      "id": 2,
      "title": "Inference — productive vs stalled (60s)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_min(agent_psi_inference_full{scope=\"main\",window=\"60\",model=\"all\"} - agent_psi_inference_stalled_full{scope=\"main\",window=\"60\",model=\"all\"}, 0)",
          "refId": "A",
          "legendFormat": "Main productive"
        },
        {
          "expr": "agent_psi_inference_stalled_full{scope=\"main\",window=\"60\",model=\"all\"}",
          "refId": "B",
          "legendFormat": "Main stalled"
        },
        {
          "expr": "clamp_min(agent_psi_inference_full{scope=\"fleet\",window=\"60\",model=\"all\"} - agent_psi_inference_stalled_full{scope=\"fleet\",window=\"60\",model=\"all\"}, 0)",
          "refId": "C",
          "legendFormat": "Fleet productive"
        },
        {
          "expr": "agent_psi_inference_stalled_full{scope=\"fleet\",window=\"60\",model=\"all\"}",
          "refId": "D",
          "legendFormat": "Fleet stalled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#859900",
                "value": null
              },
              {
                "color": "#b58900",
                "value": 0.5
              },
              {
                "color": "#cb4b16",
                "value": 0.75
              },
              {
                "color": "#dc322f",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Main productive"
            },
            "properties": [
              {
                "id": "color.mode",
                "value": "fixed"
              },
              {
                "id": "color.fixedColor",
                "value": "#859900"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fleet productive"
            },
            "properties": [
              {
                "id": "color.mode",
                "value": "fixed"
              },
              {
                "id": "color.fixedColor",
                "value": "#859900"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Main stalled"
            },
            "properties": [
              {
                "id": "color.mode",
                "value": "fixed"
              },
              {
                "id": "color.fixedColor",
                "value": "#dc322f"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fleet stalled"
            },
            "properties": [
              {
                "id": "color.mode",
                "value": "fixed"
              },
              {
                "id": "color.fixedColor",
                "value": "#dc322f"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "description": "The money metric (60s window), split into PRODUCTIVE vs STALLED so total pressure is never read as one number. Productive = fraction of the last 60s every active worker was blocked on inference AND generating tokens (compute-bound, healthy). Stalled = the subset where the model was blocked but NOT generating (throughput below the stall floor, a request that ended in an API error, or an in-flight turn silent past the API-stall threshold: 429 back-off / retry back-off / network / TTFT / queueing => rate-limit bound, more parallelism buys nothing). Main = the dispatcher, read side-by-side with Fleet (main loop excluded from Fleet). productive = full − stalled, clamped at 0."
    },
