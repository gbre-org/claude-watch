{
  "title": "agent-PSI \u2014 Claude Code fleet pressure",
  "uid": "agent-psi",
  "tags": [
    "claude",
    "agent-psi"
  ],
  "timezone": "browser",
  "editable": true,
  "style": "dark",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Live subagents",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "agent_psi_live_agents",
          "legendFormat": "live subagents",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#268bd2",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "description": "Total live SUB-AGENT transcripts this scrape (workers active within the live window, default 900s). The main loop is deliberately excluded \u2014 it is a dispatcher, not a worker."
    },
