        {
          "expr": "agent_psi_tool_full{scope=\"fleet\",window=\"60\",model=\"all\"}",
          "legendFormat": "Fleet",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#859900",
                "value": null
              },
              {
                "color": "#b58900",
                "value": 0.5
              },
              {
                "color": "#cb4b16",
                "value": 0.75
              },
