    {
      "id": 11,
      "title": "Main vs fleet — inference full (60s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "agent_psi_inference_full{scope=\"main\",window=\"60\",model=\"all\"}",
          "legendFormat": "main",
          "refId": "A"
        },
        {
          "expr": "agent_psi_inference_full{scope=\"fleet\",window=\"60\",model=\"all\"}",
          "legendFormat": "fleet",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Main loop vs sub-agent fleet inference-full over time (60s window), so the dispatcher's idle-heavy profile stays visibly separate from the workers'."
    },
    {
      "id": 12,
      "title": "Fleet inference pressure (full) — API / rate-limit bound",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "agent_psi_inference_full{scope=\"fleet\",model=\"all\"}",
          "legendFormat": "inference_full · {{window}}s window",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Fraction of the trailing window in which EVERY active sub-agent in the fleet was blocked on inference at once. Sustained high values mean the fleet is API / rate-limit bound. One line per sliding window (10/60/300s). Main loop excluded (model=all aggregate)."
    },
    {
      "id": 13,
      "title": "Per-agent duty cycle — share of ACTIVE time by category (stacked per agent)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "agent_duty_ratio",
          "legendFormat": "{{agent_id}} · {{category}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Per-agent duty cycle: share of ACTIVE time (total − idle − waiting_human) spent on inference / tool / overhead. agent_id is a sub-agent id or main_loop:<session>. Stacked per agent — for a serial agent this equals its some==full pressure."
    }
