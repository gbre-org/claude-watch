# claude-watch runtime override — EXAMPLE (operator-editable, takes effect LIVE)
#
# Copy/rename to the path claude-watch reads at runtime and uncomment values.
# In the container stack the daemon reads $CLAUDE_WATCH_RUNTIME_CONFIG, which
# entrypoint.sh defaults to the bind-mounted, operator-editable file:
#
#     ~/.config/claude-container/claude-watch.override.toml   (on the HOST)
#
# (entrypoint.sh seeds a fully-commented copy there on first boot, so you
# normally just edit that seeded file directly — no need to copy this example.)
#
# HOW IT WORKS
#   * This file is layered on TOP of the baked /etc/claude-watch/config.toml at
#     HIGHEST precedence — it overrides only the fields it sets, per-field.
#   * The daemon watches the mtime of every config layer and auto-reloads when
#     any changes, so editing + saving this file retunes claude-watch within
#     one daemon loop pass. NO image rebuild, NO redeploy. (A manual
#     `pkill -HUP claude-watch` also forces an immediate reload.)
#   * It lives OUTSIDE the config dir ~/.config/claude-watch on purpose — that
#     dir must never be overlay-mounted (doing so historically root-broke it).
#     This is a SEPARATE bind-mounted file under ~/.config/claude-container/.
#
# The motivating case is the daemon-emitted cadence claude-events, but ANY
# config field can be overridden here.

# --- Cadence claude-events (keepalive + memory-reminder) -------------------
# [cadence]
# enabled = true
# memory_reminder_interval_secs = 3600   # 1h    (code default 1800 = 30 min)
# keepalive_interval_secs       = 300    # 5min  (code default 300)

# --- Liveness (ack age) -----------------------------------------------------
# Minutes without ANY claude-event ack before the daemon calls the loop wedged.
# Keep it well above 2x keepalive_interval_secs above.
# [ack]
# stale_minutes = 20

# --- Event-watcher health check (cw-watcher-health-check cron) --------------
# How many minutes a claude-event may sit unconsumed in the spool dir before the
# cron injects a "[CLAUDE-WATCH] WATCHER DOWN: N event(s) unconsumed >Nmin"
# recovery alert. Consumed by the cron SCRIPT (not the daemon). Default 6 (>= 2x
# the event watcher's ~3min debounce). Editing this retunes it on the next cron
# tick -- no rebuild. (An explicit CW_WATCHER_HEALTH_STALE_MIN env var still pins.)
# [watcher_health]
# stale_minutes = 6
