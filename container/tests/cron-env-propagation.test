#!/usr/bin/env python3
"""File-level test that the entrypoint propagates CLAUDE_EVENT_QUEUE
(and HOME + PATH + CLAUDE_WATCH_CONFIG) into /etc/cron.d/00-env so cron
jobs inherit the correct event spool path AND the daemon config path.

Background: cron runs jobs in a clean environment — it does NOT inherit
the container's exported env vars. Without explicit env-var propagation,
cron jobs calling `claude-event` write events to the default
$HOME/claude-events instead of the bind-mounted host spool at
$CLAUDE_EVENT_QUEUE. The fix: the entrypoint generates
/etc/cron.d/00-env at boot with the container's CLAUDE_EVENT_QUEUE,
HOME, and PATH. cron scopes env-var lines PER cron.d file, so 00-env's
vars do NOT propagate to jobs in other files (cw-default, private/);
`cw-cron-run` — the wrapper every cw-default job runs through — SOURCES
/etc/cron.d/00-env before exec so those jobs actually inherit them.

Asserts:

  1. entrypoint.sh writes /etc/cron.d/00-env when CLAUDE_EVENT_QUEUE
     is set, using `sudo -n tee`.
  2. The generated file includes CLAUDE_EVENT_QUEUE, HOME, PATH, and
     CLAUDE_WATCH_CONFIG (the last so the `queue-check` cron job's daemon
     config loader finds the baked config and emit_events reads true
     instead of its fail-closed false default).
  3. The file is chmod'd to 0644 (cron requirement).
  4. The write is conditional on CLAUDE_EVENT_QUEUE being non-empty
     (no-op when unset).
  5. Dockerfile grants passwordless sudo for `tee /etc/cron.d/00-env`
     so the uid-1000 entrypoint can write the root-owned file.
  6. Dockerfile grants passwordless sudo for `chmod 0644 /etc/cron.d/00-env`.
  7. container/bin/cw-cron-run SOURCES /etc/cron.d/00-env (exporting the
     assignments) before exec'ing the real command — the step that actually
     delivers 00-env's vars to cw-default jobs, since cron does not propagate
     env-var lines across cron.d files.

Run:  ./cron-env-propagation.test
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
CONTAINER_DIR = HERE.parent

ENTRYPOINT = CONTAINER_DIR / "entrypoint.sh"
DOCKERFILE = CONTAINER_DIR / "Dockerfile"


failures: list[str] = []


def expect(cond: bool, msg: str) -> None:
    if not cond:
        failures.append(msg)


# ---------------------------------------------------------------------------
# 1-4. entrypoint.sh generates /etc/cron.d/00-env.
# ---------------------------------------------------------------------------
expect(ENTRYPOINT.is_file(), f"entrypoint.sh missing at {ENTRYPOINT}")
if ENTRYPOINT.is_file():
    text = ENTRYPOINT.read_text(encoding="utf-8")

    # 1. Uses sudo tee to write /etc/cron.d/00-env.
    expect(
        re.search(r"sudo\s+-n\s+tee\s+/etc/cron\.d/00-env", text)
        is not None,
        "entrypoint.sh: must write /etc/cron.d/00-env via "
        "`sudo -n tee /etc/cron.d/00-env`. The file must be root-owned "
        "(cron rejects non-root-owned /etc/cron.d/ files) so the "
        "uid-1000 entrypoint needs sudo.",
    )

    # 2. Propagates CLAUDE_EVENT_QUEUE, HOME, and PATH. The env lines are
    #    emitted as `printf '<VAR>=%s\n' "..."` (one printf per var), so the
    #    generated 00-env carries a literal `<VAR>=<value>` line.
    expect(
        re.search(r"CLAUDE_EVENT_QUEUE=%s", text) is not None,
        "entrypoint.sh: /etc/cron.d/00-env must include "
        "CLAUDE_EVENT_QUEUE — the whole point is to tell cron jobs "
        "where the event spool lives.",
    )
    expect(
        re.search(r"'HOME=%s", text) is not None,
        "entrypoint.sh: /etc/cron.d/00-env must include HOME — cron "
        "jobs need HOME to resolve default paths in claude-event and "
        "other CLIs.",
    )
    expect(
        re.search(r"'PATH=%s", text) is not None,
        "entrypoint.sh: /etc/cron.d/00-env must include PATH — cron "
        "jobs need the container's full PATH to find claude-event, "
        "session-task, and other tools.",
    )
    expect(
        re.search(r"CLAUDE_WATCH_CONFIG=%s", text) is not None,
        "entrypoint.sh: /etc/cron.d/00-env must include "
        "CLAUDE_WATCH_CONFIG — the `queue-check` cron job runs the "
        "daemon config loader, which searches $CLAUDE_WATCH_CONFIG for "
        "the baked /etc/claude-watch/config.toml (emit_events=true). "
        "Without it in cron's clean env the loader finds no config, "
        "emit_events reads its fail-closed default (false), and "
        "queue-stuck/queue-orphaned events are never emitted.",
    )

    # 2b. Propagates the metrics-emit env so the baked `claude-watch metrics`
    #     cron writes the scraped textfile, reads the live state, and can
    #     reach Prometheus to rehydrate the desk-streak. Without this the
    #     shipped Rust emitter never reaches the node-exporter-scraped dir
    #     (it writes its hardcoded built-in path) and an out-of-tree Python
    #     textfile bridge has to stand in — the exact divergence this retires.
    for var in ("CW_PROMETHEUS_URL", "CLAUDE_WATCH_PROM_FILE", "CLAUDE_WATCH_STATE"):
        expect(
            re.search(rf"{var}=%s", text) is not None,
            f"entrypoint.sh: /etc/cron.d/00-env must propagate {var} so the "
            "baked `claude-watch metrics` cron (which runs in cron's clean "
            "env) inherits it. These are set in the container env (compose) "
            "but invisible to cron without explicit propagation.",
        )
        # Each metrics var is emitted only when set (guards a bare deploy from
        # a stray empty line that would override the emitter's built-in default).
        expect(
            re.search(rf'-n\s+"\$\{{{var}:-\}}"\s+\]\s+&&\s+printf', text)
            is not None,
            f"entrypoint.sh: the {var} 00-env line must be conditional on "
            f"{var} being non-empty (`[ -n \"${{{var}:-}}\" ] && printf ...`) "
            "so a bare deploy keeps the emitter's built-in default.",
        )

    # 3. chmod 0644 after write.
    expect(
        re.search(r"sudo\s+-n\s+chmod\s+0644\s+/etc/cron\.d/00-env", text)
        is not None,
        "entrypoint.sh: must chmod /etc/cron.d/00-env to 0644 after "
        "writing. cron refuses to process files with incorrect "
        "permissions.",
    )

    # 4. Conditional on CLAUDE_EVENT_QUEUE being set.
    expect(
        re.search(
            r'if\s+\[\s+-n\s+"\$\{CLAUDE_EVENT_QUEUE:-\}"\s+\]',
            text,
        )
        is not None,
        "entrypoint.sh: /etc/cron.d/00-env generation must be "
        "conditional on CLAUDE_EVENT_QUEUE being non-empty. When "
        "unset (no host spool bridged), writing an empty "
        "CLAUDE_EVENT_QUEUE= line would override the default "
        "fallback in claude-event.",
    )


# ---------------------------------------------------------------------------
# 5-6. Dockerfile grants sudo for tee + chmod on /etc/cron.d/00-env.
# ---------------------------------------------------------------------------
expect(DOCKERFILE.is_file(), f"Dockerfile missing at {DOCKERFILE}")
if DOCKERFILE.is_file():
    text = DOCKERFILE.read_text(encoding="utf-8")

    # 5. sudo for tee /etc/cron.d/00-env.
    expect(
        "NOPASSWD: /usr/bin/tee /etc/cron.d/00-env" in text,
        "Dockerfile: must grant passwordless sudo for "
        "`/usr/bin/tee /etc/cron.d/00-env` in the sudoers carve-out. "
        "Without this the entrypoint's `sudo -n tee` fails with "
        "'sorry, a password is required' and /etc/cron.d/00-env never "
        "gets written.",
    )

    # 6. sudo for chmod 0644 /etc/cron.d/00-env.
    expect(
        "NOPASSWD: /bin/chmod 0644 /etc/cron.d/00-env" in text,
        "Dockerfile: must grant passwordless sudo for "
        "`/bin/chmod 0644 /etc/cron.d/00-env` in the sudoers "
        "carve-out. Without this the entrypoint can write the file "
        "but can't ensure the mode is correct (cron rejects "
        "non-0644 files in /etc/cron.d/).",
    )


# ---------------------------------------------------------------------------
# 7. cw-cron-run sources /etc/cron.d/00-env before exec.
#
#    Writing 00-env (checks 1-6) is necessary but NOT sufficient: cron scopes
#    env-var lines PER cron.d file, so the vars in /etc/cron.d/00-env do NOT
#    propagate to the metrics/active-agents jobs, which live in the SEPARATE
#    /etc/cron.d/cw-default file. cw-cron-run — the wrapper every cw-default
#    job runs through — must SOURCE the env file and EXPORT its assignments
#    before exec'ing the real command; otherwise `claude-watch metrics` never
#    sees CLAUDE_WATCH_PROM_FILE and falls back to its hardcoded, unwritable
#    /var/lib/node-exporter/textfile default -> "Permission denied".
# ---------------------------------------------------------------------------
CW_CRON_RUN = CONTAINER_DIR / "bin" / "cw-cron-run"
expect(CW_CRON_RUN.is_file(), f"cw-cron-run missing at {CW_CRON_RUN}")
if CW_CRON_RUN.is_file():
    cron_run = CW_CRON_RUN.read_text(encoding="utf-8")

    # References the canonical env file the entrypoint writes into.
    expect(
        "/etc/cron.d/00-env" in cron_run,
        "cw-cron-run: must reference the canonical cron env file "
        "/etc/cron.d/00-env (where the entrypoint writes the metrics env) "
        "so it can source it before exec.",
    )

    # Sources that file BEFORE the final exec of the real command.
    env_pos = cron_run.find("CW_CRON_ENV_FILE")
    exec_pos = cron_run.rfind("exec ")
    expect(
        env_pos != -1 and exec_pos != -1 and env_pos < exec_pos,
        "cw-cron-run: must source the cron env file (CW_CRON_ENV_FILE / "
        "/etc/cron.d/00-env) BEFORE `exec`'ing the real command. cron does "
        "not propagate env-var lines across cron.d files, so this source "
        "step is what actually delivers 00-env's vars to cw-default jobs "
        "(without it, `claude-watch metrics` hits its unwritable hardcoded "
        "prom path and permission-denies every minute).",
    )

    # Exports the assignments — a non-exported shell var would not survive exec.
    expect(
        re.search(r"\bexport\b", cron_run) is not None,
        "cw-cron-run: must EXPORT the sourced assignments so the exec'd "
        "command inherits them (a non-exported shell var does not cross exec).",
    )


# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------
if failures:
    print("FAIL cron-env-propagation.test")
    for f in failures:
        print(f"  - {f}")
    sys.exit(1)

print("PASS cron-env-propagation.test")
sys.exit(0)
