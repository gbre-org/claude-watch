#!/usr/bin/env python3
"""devbar-analytics-spool — spool a `devbar ai-analytics capture` hook payload
to a shared spool dir for a host-side drainer, instead of dropping it in the
stdin-less host-bash bridge.

WHY THIS EXISTS

devbar's Claude Code hooks run `devbar ai-analytics capture`, which reads its
event payload from STDIN. Inside the claude-container the devbar binary is a
host-only macOS Mach-O, so `exec-hook` would normally hand the call to
`exec-hook-bridge`, which marshals it across the host-bash MCP `run_command`
tool. cli-mcp-server's `run_command` has NO stdin support (see
exec-hook-bridge's "DEGRADED MODE" note), so the payload is silently DROPPED
and the container's ai-analytics events never reach the host devbar store
(`~/.devbar/plugins/ai-analytics/events.db`). Only server-side token-$ shows
up, which is why the container appeared to "half work".

APPROACH B (this helper)

For the `devbar ai-analytics capture` target ONLY, `exec-hook` execs THIS
helper instead of the live bridge. We:

  1. Read the hook's JSON payload from stdin (the bytes the bridge would
     have dropped).
  2. Rewrite container->host absolute path prefixes inside the JSON so the
     host devbar daemon can open the referenced files. `~/.claude` is
     bind-mounted to BOTH `/home/hndrewaall/.claude` (container) and
     `/Users/hallandrew/.claude` (host) — same files, different path — so the
     `transcript_path` in the payload must be rewritten to the host path or
     the host daemon's per-session token scraper can't read it.
  3. Write the rewritten JSON ATOMICALLY (temp + rename) into a spool dir on
     the shared `~/.claude` mount:
       $HOME/.claude/devbar-analytics-spool/<uniqueid>.json
     which the host sees at
       <host-home>/.claude/devbar-analytics-spool/<uniqueid>.json

A host-side launchd drainer (com.claude-watch.devbar-analytics-drainer)
watches that dir and feeds each file to the REAL host devbar binary via
`devbar ai-analytics capture < file`, deleting on success.

PATH REWRITE

The mapping is a set of `container_prefix -> host_prefix` pairs applied as a
longest-prefix-first rewrite over every string value in the JSON (falling back
to a literal text replace if the payload doesn't parse as JSON). Defaults are
DERIVED from the container's `$HOME` and the standard `CLAUDE_HOST_*` env the
compose stack already exports — no personal paths are baked in:

  {container_home}/.claude -> {host_home}/.claude
  {container_config}       -> {host_home}/.claude   (see CLAUDE_CONFIG_DIR below)
  {container_home}/repos   -> {host_repos}

where:
  container_home = $HOME                              (e.g. /home/hndrewaall)
  container_config = $CLAUDE_CONFIG_DIR               (e.g. /run/claude/config,
                   set when Claude's config dir is relocated off $HOME; maps to
                   the SAME bind-mounted files the host sees under
                   {host_home}/.claude)
  host_home      = $CLAUDE_HOST_HOME, else the parent of $CLAUDE_HOST_PROJECT_DIR
  host_repos     = $CLAUDE_HOST_REPOS_DIR, else $CLAUDE_HOST_PROJECT_DIR,
                   else {host_home}/repos

When neither a host home nor a host repos path can be derived (e.g. a
stripped-down container without the CLAUDE_HOST_* env), that mapping entry is
simply omitted — the payload is spooled with paths unrewritten rather than the
helper failing.

CONFIG KNOBS (env)

  CLAUDE_DEVBAR_ANALYTICS_SPOOL       "1" (default) enables; "0" disables so
                                      exec-hook falls through to its normal
                                      bridge/no-op path. (Gate also lives in
                                      exec-hook so this helper isn't invoked at
                                      all when disabled; honored here too as a
                                      belt-and-suspenders no-op.)
  CLAUDE_DEVBAR_ANALYTICS_SPOOL_DIR   spool directory. Default
                                      "$HOME/.claude/devbar-analytics-spool".
  CLAUDE_DEVBAR_ANALYTICS_PATH_MAP    explicit "from=to" pairs, separated by
                                      ';', newline, or ':'. MERGED OVER the
                                      derived defaults (an explicit pair with
                                      the same `from` overrides the default).
  CLAUDE_HOST_PROJECT_DIR / CLAUDE_HOST_HOME / CLAUDE_HOST_REPOS_DIR
                                      inputs to the default map derivation
                                      (see PATH REWRITE above).
  CLAUDE_CONFIG_DIR                   container Claude config dir when relocated
                                      off $HOME (e.g. /run/claude/config); its
                                      prefix is mapped to {host_home}/.claude so
                                      transcript_path stays host-openable.

EXIT CODES

  0   always. A hook must never fail the session; on any error we emit a
      single stderr line and exit 0 (matching exec-hook's no-op contract).
      The cost of an error is one lost analytics event, never a broken hook.
"""

from __future__ import annotations

import json
import os
import sys
import time
import uuid


def emit(msg: str) -> None:
    """One-line stderr emit, prefixed so operators can grep for spool
    activity next to exec-hook / exec-hook-bridge lines."""
    print(f"[devbar-spool] {msg}", file=sys.stderr)


def container_home() -> str:
    return os.environ.get("HOME") or "/home/hndrewaall"


def _strip_trailing_slash(p: str) -> str:
    p = p.strip()
    if len(p) > 1:
        p = p.rstrip("/")
    return p


def derive_default_map() -> dict[str, str]:
    """Build the default container->host prefix map from the environment.

    Returns a dict of {container_prefix: host_prefix}. Entries whose host
    side can't be derived are omitted (no rewrite for that prefix).
    """
    home = _strip_trailing_slash(container_home())

    project_dir = _strip_trailing_slash(os.environ.get("CLAUDE_HOST_PROJECT_DIR", ""))
    host_home = _strip_trailing_slash(os.environ.get("CLAUDE_HOST_HOME", ""))
    host_repos = _strip_trailing_slash(os.environ.get("CLAUDE_HOST_REPOS_DIR", ""))

    if not host_home and project_dir:
        # CLAUDE_HOST_PROJECT_DIR is the host repos path in the standard
        # compose (e.g. /Users/hallandrew/repos); its parent is the host home.
        host_home = _strip_trailing_slash(os.path.dirname(project_dir))
    if not host_repos:
        host_repos = project_dir or (f"{host_home}/repos" if host_home else "")

    mapping: dict[str, str] = {}
    if host_home:
        host_claude = f"{host_home}/.claude"
        mapping[f"{home}/.claude"] = host_claude
        # Claude's config dir is often relocated off $HOME via CLAUDE_CONFIG_DIR
        # (e.g. /run/claude/config), so transcript_path and friends arrive with
        # THAT prefix, not {home}/.claude. It still points at the SAME
        # bind-mounted files the host sees under {host_home}/.claude (identical
        # projects/<slug>/<session>.jsonl tail), so map it there too -- otherwise
        # container-originated rows land host-side with an unopenable
        # /run/claude/config/... transcript_path.
        config_dir = _strip_trailing_slash(os.environ.get("CLAUDE_CONFIG_DIR", ""))
        if config_dir and config_dir != f"{home}/.claude":
            mapping[config_dir] = host_claude
    if host_repos:
        mapping[f"{home}/repos"] = host_repos
    return mapping


def parse_explicit_map(raw: str) -> dict[str, str]:
    """Parse CLAUDE_DEVBAR_ANALYTICS_PATH_MAP into {from: to}.

    Pairs are `from=to`, separated by ';', newline, or ':'. Note the first
    '=' splits the pair, so host/container paths (which never contain '=')
    round-trip cleanly. Malformed entries are skipped with a stderr crumb.
    """
    mapping: dict[str, str] = {}
    if not raw:
        return mapping
    # Normalize all supported separators to newline, then split.
    normalized = raw.replace(";", "\n").replace(":", "\n")
    for entry in normalized.split("\n"):
        entry = entry.strip()
        if not entry:
            continue
        if "=" not in entry:
            emit(f"ignoring malformed path-map entry (no '='): {entry!r}")
            continue
        frm, to = entry.split("=", 1)
        frm = _strip_trailing_slash(frm)
        to = _strip_trailing_slash(to)
        if frm and to:
            mapping[frm] = to
    return mapping


def build_map() -> dict[str, str]:
    mapping = derive_default_map()
    mapping.update(parse_explicit_map(os.environ.get("CLAUDE_DEVBAR_ANALYTICS_PATH_MAP", "")))
    return mapping


def rewrite_prefix(value: str, ordered_pairs: list[tuple[str, str]]) -> str:
    """Rewrite the FIRST (longest) matching container prefix in `value`.

    A prefix matches when `value` equals it or begins with `prefix + "/"`, so
    `/home/hndrewaall/.claude` never accidentally rewrites
    `/home/hndrewaall/.claude-backup`.
    """
    for frm, to in ordered_pairs:
        if value == frm:
            return to
        if value.startswith(frm + "/"):
            return to + value[len(frm):]
    return value


def rewrite_obj(obj, ordered_pairs: list[tuple[str, str]]):
    """Recursively rewrite string values in a parsed JSON structure."""
    if isinstance(obj, str):
        return rewrite_prefix(obj, ordered_pairs)
    if isinstance(obj, list):
        return [rewrite_obj(v, ordered_pairs) for v in obj]
    if isinstance(obj, dict):
        return {k: rewrite_obj(v, ordered_pairs) for k, v in obj.items()}
    return obj


def rewrite_payload(raw: str, mapping: dict[str, str]) -> str:
    """Return `raw` with container path prefixes rewritten to host prefixes.

    Prefers structured JSON rewriting (only touches string values); on parse
    failure falls back to a longest-prefix-first literal text replace so we
    still spool a best-effort payload.
    """
    # Longest prefix first so nested prefixes resolve to the most specific.
    ordered_pairs = sorted(mapping.items(), key=lambda kv: len(kv[0]), reverse=True)
    if not ordered_pairs:
        return raw
    try:
        parsed = json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        out = raw
        for frm, to in ordered_pairs:
            out = out.replace(frm, to)
        return out
    rewritten = rewrite_obj(parsed, ordered_pairs)
    return json.dumps(rewritten)


def spool_dir() -> str:
    explicit = os.environ.get("CLAUDE_DEVBAR_ANALYTICS_SPOOL_DIR", "").strip()
    if explicit:
        return explicit
    return os.path.join(container_home(), ".claude", "devbar-analytics-spool")


def unique_name() -> str:
    ts = time.strftime("%Y%m%dT%H%M%S", time.gmtime())
    return f"{ts}-{os.getpid()}-{uuid.uuid4().hex[:12]}.json"


def write_atomic(directory: str, name: str, data: str) -> str:
    """Write `data` to directory/name atomically (temp file + rename).

    Returns the final path. Raises on I/O error (caller turns that into a
    no-op exit).
    """
    os.makedirs(directory, exist_ok=True)
    final_path = os.path.join(directory, name)
    tmp_path = os.path.join(directory, f".{name}.tmp")
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.rename(tmp_path, final_path)
    return final_path


def main(argv: list[str]) -> int:
    # Belt-and-suspenders: exec-hook already gates on this, but honor it here
    # too so the helper is safe to invoke directly.
    if os.environ.get("CLAUDE_DEVBAR_ANALYTICS_SPOOL", "1") == "0":
        return 0

    try:
        raw = sys.stdin.buffer.read().decode("utf-8", errors="replace")
    except Exception as e:  # pragma: no cover - stdin read is trivial
        emit(f"could not read stdin payload: {e}")
        return 0

    if not raw.strip():
        # No payload (some hook events send nothing) — nothing to spool.
        return 0

    mapping = build_map()
    try:
        rewritten = rewrite_payload(raw, mapping)
    except Exception as e:  # pragma: no cover - defensive
        emit(f"path rewrite failed ({e}); spooling raw payload")
        rewritten = raw

    directory = spool_dir()
    try:
        write_atomic(directory, unique_name(), rewritten)
    except Exception as e:
        emit(f"failed to spool payload to {directory}: {e}")
        return 0

    if os.environ.get("CLAUDE_DEVBAR_ANALYTICS_SPOOL_DEBUG") == "1":
        emit(f"spooled payload to {directory} (map={mapping})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
