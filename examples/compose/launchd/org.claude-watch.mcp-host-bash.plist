<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the host-side mcp-host-bash-server.

  mcp-host-bash-server is the single self-contained Rust binary that
  serves the `host-bash` MCP surface (run_command / run_script /
  show_security_rules) over streamable-HTTP, doing bearer auth and the
  allow-list policy in-process. Build + install it once with:

      make install-mcp-host-bash-server

  from the repo root — that compiles crates/mcp-host-bash-server and
  copies the binary to ~/bin/mcp-host-bash-server (re-signed on macOS).
  There is no PyPI dependency and no separate installer step.

  This is a TEMPLATE — you MUST search/replace the placeholder before
  loading it into launchd:

    /PATH/TO/HOME   absolute path to your home directory
                    (e.g. /Users/yourname). launchd does NOT expand
                    `~` or `${HOME}` in plist values; use the literal
                    path.

  See examples/compose/launchd/README.md for the full installation
  walkthrough. Do not load this file straight from the repo with
  `launchctl bootstrap` — copy it to ~/Library/LaunchAgents/ first
  (launchd refuses to follow symlinks or load files outside that
  directory).

  Why a LaunchAgent and not a LaunchDaemon: the server runs as the
  operator's user (its run_command / run_script exec under the
  operator's $HOME, $PATH, login keychain, etc.) and binds a loopback
  port that the docker-desktop VM reaches through host.docker.internal.
  None of that requires root, and a LaunchDaemon would invert the trust
  model.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.claude-watch.mcp-host-bash</string>

    <!--
      ProgramArguments: full argv launchd will exec. Points at the
      mcp-host-bash-server binary installed to ~/bin by
      `make install-mcp-host-bash-server`. Replace /PATH/TO/HOME with
      the absolute path to your home directory (no `~`, no `${HOME}`).
      Append `<dash><dash>port N` after the binary path if you want a
      non-default port (default 8766).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/HOME/bin/mcp-host-bash-server</string>
    </array>

    <!--
      EnvironmentVariables: every key is OPTIONAL. launchd does not
      inherit your interactive shell's environment (no .zshrc / .bash_profile
      sourcing), so anything the server needs to see has to be declared
      here OR sourced from the operator config file at
      ${HOME}/.config/claude-container/mcp-host-bash.env (which the
      server reads at startup). Values in that .env file WIN over the
      process environment declared here.

      - MCP_HOST_BASH_BIND: host address the server listens on. Default
        (omit or set to 127.0.0.1) binds loopback only — safe floor. To
        allow a Linux Docker bridge-net container to reach the server
        via host.docker.internal, set this to `0.0.0.0` AND pair with
        MCP_HOST_BASH_BEARER (below). macOS Docker Desktop reaches
        loopback through host.docker.internal NAT, so the default Just
        Works there. Bare 0.0.0.0 without auth exposes the host
        shell-exec surface to every reachable caller — do not run that
        in production.

      - MCP_HOST_BASH_BEARER: shared-secret bearer token. Set it EITHER
        in ${HOME}/.config/claude-container/mcp-host-bash.env OR here as
        a <string> entry inside EnvironmentVariables (below). The server
        validates `Authorization: Bearer <token>` on every request
        in-process and rejects anything that doesn't match. Required
        when MCP_HOST_BASH_BIND is non-loopback. Generate once + keep
        out of version control:

            head -c 32 /dev/urandom | base64

        The same secret must be set as CLAUDE_HOST_HOOK_BRIDGE_BEARER
        in the docker-compose .env file (the in-container exec-hook
        bridge reads it from there). Empty / unset = no auth (matches
        the pre-bearer-auth behavior — safe only on a loopback bind).

      - CW_PROFILE: trust profile selector. Unset / `corp-dev` keeps
        the read-y default allow-list. `corp-dev-trusted` widens to
        include host scheduling, file mutation, outbound bytes, key/cert
        tooling, and container management. See the server's
        show_security_rules output for the full surface.

      - ALLOW_SHELL_OPERATORS: `true` lets the in-container claude
        chain commands with pipes / `&&` / redirects. Default `false`.
        Leave the default unless you specifically need it.

      - MAX_COMMAND_LENGTH: max length (chars) of a single command
        string the server will accept. Default 8192. Raise / lower here
        or in the operator config file.

      - SSL_CERT_FILE / REQUESTS_CA_BUNDLE: corporate CA bundle for
        operators behind a TLS MITM proxy. The server itself makes no
        outbound HTTPS calls, but downstream `run_command` invocations
        of curl / git / pip etc. need this to validate the corp chain.
        Match the absolute path you'd set in your interactive shell.

      - CLAUDE_HOOK_BRIDGE_BINS: comma-separated basenames of host
        hook binaries the in-container exec-hook bridge is allowed
        to invoke via run_command. e.g. `telemetry-hook,corp-trace-hook`.
        Layered on top of CW_PROFILE.

      - PATH: launchd starts with a minimal PATH. Declare one that adds
        ${HOME}/.local/bin so any host CLIs the server's run_command
        invocations rely on resolve.

      Replace /PATH/TO/HOME with your home directory (e.g.
      /Users/yourname) — no `~`, no `${HOME}` in plist values.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <!--
          MCP_HOST_BASH_BIND: omit / 127.0.0.1 = loopback only (safe
          default for macOS Docker Desktop, where host.docker.internal
          routes via NAT to host loopback). Set to 0.0.0.0 to expose
          beyond loopback for Linux Docker bridge-net containers —
          PAIR with MCP_HOST_BASH_BEARER (below) so the public port is
          gated by the in-process bearer check.
        -->
        <key>MCP_HOST_BASH_BIND</key>
        <string>127.0.0.1</string>

        <!--
          MCP_HOST_BASH_BEARER: shared-secret bearer token. Left ABSENT
          from this template so the default is a loopback-only, no-auth
          bind. Set it here as a <string> entry OR in
          ${HOME}/.config/claude-container/mcp-host-bash.env (the .env
          value wins). The server validates `Authorization: Bearer
          <token>` in-process on every request. Required for any
          non-loopback bind. Generate once with
          `head -c 32 /dev/urandom | base64` and mirror the same value
          into CLAUDE_HOST_HOOK_BRIDGE_BEARER in the docker-compose
          .env file. Example:

            <key>MCP_HOST_BASH_BEARER</key>
            <string>...your base64 secret...</string>
        -->

        <key>CW_PROFILE</key>
        <string>corp-dev</string>

        <key>ALLOW_SHELL_OPERATORS</key>
        <string>false</string>

        <!--
          MAX_COMMAND_LENGTH: max single-command length (chars) the
          server accepts. Default 8192. Omit to inherit the default.
        -->
        <key>MAX_COMMAND_LENGTH</key>
        <string>8192</string>

        <key>SSL_CERT_FILE</key>
        <string></string>

        <key>CLAUDE_HOOK_BRIDGE_BINS</key>
        <string></string>

        <key>PATH</key>
        <string>/PATH/TO/HOME/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!--
      KeepAlive=true: relaunch on any exit (clean or crash). Combined
      with ThrottleInterval below to prevent a crashloop from saturating
      the CPU.
    -->
    <key>KeepAlive</key>
    <true/>

    <!--
      RunAtLoad=true: start at login (when launchctl bootstraps the
      LaunchAgent on user-session startup). Without this, launchd
      registers the unit but doesn't fire it until something else
      requests the service.
    -->
    <key>RunAtLoad</key>
    <true/>

    <!--
      ThrottleInterval: minimum seconds between (re)spawns. launchd's
      default is 10s; bumping to 30s gives the server room to bind
      before another KeepAlive cycle if the previous run died early
      (e.g. port already bound). Tune down if you're actively debugging.
    -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!--
      WorkingDirectory: cwd launchd sets before exec'ing the server.
      The server is cwd-agnostic, but a sensible cwd helps if operator
      config files use relative paths. Replace /PATH/TO/HOME.
    -->
    <key>WorkingDirectory</key>
    <string>/PATH/TO/HOME</string>

    <!--
      StandardOutPath / StandardErrorPath: launchd captures the
      server's stdout / stderr (the startup banner + tracing lines go
      to stderr). Replace /PATH/TO/HOME. Pre-create the parent dir
      (~/Library/Logs/) once — launchd auto-creates the file but not
      the directory.
    -->
    <key>StandardOutPath</key>
    <string>/PATH/TO/HOME/Library/Logs/mcp-host-bash.out.log</string>

    <key>StandardErrorPath</key>
    <string>/PATH/TO/HOME/Library/Logs/mcp-host-bash.err.log</string>

    <!--
      ProcessType=Interactive: launchd schedules at the same priority
      as a foreground shell. The server is a low-latency MCP bridge the
      in-container claude dials synchronously, so it should not be
      backgrounded by the standard `Background` class.
    -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
