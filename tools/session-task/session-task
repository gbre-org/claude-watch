def cmd_queue_done(args):
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        if target["status"] == "done":
            print(f"already done: {args.id}")
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            return
        started_at = target.get("started_at")
        # A `done` from a quarantined item is the case the quarantine exists
        # for: the agent someone presumed dead came back and finished. That
        # is the strongest possible evidence it was alive, so it clears the
        # quarantine outright — and the stamps below make the near-miss
        # visible in the audit trail rather than silently healing it.
        was_quarantined = target.get("status") == "quarantined"
        target["status"] = "done"
        target["completed_at"] = _fmt_ts()
        if was_quarantined:
            target["quarantine_released_at"] = target["completed_at"]
            target["quarantine_released_by"] = "agent-completed"
        target["group_head"] = False
        # Archive the spawning subagent's transcript (or workload output,
        # for workload-bound items) while we still have the lock. Best-
        # effort: failures don't block the done transition. The path
        # lands on the item as `log_archive_path` so a queue viewer UI
        # can offer a "View log" affordance on Done entries.
        archive_path = _archive_for_item(target, reason="done")
        if archive_path:
            target["log_archive_path"] = archive_path
        _recompute_group_heads(items)
        next_head = _group_head(items, target["group_id"])
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    log_completed(
        f"[queue {target['id']}] {target['description']}",
        extra={
            "source": "queue",
            "id": target["id"],
            "group_id": target["group_id"],
        },
    )

    # Lifecycle notification: task completion (success). Never blocks.
    # Summary on line 1 (Pushover preview), elapsed/scope on line 2.
    elapsed = _elapsed_minutes(started_at)
    elapsed_sec = _elapsed_seconds(started_at)
    elapsed_str = f"{elapsed}m" if elapsed is not None else "unknown"
    _pingme_notify(
        title=f"queue done: {target['id']}",
        message=(
            f"{_item_summary(target)}\n"
            f"elapsed: {elapsed_str} "
            f"| scope: {','.join(target.get('scope', []))}"
        ),
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    # Claude-event lifecycle emit: queue-done. Main loop handler checks the
    # group for newly-unblocked next-in-group items and may spawn them.
    _claude_event_notify(
        tag="queue-done",
        message=f"queue done: {target['id']} ({_item_summary(target)})",
        data={
            "queue_id": target["id"],
            "group_id": target["group_id"],
            "scope": target.get("scope", []),
            "summary": _item_summary(target),
            "elapsed_sec": elapsed_sec,
            "created_by": target.get("created_by", ""),
            "was_quarantined": was_quarantined,
        },
        priority="low",
        silent=getattr(args, "silent", False),
    )

    if was_quarantined:
        print(
            f"NOTE: {args.id} was QUARANTINED (presumed dead) and completed "
            f"anyway. Quarantine cleared.",
        )
    print(f"done: {args.id}")
    if next_head:
        print(f"next in group {target['group_id']}: {next_head['id']} ({next_head['description'][:60]})")
    else:
        print(f"group {target['group_id']} is now empty")


def cmd_queue_abandon(args):
    """Give up on a queue item.

    Two outcomes, decided by whether the item currently OWNS ITS SCOPE and
    whether the caller holds positive evidence that the owning process is
    gone (see the Quarantine block at the top of this file):

      * pending / blocked item, or `--confirmed-dead` -> terminal
        `abandoned`, scope released. A pending item never had an agent; a
        blocked item already released its scope lock; `--confirmed-dead`
        means the caller watched the process exit.
      * running / wedged item without `--confirmed-dead` -> `quarantined`.
        NOT terminal, scope STILL HELD. The caller inferred death; an
        inference must not dissolve the lock that prevents duplicate work.

    `--confirmed-dead` REFUSES (exit 1) when claude-watch reports a live
    agent bound to this id — evidence of life overrides the caller's claim.
    `--force` overrides that refusal. Note the asymmetry is deliberate:
    the absence of an agent record authorizes nothing.
    """
    confirmed_dead = bool(getattr(args, "confirmed_dead", False))
    force = bool(getattr(args, "force", False))

    # Liveness guard for --confirmed-dead. Read BEFORE taking the queue
    # lock: _live_agent_for_queue may shell out to `claude-watch
    # active-agents` and we don't want that under the flock.
    if confirmed_dead and not force:
        live_agent = _live_agent_for_queue(args.id)
        if live_agent:
            print(
                f"ERROR: --confirmed-dead refused for {args.id}: "
                f"claude-watch reports agent {live_agent} is still ALIVE.",
                file=sys.stderr,
            )
            print(
                "  The agent is running. Let it finish (it will `queue done`),"
                " or drop --confirmed-dead to quarantine the item instead,"
                " or pass --force if you know the state file is wrong.",
                file=sys.stderr,
            )
            sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        # Idempotent on already-terminal items. Mirrors `cmd_queue_done`'s
        # `already done` early-return so callers that race (e.g. workload
        # kill -> cmd_emit_done both fire abandon for the same qid because
        # the wrapper raced to .exit) don't get a duplicate
        # `queue-abandoned` claude-event, duplicate pingme, or a clobbered
        # `abandoned_at` timestamp + `abandon_reason`. Same exit code as
        # `cmd_queue_done` (0) so the caller treats it as success.
        if target["status"] in TERMINAL_STATUSES:
            print(f"already {target['status']}: {args.id}")
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            return

        prior_status = target["status"]

        # Already quarantined: idempotent no-op unless the caller now has
        # positive evidence of death, in which case fall through to the
        # terminal path (that IS the release-with-evidence case).
        if prior_status == "quarantined" and not confirmed_dead:
            print(f"already quarantined: {args.id}")
            print(f"  quarantined_at: {target.get('quarantined_at')}")
            print(f"  reason        : {target.get('quarantine_reason') or '(none)'}")
            print("  release it with one of:")
            print(f"    session-task queue done {args.id}          "
                  f"# the agent came back and finished")
            print(f"    session-task queue resurrect {args.id}     "
                  f"# respawn a replacement (scope carries over)")
            print(f"    session-task queue release {args.id} --reason '...'"
                  f"  # you know it's gone")
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            return

        # The quarantine decision. Scope-owning statuses only; a pending
        # item never had an agent and a blocked item already released its
        # lock, so neither can produce the duplicate-work failure mode.
        quarantine = prior_status in RUNNING_STATUSES and not confirmed_dead
        started_at = target.get("started_at")
        if quarantine:
            target["status"] = "quarantined"
            target["quarantined_at"] = _fmt_ts()
            target["quarantine_reason"] = args.reason or ""
            target["quarantined_from"] = prior_status
            # group_head stays as-is: the item still owns the slot, so it
            # is still the in-flight head of its group.
            #
            # The transcript is deliberately NOT archived here. Archiving is
            # a terminal-transition act; a quarantined agent may still be
            # writing to its transcript. The archive happens at `release` /
            # `done` / `resurrect` time, once we actually know.
            _recompute_group_heads(items)
            _queue_write_and_unlock(fh, data)
        else:
            if confirmed_dead:
                target["death_evidence"] = (
                    "operator --force (liveness state overridden)"
                    if force else "caller asserted --confirmed-dead"
                )
            target["status"] = "abandoned"
            target["abandoned_at"] = _fmt_ts()
            if args.reason:
                target["abandon_reason"] = args.reason
            target["group_head"] = False
            # Archive the spawning subagent's transcript or workload output
            # (if any). Pending items abandoned before spawn won't have a
            # record — the helper silently skips that case.
            archive_path = _archive_for_item(target, reason="abandon")
            if archive_path:
                target["log_archive_path"] = archive_path
            _recompute_group_heads(items)
            _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    if quarantine:
        _emit_quarantine_notifications(
            target, args, started_at=started_at, prior_status=prior_status,
        )
        return

    log_completed(
        f"[queue {target['id']} abandoned] {target['description']}"
        + (f" (reason: {args.reason})" if args.reason else ""),
        extra={
            "source": "queue",
            "event": "abandon",
            "id": target["id"],
            "group_id": target["group_id"],
            "reason": args.reason,
        },
    )

    # Lifecycle notification: task completion (failure). Never blocks.
    # Summary on line 1 (Pushover preview), elapsed/reason/scope on line 2.
    elapsed = _elapsed_minutes(started_at)
    elapsed_sec = _elapsed_seconds(started_at)
    elapsed_str = f"{elapsed}m" if elapsed is not None else "unknown"
    reason_str = args.reason if args.reason else "no reason given"
    _pingme_notify(
        title=f"queue abandoned: {target['id']}",
        message=(
            f"{_item_summary(target)}\n"
            f"elapsed: {elapsed_str} "
            f"| reason: {reason_str} "
            f"| scope: {','.join(target.get('scope', []))}"
        ),
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    # Claude-event lifecycle emit: queue-abandoned. Main loop handler logs
    # to failures and checks the group for downstream-blocked peers.
    _claude_event_notify(
        tag="queue-abandoned",
        message=f"queue abandoned: {target['id']} ({_item_summary(target)})",
        data={
            "queue_id": target["id"],
            "group_id": target["group_id"],
            "scope": target.get("scope", []),
            "summary": _item_summary(target),
            "elapsed_sec": elapsed_sec,
            "reason": args.reason or "",
            "created_by": target.get("created_by", ""),
        },
        priority="low",
        silent=getattr(args, "silent", False),
    )

    print(f"abandoned: {args.id}")


def _emit_quarantine_notifications(target, args, *, started_at, prior_status):
    """Log / pingme / claude-event for an abandon that landed in quarantine.

    Kept out of ``cmd_queue_abandon``'s lock block so a notification failure
    can never leave the queue file locked.
    """
    reason_str = args.reason if args.reason else "no reason given"
    elapsed = _elapsed_minutes(started_at)
    elapsed_sec = _elapsed_seconds(started_at)
    elapsed_str = f"{elapsed}m" if elapsed is not None else "unknown"
    qid = target["id"]

    log_completed(
        f"[queue {qid} QUARANTINED] {target.get('description','')}"
        + (f" (reason: {args.reason})" if args.reason else ""),
        extra={
            "source": "queue",
            "event": "quarantine",
            "id": qid,
            "group_id": target.get("group_id"),
            "reason": args.reason,
            "prior_status": prior_status,
        },
    )

    # Quarantine is an attention-required state: it holds a scope lock
    # against work the operator probably wants to re-spawn. Normal priority
    # (not high) — this is "look at this soon", not "the system is broken".
    _pingme_notify(
        title=f"queue QUARANTINED: {qid}",
        message=(
            f"{_item_summary(target)}\n"
            f"elapsed: {elapsed_str} "
            f"| reason: {reason_str} "
            f"| scope: {','.join(target.get('scope', []))}"
        ),
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    _claude_event_notify(
        tag="queue-quarantined",
        message=(
            f"queue QUARANTINED: {qid} ({_item_summary(target)}) "
            f"-- scope still held, reason: {reason_str}"
        ),
        data={
            "queue_id": qid,
            "group_id": target.get("group_id"),
            "scope": target.get("scope", []),
            "summary": _item_summary(target),
            "elapsed_sec": elapsed_sec,
            "reason": args.reason or "",
            "prior_status": prior_status,
            "quarantined_at": target.get("quarantined_at"),
            "created_by": target.get("created_by", ""),
        },
        priority="low",
        silent=getattr(args, "silent", False),
    )

    print(f"quarantined: {qid} (was {prior_status})")
    print("  THE SCOPE IS STILL HELD. A replacement agent cannot be")
    print("  registered on this scope until the quarantine is released.")
    print(f"  scope: {','.join(target.get('scope', []))}")
    print("  Release it with one of:")
    print(f"    session-task queue done {qid}"
          "                 # the agent came back and finished")
    print(f"    session-task queue resurrect {qid}"
          "            # respawn a replacement (carries the scope over)")
    print(f"    session-task queue release {qid} --reason '...'"
          "  # you know the process is gone")


def cmd_queue_release(args):
    """Release a quarantined item to terminal `abandoned`, freeing its scope.

    This is the explicit operator assertion that the presumed-dead process
    really is gone. It is the answer to "how do I unwedge a quarantine" and
    is intentionally a single command with no ceremony beyond a reason.

    Behavior:
      * Item must exist and be `quarantined`. Any other status refuses
        (exit 1) with a pointer to the right command for that status.
      * REFUSES (exit 1) when claude-watch reports a LIVE agent bound to
        this id. A live agent is positive evidence the quarantine is doing
        its job. `--force` overrides for the case where the operator knows
        the state file is wrong.
      * Note the asymmetry: the ABSENCE of an agent record is NOT treated
        as evidence of death, because that inference is precisely what the
        quarantine exists to stop trusting. Absence just means the guard
        has nothing to say, and the operator's explicit call carries it.
      * On success: status=abandoned with `abandon_reason` carrying the
        quarantine reason forward, `quarantine_released_at` /
        `quarantine_released_by` stamped, the transcript archived, and the
        usual `queue-abandoned` claude-event emitted so downstream
        consumers see the same terminal event they always did.
    """
    if not getattr(args, "force", False):
        live_agent = _live_agent_for_queue(args.id)
        if live_agent:
            print(
                f"ERROR: release refused for {args.id}: claude-watch reports "
                f"agent {live_agent} is still ALIVE.",
                file=sys.stderr,
            )
            print(
                "  That is the quarantine working. Let the agent finish (it "
                "will `queue done`), or pass --force if you know the "
                "active-agents state is wrong.",
                file=sys.stderr,
            )
            sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        status = target.get("status")
        if status != "quarantined":
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                f"release refused: {args.id} status={status!r} "
                f"(must be quarantined)",
                file=sys.stderr,
            )
            if status in TERMINAL_STATUSES:
                print("  hint: the item is already terminal; nothing holds "
                      "its scope.", file=sys.stderr)
            elif status in RUNNING_STATUSES:
                print(f"  hint: use `session-task queue abandon {args.id} "
                      f"--reason '...'` to quarantine it first.",
                      file=sys.stderr)
            sys.exit(1)

        quarantined_at = target.get("quarantined_at")
        prior_reason = target.get("quarantine_reason") or ""
        released_by = "operator --force" if getattr(args, "force", False) \
            else "operator"
        now = _fmt_ts()
        target["status"] = "abandoned"
        target["abandoned_at"] = now
        target["quarantine_released_at"] = now
        target["quarantine_released_by"] = released_by
        reason_bits = [b for b in (prior_reason, args.reason) if b]
        target["abandon_reason"] = (
            "quarantine released: " + ("; ".join(reason_bits) or "no reason given")
        )
        target["group_head"] = False
        # Terminal now, so the transcript archive that `abandon` deferred
        # happens here.
        archive_path = _archive_for_item(target, reason="abandon")
        if archive_path:
            target["log_archive_path"] = archive_path
        _recompute_group_heads(items)
        next_head = _group_head(items, target.get("group_id"))
        started_at = target.get("started_at")
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    log_completed(
        f"[queue {target['id']} abandoned] {target.get('description','')} "
        f"(quarantine released: {target['abandon_reason']})",
        extra={
            "source": "queue",
            "event": "abandon",
            "id": target["id"],
            "group_id": target.get("group_id"),
            "reason": target["abandon_reason"],
            "quarantine_released_by": released_by,
        },
    )

    elapsed = _elapsed_minutes(started_at)
    elapsed_sec = _elapsed_seconds(started_at)
    elapsed_str = f"{elapsed}m" if elapsed is not None else "unknown"
    _pingme_notify(
        title=f"queue abandoned: {target['id']}",
        message=(
            f"{_item_summary(target)}\n"
            f"elapsed: {elapsed_str} "
            f"| reason: {target['abandon_reason']} "
            f"| scope: {','.join(target.get('scope', []))}"
        ),
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    # Same terminal lifecycle event `abandon` always emitted, so downstream
    # consumers (main-loop handler, dashboards) need no changes. The extra
    # quarantine_* keys let anyone who cares tell the two paths apart.
    _claude_event_notify(
        tag="queue-abandoned",
        message=(
            f"queue abandoned: {target['id']} ({_item_summary(target)}) "
            f"-- quarantine released by {released_by}"
        ),
        data={
            "queue_id": target["id"],
            "group_id": target.get("group_id"),
            "scope": target.get("scope", []),
            "summary": _item_summary(target),
            "elapsed_sec": elapsed_sec,
            "reason": target["abandon_reason"],
            "quarantined_at": quarantined_at,
            "quarantine_released_by": released_by,
            "created_by": target.get("created_by", ""),
        },
        priority="low",
        silent=getattr(args, "silent", False),
    )

    if getattr(args, "json", False):
        print(json.dumps(target, indent=2))
        return
    print(f"released: {args.id} (quarantine -> abandoned, scope freed)")
    print(f"  released_by: {released_by}")
    if next_head:
        print(f"next in group {target.get('group_id')}: {next_head['id']} "
              f"({next_head.get('description','')[:60]})")


# ---------------------------------------------------------------------------
# Resurrect (recover a queue item whose owning agent died mid-flight).
# ---------------------------------------------------------------------------
#
# After Claude Code crashes + restarts, in-flight agents die but their
# queue items remain `running` (orphaned). PR #255 made claude-watch
# correctly report `queue_id: null` for those ghost agents in
# active-agents.json. The operator still has to manually reconstruct the
# original spawn prompt and re-add the queue item.
#
# `queue resurrect <old-id>` automates that:
#   * read the old item, refuse unless status is running/wedged
#   * find the original agent transcript via `Queue item:` marker grep
#     across all recently-active subagents/ dirs (post-restart there may
#     be multiple session UUID dirs — prefer the OLDEST mtime, which is
#     the pre-restart original spawn; later mtimes are post-restart
#     continuations whose first user frame is a degraded `tool_result`
#     reply rather than the spawn prompt).
#   * extract the first user message text from the JSONL
#   * create a NEW queue item with scope/summary/depends_on/priority
#     copied + description prefixed with
#       ## RESURRECTED FROM <old-id> at <timestamp>
#   * abandon the old item (default; opt out with --keep-old)
#   * stamp resurrect provenance fields on the new item so audit-trail
#     consumers can see the resurrection lineage.
#
# Does NOT auto-register or auto-spawn. The caller is responsible for the
# usual register-and-spawn flow on the new id (same as `queue add`).


def cmd_queue_resurrect(args):
    """Recover an orphaned running/wedged item by spawning a new queue id.

    See module docstring above for the full design rationale.
    """
    # ------------------------------------------------------------------
    # Step 1: read the old item under the queue lock + validate status.
    # ------------------------------------------------------------------
    fh, data = _queue_open_locked("r")
    items_snapshot = list(data["items"])
    _queue_unlock_readonly(fh)

    old = next((it for it in items_snapshot if it.get("id") == args.id), None)
    if old is None:
        print(f"ERROR: queue item {args.id!r} not found.", file=sys.stderr)
        sys.exit(1)

    status = old.get("status")
    # Spec: refuse unless the item OWNS ITS SCOPE (running / wedged /
    # quarantined). Done/abandoned/blocked/pending items should NOT be
    # resurrected — `queue add` is the right tool for a re-run from scratch,
    # and a blocked item still owns its scope so the operator must unblock
    # first.
    #
    # `quarantined` is included deliberately: resurrect IS the respawn path
    # for an agent that really did die, and requiring a separate release
    # first would turn every genuine death into a two-step manual unwedge.
    # Resurrect abandons the old row and carries its scope to the new one,
    # so the lock is never dropped in between.
    if status not in RUNNING_STATUSES:
        print(
            f"ERROR: resurrect refused: {args.id} status={status!r} "
            f"(must be running, wedged or quarantined).",
            file=sys.stderr,
        )
        print(
            f"  hint: use `session-task queue add` to re-run a "
            f"done/abandoned/pending item from scratch.",
            file=sys.stderr,
        )
        sys.exit(1)

    # ------------------------------------------------------------------
    # Step 2: resolve the transcript path. Operator override beats the
    # marker-grep search, so a stale-marker / corrupted-transcript case
    # has an escape hatch.
    # ------------------------------------------------------------------
    src_path = None
    src_source = None  # for diagnostic output
    if args.from_transcript:
        candidate = Path(args.from_transcript).expanduser()
        if not candidate.is_file():
            print(
                f"ERROR: --from-transcript path does not exist or is not a "
                f"file: {candidate}",
                file=sys.stderr,
            )
            sys.exit(1)
        src_path = candidate
        src_source = "override"
    else:
        hits = _find_transcripts_for_queue_marker(args.id)
        if not hits:
            print(
                f"ERROR: no transcript found containing the marker "
                f"`Queue item: {args.id}` under {CLAUDE_AGENTS_JSONL_ROOT} "
                f"(searched freshness-window 24h).",
                file=sys.stderr,
            )
            print(
                f"  hint: pass --from-transcript /path/to/agent-XXXX.jsonl "
                f"to override the auto-search, or use `session-task queue "
                f"add` to recreate the item from scratch.",
                file=sys.stderr,
            )
            sys.exit(1)
        # Oldest first; the pre-restart transcript has the spawn prompt.
        src_path = hits[0]
        src_source = (
            f"oldest of {len(hits)} marker matches" if len(hits) > 1 else "marker match"
        )

    # ------------------------------------------------------------------
    # Step 3: extract the prompt. We want the FIRST user message that
    # contains the `Queue item:` marker — post-restart continuation
    # transcripts have a degraded first frame (tool_result for the dead
    # parent), so plain "first user message" can yield the wrong text.
    # Fall back to the bare first user message if no marker-bearing one
    # exists (i.e. the operator overrode --from-transcript to a file
    # without the marker).
    # ------------------------------------------------------------------
    extracted = _read_first_user_prompt_with_marker(src_path, args.id)
    if extracted is None or not extracted.get("text"):
        # Last-ditch fallback: plain first user message. Useful when the
        # operator points --from-transcript at a hand-written prompt or a
        # transcript predating the queue-marker convention.
        extracted = _read_first_user_prompt_from_jsonl(src_path)
    if extracted is None or not extracted.get("text"):
        print(
            f"ERROR: could not extract a usable user prompt from "
            f"{src_path}. The file may be empty, corrupted, or contain "
            f"only assistant frames.",
            file=sys.stderr,
        )
        print(
            f"  hint: pass --from-transcript /path/to/known-good.jsonl "
            f"to override, or use `session-task queue add` to type the "
            f"prompt by hand.",
            file=sys.stderr,
        )
        sys.exit(1)
    original_prompt = extracted["text"]

    # ------------------------------------------------------------------
    # Step 4: build the new description. The resurrected prompt becomes
    # the new item's `description` (the field the main loop hands to the
    # Agent tool at spawn time), prefixed with the resurrect-provenance
    # header so the spawned agent immediately understands the context.
    # The header includes the new queue id placeholder filled in below
    # AFTER we know it; for now just stash the body and assemble after.
    # ------------------------------------------------------------------
    ts_iso = _fmt_ts()
    resurrect_reason = (args.reason or "").strip() or "orphaned-after-restart"

    # ------------------------------------------------------------------
    # Step 5: under the queue lock, abandon the old item (default) and
    # create the new item. Same atomic-RMW discipline as `queue add` +
    # `queue abandon`. Single lock-acquire so an external observer never
    # sees a state where the old is abandoned but the new doesn't exist
    # (or vice versa).
    # ------------------------------------------------------------------
    summary = (
        (args.summary or "").strip()
        or (old.get("summary") or "").strip()
        or DEFAULT_SUMMARY
    )

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        # Re-fetch under lock: status may have changed since the snapshot.
        old_live = next((it for it in items if it.get("id") == args.id), None)
        if old_live is None:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                f"ERROR: queue item {args.id!r} disappeared between read "
                f"and write. Retry.",
                file=sys.stderr,
            )
            sys.exit(1)
        if old_live.get("status") not in RUNNING_STATUSES:
            cur = old_live.get("status")
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                f"ERROR: queue item {args.id} status changed to {cur!r} "
                f"after the initial read. Re-run resurrect if you still "
                f"want to recover it.",
                file=sys.stderr,
            )
            sys.exit(1)

        # Copy fields from the old item. Scope is carried verbatim — the
        # resurrected agent runs on the same serialization slot as the
        # dead one. Group_id is allocated fresh by reusing the existing
        # add-flow group-merge logic so any overlapping groups merge in.
        scope = list(old_live.get("scope", []))
        priority = int(old_live.get("priority", 5))

        # Carry depends_on forward as task: scope tokens (the canonical
        # storage as of 2026-05-08). They're already in scope, but we
        # surface the list explicitly in the resurrect output so the
        # operator can see what dep edges are inherited.
        carried_deps = [
            _task_token_target(t) for t in scope if _is_task_token(t)
        ]
        carried_deps = [d for d in carried_deps if d]

        # Validate deps still exist (one of them might have been pruned
        # in the meantime). Unknown deps would otherwise stall the new
        # item indefinitely on a phantom edge.
        existing_ids_now = {it.get("id") for it in items}
        unknown_deps = [d for d in carried_deps if d not in existing_ids_now]
        if unknown_deps:
            print(
                f"warning: inherited deps reference unknown queue id(s): "
                f"{','.join(unknown_deps)}. Stripping from scope.",
                file=sys.stderr,
            )
            scope = [
                t for t in scope
                if not (_is_task_token(t) and _task_token_target(t) in unknown_deps)
            ]
            carried_deps = [d for d in carried_deps if d not in unknown_deps]

        # Group allocation — same logic as cmd_queue_add. Resurrected
        # items inherit the original's scope and naturally land in the
        # same group, which is the desired behavior (the dead agent's
        # serialization slot stays serialized).
        overlapping = _group_ids_overlapping(items, scope)
        if len(overlapping) == 0:
            group_id = _new_group_id()
        elif len(overlapping) == 1:
            group_id = overlapping[0]
        else:
            group_id = _new_group_id()
            for it in items:
                if it.get("group_id") in overlapping:
                    it["group_id"] = group_id

        # New id with collision guard.
        new_id = _new_id()
        while new_id in existing_ids_now:
            new_id = _new_id()

        # Assemble the resurrected description. The header includes both
        # the old id (provenance) and the new id (so an agent reading
        # this transcript later can re-cite its own Queue item).
        header = (
            f"## RESURRECTED FROM {args.id} at {ts_iso}\n"
            f"## new queue id: {new_id}\n"
            f"## reason: {resurrect_reason}\n"
            f"## source transcript: {src_path} ({src_source})\n"
            f"\n"
        )
        new_description = header + original_prompt

        new_item = {
            "id": new_id,
            "description": new_description,
            "summary": summary,
            "scope": scope,
            "group_id": group_id,
            "group_head": False,
            "status": "pending",
            "priority": priority,
            "created_at": ts_iso,
            "created_by": (args.created_by or "resurrect").strip() or "resurrect",
            # Resurrection provenance — not consumed by the queue model
            # itself but surfaces in `queue show` for audit.
            "resurrected_from": args.id,
            "resurrected_at": ts_iso,
            "resurrected_reason": resurrect_reason,
            "resurrect_source_transcript": str(src_path),
            "resurrect_truncated": bool(extracted.get("truncated", False)),
        }
        # Carry context forward if the old item had any (e.g. auto-resume
        # opt-outs). Operator can re-override after the fact via context-
        # bearing tools.
        if isinstance(old_live.get("context"), dict):
            new_item["context"] = dict(old_live["context"])

        items.append(new_item)

        # Abandon the old item unless --keep-old. We do this in-process
        # rather than calling cmd_queue_abandon to avoid re-acquiring the
        # lock and to keep the audit / pingme emit consistent with the
        # resurrect lifecycle.
        old_abandoned = False
        if not args.keep_old:
            if old_live.get("status") == "quarantined":
                # Resurrecting is the operator choosing "respawn it", which
                # is also a decision that the old agent is not coming back.
                # Record how the quarantine ended.
                old_live["quarantine_released_at"] = ts_iso
                old_live["quarantine_released_by"] = f"resurrect ({new_id})"
            old_live["status"] = "abandoned"
            old_live["abandoned_at"] = ts_iso
            old_live["abandon_reason"] = (
                f"resurrected as {new_id}: {resurrect_reason}"
            )
            old_live["group_head"] = False
            old_live["resurrected_as"] = new_id
            # Archive the dead agent's transcript so the operator can
            # still inspect what the failed agent did. Best-effort — the
            # helper silently no-ops if it can't find a record.
            archive_path = _archive_for_item(old_live, reason="abandon")
            if archive_path:
                old_live["log_archive_path"] = archive_path
            old_abandoned = True

        _recompute_group_heads(items)

        # Compute ready_now / serialized_after for the NEW item using
        # the same machinery as cmd_queue_add so the caller knows whether
        # to register-and-spawn immediately or wait.
        locked_scopes = data.get("locked_scopes") or {}
        ready_now = _item_is_ready(items, new_item, locked_scopes=locked_scopes)
        lock_blockers = _locked_tokens_blocking_item(new_item, locked_scopes)
        group_members_sorted = sorted(
            [
                it for it in _group_members(items, group_id)
                if it.get("status") == "pending"
            ],
            key=_sort_key,
        )
        position = next(
            (i + 1 for i, it in enumerate(group_members_sorted) if it["id"] == new_id),
            -1,
        )
        serialized_after = [
            it["id"] for it in group_members_sorted
            if it["id"] != new_id and _sort_key(it) < _sort_key(new_item)
        ]
        running_in_group = [
            it["id"] for it in _group_members(items, group_id)
            if it.get("status") in RUNNING_STATUSES
        ]
        serialized_after = running_in_group + serialized_after

        _queue_write_and_unlock(fh, data)
    except Exception:
        try:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
        except Exception:
            pass
        raise

    # ------------------------------------------------------------------
    # Step 6: audit log + lifecycle notifications. Best-effort — we
    # never block the resurrect on a notify failure.
    # ------------------------------------------------------------------
    log_completed(
        f"[queue {new_id} resurrected from {args.id}] {summary}",
        extra={
            "source": "queue",
            "event": "resurrect",
            "id": new_id,
            "from_id": args.id,
            "old_abandoned": old_abandoned,
            "reason": resurrect_reason,
            "source_transcript": str(src_path),
        },
    )

    if old_abandoned:
        # Mirror cmd_queue_abandon's claude-event so downstream consumers
        # (work-queue-exporter, queue-minisite) see a normal transition.
        _claude_event_notify(
            tag="queue-abandoned",
            message=(
                f"queue abandoned: {args.id} (resurrected as {new_id})"
            ),
            data={
                "queue_id": args.id,
                "group_id": old.get("group_id"),
                "scope": old.get("scope", []),
                "summary": _item_summary(old),
                "reason": f"resurrected as {new_id}",
                "resurrected_as": new_id,
                "created_by": old.get("created_by", ""),
            },
            priority="low",
            silent=getattr(args, "silent", False),
        )

    # Build spawn_instruction the same way cmd_queue_add does.
    if ready_now:
        spawn_instruction = (
            f"READY: register-and-spawn (session-task queue register {new_id})"
        )
    else:
        parts = []
        if lock_blockers:
            parts.append("locks: " + ",".join(lock_blockers))
        if serialized_after:
            parts.append("queue: " + ",".join(serialized_after))
        if parts:
            spawn_instruction = (
                "BLOCKED: do not spawn, wait for " + " | ".join(parts)
            )
        else:
            spawn_instruction = "BLOCKED: do not spawn (no head visible)"

    if args.json:
        print(json.dumps({
            "id": new_id,
            "resurrected_from": args.id,
            "old_abandoned": old_abandoned,
            "group_id": group_id,
            "position": position,
            "ready_now": ready_now,
            "serialized_after": serialized_after,
            "lock_blockers": lock_blockers,
            "scope": scope,
            "summary": summary,
            "priority": priority,
            "depends_on": carried_deps,
            "source_transcript": str(src_path),
            "source": src_source,
            "truncated": bool(extracted.get("truncated", False)),
            "spawn_instruction": spawn_instruction,
        }, indent=2))
    else:
        print(f"resurrected: {new_id} (from {args.id})")
        print(f"  source : {src_path} ({src_source})")
        print(f"  summary: {summary}")
        print(f"  scope  : {','.join(scope)}")
        print(f"  group  : {group_id}, position={position}, ready_now="
              f"{'true' if ready_now else 'false'}")
        if old_abandoned:
            print(f"  old    : {args.id} abandoned")
        else:
            print(f"  old    : {args.id} kept ({status})")
        if carried_deps:
            print(f"  deps   : {','.join(carried_deps)}")
        if lock_blockers:
            print(f"  lock_blockers: {','.join(lock_blockers)}")
        print(f"  next   : {spawn_instruction}")


def _read_first_user_prompt_with_marker(jsonl_path, queue_id, *, max_chars=20_000):
    """Pull the first user message containing ``Queue item: <queue_id>``.

    Mirrors ``_read_first_user_prompt_from_jsonl`` but additionally
    requires the marker. Post-restart continuation transcripts have a
    degraded first frame (a tool_result reply or an Exit-code 137 user
    message) that doesn't re-cite the queue id — taking that as "the
    prompt" would resurrect with the wrong text. Returns the same shape
    as the bare helper (``{"text": ..., "truncated": bool}``) or None if
    no marker-bearing user message is found.
    """
    if jsonl_path is None:
        return None
    needle = f"Queue item: {queue_id}"
    try:
        with open(jsonl_path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except (json.JSONDecodeError, ValueError):
                    continue
                msg = rec.get("message")
                if not isinstance(msg, dict):
                    continue
                if msg.get("role") != "user":
                    continue
                content = msg.get("content")
                text = None
                if isinstance(content, str):
                    text = content
                elif isinstance(content, list):
                    pieces = []
                    for blk in content:
                        if isinstance(blk, dict) and blk.get("type") == "text":
                            t = blk.get("text")
                            if isinstance(t, str):
                                pieces.append(t)
                    if pieces:
                        text = "\n".join(pieces)
                if text is None:
                    continue
                if needle not in text:
                    continue
                truncated = False
                if len(text) > max_chars:
                    text = text[:max_chars]
                    truncated = True
                return {"text": text, "truncated": truncated}
    except OSError:
        return None
    return None


def cmd_queue_pop(args):
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        locked_scopes = data.get("locked_scopes") or {}
        target = None
        if args.id:
            target = next((it for it in items if it["id"] == args.id), None)
            if target is None:
                print(f"not found: {args.id}", file=sys.stderr)
                fcntl.flock(fh, fcntl.LOCK_UN)
                fh.close()
                sys.exit(1)
            if not _item_is_ready(items, target, locked_scopes=locked_scopes):
                print(f"not ready: {args.id}", file=sys.stderr)
                fcntl.flock(fh, fcntl.LOCK_UN)
                fh.close()
                sys.exit(1)
        else:
            ready = [it for it in items if _item_is_ready(items, it, locked_scopes=locked_scopes)]
            ready.sort(key=_sort_key)
            if not ready:
                print("(nothing ready)")
                fcntl.flock(fh, fcntl.LOCK_UN)
                fh.close()
                sys.exit(1)
            target = ready[0]

        # Belt-and-suspenders spawn-gating: even though _item_is_ready has
        # already checked group-head status, also refuse to pop if any OTHER
        # running item has overlapping scope. This catches the case where an
        # item got registered through a raced add, or there's an untracked
        # in-flight agent on the same scope (rare but possible). Mirrors the
        # `queue register` invariant so `pop` and `register` behave the same.
        ok, reasons, conflicts = _spawn_check(items, target, locked_scopes=locked_scopes)
        if not ok:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(f"!! POP REFUSED: {target['id']} IS NOT CLEAR TO SPAWN.",
                  file=sys.stderr)
            print("!! DO NOT SPAWN ANY AGENT FOR THIS WORK.", file=sys.stderr)
            print("!! RUN THE CONFLICTING WORK FIRST OR WAIT FOR IT TO FINISH.",
                  file=sys.stderr)
            print("!! REASONS:", file=sys.stderr)
            for r in reasons:
                print(f"!!   - {r}", file=sys.stderr)
            if conflicts:
                print("!! RUNNING SCOPE OVERLAPS:", file=sys.stderr)
                for c in conflicts:
                    print(
                        f"!!   - {c['id']} (group {c.get('group_id')}): "
                        f"{','.join(c.get('scope', []))}",
                        file=sys.stderr,
                    )
            print(bar, file=sys.stderr)
            sys.exit(2)

        target["status"] = "running"
        target["started_at"] = _fmt_ts()
        _recompute_group_heads(items)
        popped = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise
    print(json.dumps(popped, indent=2))


def _spawn_check(items, item, locked_scopes=None):
    """Return (ok, reasons, conflicts) tuple for spawn-gating.

    ok (bool):
        True iff it is safe to spawn an agent for this queue item right now.

    reasons (list[str]):
        Human-readable rejection reasons if not ok.

    conflicts (list[dict]):
        Running items whose scope overlaps this item's scope (excluding
        the item itself if it's already running).

    locked_scopes (dict|None):
        Operator-declared lock set (from queue.json `locked_scopes`).
        If a pending item's scope overlaps any locked token, the spawn
        is refused with a `lock` reason — distinct from in-flight peers.
    """
    reasons = []
    conflicts = _running_scope_conflicts(
        items, item.get("scope", []), exclude_id=item.get("id"),
    )

    # Manual lock check (added 2026-05-08): a locked scope is an explicit
    # "park this work" gate. Even if the item is otherwise ready, a lock
    # forbids spawning. Covers both pending (where _item_is_ready also
    # returns False) and running edge cases (no-op there since register
    # already happened — kept here so callers can use spawn-check on
    # in-flight items defensively).
    lock_blockers = _locked_tokens_blocking_item(item, locked_scopes)
    if lock_blockers:
        reasons.append(
            "scope is locked: " + ",".join(lock_blockers)
        )

    status = item.get("status")
    if status not in ("pending", "running"):
        reasons.append(f"item status is {status!r} (must be pending or running)")
    elif status == "pending":
        if not _item_is_ready(items, item, locked_scopes=locked_scopes):
            # Distinguish lock-blocked from group-head-blocked so the
            # operator's banner reads cleanly. Lock blockers have already
            # been captured above; only add the head reason if the item
            # would otherwise be the head.
            if not lock_blockers:
                reasons.append(
                    "item is not ready (blocked behind another item in its group "
                    f"{item.get('group_id')!r})"
                )

    # Any cross-group running conflict is a hard reject. Same-group conflicts
    # would be a group-invariant violation (only one running per group).
    cross = [c for c in conflicts if c.get("group_id") != item.get("group_id")]
    if cross:
        reasons.append(
            "scope overlaps {n} running item(s) in other group(s): {ids}".format(
                n=len(cross),
                ids=", ".join(f"{c['id']}({c.get('group_id')})" for c in cross),
            )
        )

    same_group_running = [
        c for c in conflicts if c.get("group_id") == item.get("group_id")
    ]
    if same_group_running and item.get("status") == "pending":
        # Should be caught by _item_is_ready above, but be explicit.
        reasons.append(
            "same-group running peer(s) exist: "
            + ", ".join(c["id"] for c in same_group_running)
        )

    # Quarantined blockers get their own line. Without it the operator reads
    # "overlaps running item(s)", goes looking for a live agent, finds none,
    # and concludes the queue is stale — which is how the scope lock gets
    # talked away. Name the state and name the exit.
    quarantined = [c for c in conflicts if c.get("status") == "quarantined"]
    if quarantined:
        reasons.append(
            "blocked by QUARANTINED item(s) {ids}: an earlier abandon "
            "presumed the agent dead WITHOUT proof, so the scope is still "
            "held. Resolve with `queue resurrect <id>` (respawn) or "
            "`queue release <id> --reason ...` (you know it's gone) -- "
            "do NOT spawn a second agent on this scope.".format(
                ids=", ".join(c["id"] for c in quarantined),
            )
        )

    return (len(reasons) == 0, reasons, conflicts)


def cmd_queue_spawn_check(args):
    fh, data = _queue_open_locked("r")
    items = list(data["items"])
    locked_scopes = data.get("locked_scopes") or {}
    _queue_unlock_readonly(fh)

    target = next((it for it in items if it["id"] == args.id), None)
    if target is None:
        print("", file=sys.stderr)
        bar = "!" * 72
        print(bar, file=sys.stderr)
        print(f"!! SPAWN-CHECK REFUSED: QUEUE ITEM {args.id!r} NOT FOUND.",
              file=sys.stderr)
        print("!! DO NOT SPAWN ANY AGENT. THE QUEUE HAS NO RECORD OF THIS WORK.",
              file=sys.stderr)
        print(bar, file=sys.stderr)
        sys.exit(2)

    ok, reasons, conflicts = _spawn_check(items, target, locked_scopes=locked_scopes)
    conflict_info = [
        {"id": c["id"], "group_id": c.get("group_id"),
         "status": c.get("status"), "scope": c.get("scope", [])}
        for c in conflicts
    ]

    if args.json:
        print(json.dumps({
            "id": target["id"],
            "status": target.get("status"),
            "group_id": target.get("group_id"),
            "scope": target.get("scope", []),
            "ok": ok,
            "reasons": reasons,
            "conflicts": conflict_info,
            "spawn_instruction": (
                f"READY: register-and-spawn (session-task queue register {target['id']})"
                if ok
                else "BLOCKED: do not spawn, resolve the conflicts listed above"
            ),
        }, indent=2))
        sys.exit(0 if ok else 2)

    if ok:
        print(f"ok: {target['id']}")
        print(f"  status: {target.get('status')}")
        print(f"  group : {target.get('group_id')}")
        print(f"  scope : {','.join(target.get('scope', []))}")
        print(f"  next  : session-task queue register {target['id']}")
        sys.exit(0)

    # HARD-FAIL path: ALL CAPS stderr so the main loop cannot miss it.
    print("", file=sys.stderr)
    bar = "!" * 72
    print(bar, file=sys.stderr)
    print(f"!! SPAWN-CHECK FAILED: {target['id']} IS NOT CLEAR TO SPAWN.",
          file=sys.stderr)
    print("!! DO NOT SPAWN ANY AGENT FOR THIS WORK.", file=sys.stderr)
    print("!! RUN THE CONFLICTING WORK FIRST OR WAIT FOR IT TO FINISH.",
          file=sys.stderr)
    print("!!", file=sys.stderr)
    print(f"!! ITEM  : {target['id']} (status={target.get('status')}, "
          f"group={target.get('group_id')})", file=sys.stderr)
    print(f"!! SCOPE : {','.join(target.get('scope', []))}", file=sys.stderr)
    print("!! REASONS:", file=sys.stderr)
    for r in reasons:
        print(f"!!   - {r}", file=sys.stderr)
    if conflicts:
        print("!! RUNNING SCOPE OVERLAPS:", file=sys.stderr)
        for c in conflicts:
            print(
                f"!!   - {c['id']} (group {c.get('group_id')}, "
                f"status {c.get('status')}): {','.join(c.get('scope', []))}",
                file=sys.stderr,
            )
    print(bar, file=sys.stderr)

    sys.exit(2)


def cmd_queue_register(args):
    """Atomically claim a pending item as running (spawn-gating entry point).

    Refuses if:
      * item does not exist
      * item is not pending (already running/done/abandoned)
      * item is not the ready head of its group (blocked on a peer)
      * any OTHER running item's scope overlaps this item's scope
        (cross-group conflict -- indicates an unregistered in-flight agent
        the main loop is responsible for)

    This is the single source of truth for "is this agent allowed to spawn
    right now". The main loop MUST call register before invoking the Agent
    tool; an unregistered spawn is an operating-rules violation.
    """
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        locked_scopes = data.get("locked_scopes") or {}
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(f"!! REGISTER REFUSED: QUEUE ITEM {args.id!r} NOT FOUND.",
                  file=sys.stderr)
            print("!! DO NOT SPAWN ANY AGENT. THE QUEUE HAS NO RECORD OF THIS WORK.",
                  file=sys.stderr)
            print(bar, file=sys.stderr)
            sys.exit(2)

        if target.get("status") == "running":
            # Idempotent-ish: re-registering something that's already running
            # is fine if --if-absent, but default refuses so the caller
            # notices double-register.
            if args.if_absent:
                print(f"already running: {args.id}")
                fcntl.flock(fh, fcntl.LOCK_UN)
                fh.close()
                return
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(f"!! REGISTER REFUSED: {args.id} IS ALREADY RUNNING.",
                  file=sys.stderr)
            print("!! DOUBLE-SPAWN DETECTED. DO NOT SPAWN ANOTHER AGENT.",
                  file=sys.stderr)
            print("!! IF THE ORIGINAL AGENT DIED, MARK IT ABANDONED FIRST:",
                  file=sys.stderr)
            print(f"!!   session-task queue abandon {args.id} --reason '...'",
                  file=sys.stderr)
            print("!! OR USE --if-absent TO NO-OP WHEN THE ITEM IS ALREADY RUNNING.",
                  file=sys.stderr)
            print(bar, file=sys.stderr)
            sys.exit(2)

        if target.get("status") == "wedged":
            # A wedged item still owns its scope. Re-registering would
            # blow past the wedge without resolving it. Operator must
            # explicitly unwedge (back to running) or abandon first.
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(f"!! REGISTER REFUSED: {args.id} IS WEDGED.", file=sys.stderr)
            print("!! THE OWNING AGENT IS STUCK BUT STILL HOLDS THE SCOPE.",
                  file=sys.stderr)
            print("!! UNWEDGE OR ABANDON BEFORE REGISTERING A REPLACEMENT:",
                  file=sys.stderr)
            print(f"!!   session-task queue unwedge {args.id}", file=sys.stderr)
            print(f"!!   session-task queue abandon {args.id} --reason '...'",
                  file=sys.stderr)
            wr = target.get("wedged_reason")
            if wr:
                print(f"!! WEDGED REASON: {wr}", file=sys.stderr)
            print(bar, file=sys.stderr)
            sys.exit(2)

        if target.get("status") == "quarantined":
            # A quarantined item was abandoned on an INFERENCE that its
            # agent died. It still owns its scope precisely because that
            # inference might be wrong. Re-registering it in place would
            # re-create the double-spawn the quarantine exists to prevent.
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(f"!! REGISTER REFUSED: {args.id} IS QUARANTINED.",
                  file=sys.stderr)
            print("!! IT WAS ABANDONED ON A GUESS THAT ITS AGENT DIED, AND IT",
                  file=sys.stderr)
            print("!! STILL HOLDS THE SCOPE. THE AGENT MAY STILL BE WORKING.",
                  file=sys.stderr)
            print("!! RESOLVE THE QUARANTINE FIRST:", file=sys.stderr)
            print(f"!!   session-task queue resurrect {args.id}"
                  "        # respawn a replacement (scope carries over)",
                  file=sys.stderr)
            print(f"!!   session-task queue release {args.id} --reason '...'"
                  "  # you know the process is gone",
                  file=sys.stderr)
            qr = target.get("quarantine_reason")
            if qr:
                print(f"!! QUARANTINE REASON: {qr}", file=sys.stderr)
            print(f"!! QUARANTINED AT   : {target.get('quarantined_at')}",
                  file=sys.stderr)
            print(bar, file=sys.stderr)
            sys.exit(2)

        if target.get("status") == "blocked":
            # A blocked item is parked on an external blocker. It has
            # RELEASED its scope lock (a peer in the same scope may spawn),
            # but it is still THIS item -- re-registering it in place would
            # lose the block_reason audit trail and race the external action
            # in flight. The operator must explicitly unblock (back to
            # running, which re-acquires the scope lock and serializes like
            # any running item) or move it to a terminal state first.
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(f"!! REGISTER REFUSED: {args.id} IS BLOCKED.", file=sys.stderr)
            print("!! THE ITEM IS PARKED ON AN EXTERNAL BLOCKER AND STILL OWNS THE SCOPE.",
                  file=sys.stderr)
            print("!! UNBLOCK OR ABANDON BEFORE REGISTERING A REPLACEMENT:",
                  file=sys.stderr)
            print(f"!!   session-task queue unblock {args.id}", file=sys.stderr)
            print(f"!!   session-task queue abandon {args.id} --reason '...'",
                  file=sys.stderr)
            br = target.get("block_reason")
            if br:
                print(f"!! BLOCK REASON: {br}", file=sys.stderr)
            print(bar, file=sys.stderr)
            sys.exit(2)

        ok, reasons, conflicts = _spawn_check(items, target, locked_scopes=locked_scopes)
        if not ok:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(f"!! REGISTER REFUSED: {args.id} IS NOT CLEAR TO SPAWN.",
                  file=sys.stderr)
            print("!! DO NOT SPAWN ANY AGENT FOR THIS WORK.", file=sys.stderr)
            print("!! RUN THE CONFLICTING WORK FIRST OR WAIT FOR IT TO FINISH.",
                  file=sys.stderr)
            print("!!", file=sys.stderr)
            print(f"!! ITEM  : {args.id} (status={target.get('status')}, "
                  f"group={target.get('group_id')})", file=sys.stderr)
            print(f"!! SCOPE : {','.join(target.get('scope', []))}",
                  file=sys.stderr)
            print("!! REASONS:", file=sys.stderr)
            for r in reasons:
                print(f"!!   - {r}", file=sys.stderr)
            if conflicts:
                print("!! RUNNING SCOPE OVERLAPS:", file=sys.stderr)
                for c in conflicts:
                    print(
                        f"!!   - {c['id']} (group {c.get('group_id')}): "
                        f"{','.join(c.get('scope', []))}",
                        file=sys.stderr,
                    )
            print(bar, file=sys.stderr)
            sys.exit(2)

        target["status"] = "running"
        target["started_at"] = _fmt_ts()
        target["registered_at"] = target["started_at"]
        # Liveness telemetry (added 2026-05-01, revised same day).
        #
        # `pid` is OPTIONAL and defaults to None (deferred PID stamping). Why:
        # `register` is overwhelmingly invoked from a shell wrapper inside the
        # main loop, and that shell is ephemeral — `os.getpid()` returns the
        # bash subshell PID, which exits within seconds, so any /proc-based
        # liveness check immediately sees a dead PID and fires a false-
        # positive WorkQueueOrphaned alert (the bug fixed here). Pass
        # `--pid N` explicitly when the caller actually has a long-lived PID
        # to stamp (e.g. a wrapper that fork+execs the agent and knows the
        # child PID). Subagents typically don't either — they live inside an
        # LLM context, not a single OS process — so they should heartbeat
        # against `last_heartbeat_at` instead of trying to claim a PID.
        #
        # `last_heartbeat_at` is initialized to started_at. The exporter
        # treats pid=None items as "trusted alive" while their heartbeat age
        # is within HEARTBEAT_GRACE_SECONDS (default 300s); subagents call
        # `queue heartbeat <id>` periodically to refresh that timestamp.
        # Once heartbeat age exceeds the grace window, the exporter flips
        # has_live_owner to 0 and WorkQueueOrphaned fires.
        if args.pid is not None:
            try:
                target["pid"] = int(args.pid)
            except (TypeError, ValueError):
                # Bad explicit --pid value — leave unstamped rather than
                # silently fall back to the caller's ephemeral PID.
                target["pid"] = None
        else:
            target["pid"] = None
        target["last_heartbeat_at"] = target["started_at"]
        if args.note:
            target.setdefault("register_notes", []).append({
                "at": target["started_at"],
                "note": args.note,
            })
        # Owner attribution for resumed/rebound items (#3615/#3617). The
        # spawn-time arm-hook binds an agent_id only for the ORIGINAL spawn
        # marker; an agent RESUMED onto a rotated id via a mid-flight
        # register otherwise leaves the new item ownerless ("owner unknown"
        # on the dashboard though it is actively running). Stamp the
        # invoking subagent's agent_id so the item carries its true owner.
        # SAFE no-op for main-loop registers: resolution yields None (the
        # main-loop transcript is not under a subagents/ dir), and we NEVER
        # clobber an existing binding with null -- an unresolved owner
        # leaves any prior agent_id intact.
        resolved_aid = getattr(args, "agent_id", None)
        resolved_aid = resolved_aid.strip() if isinstance(resolved_aid, str) else None
        if not resolved_aid:
            resolved_aid = _registering_subagent_agent_id(args.id)
        if resolved_aid and target.get("agent_id") != resolved_aid:
            target["agent_id"] = resolved_aid
            target["agent_id_source"] = "register"
            target["agent_id_stamped_at"] = target["started_at"]
        _recompute_group_heads(items)
        registered = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    # Lifecycle notification: task start. Never blocks the register op.
    # Summary goes on the first line so it's the Pushover preview text;
    # scope/priority follow as secondary context.
    _pingme_notify(
        title=f"queue started: {registered['id']}",
        message=(
            f"{_item_summary(registered)}\n"
            f"scope: {','.join(registered.get('scope', []))} "
            f"| priority: {registered.get('priority', 5)}"
        ),
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    if args.json:
        print(json.dumps(registered, indent=2))
    else:
        print(f"registered: {args.id} (now running)")
        print(f"  group : {registered.get('group_id')}")
        print(f"  scope : {','.join(registered.get('scope', []))}")
        print("  next  : spawn the agent. call `queue done` when it finishes.")


def cmd_queue_force_start(args):
    """Atomically promote a pending item to running, bypassing scope blockers.

    This is the manual override for the spawn-gate's serialization rules.
    Use ONLY when an operator has consciously decided to override scope-
    conflict serialization — e.g. because the running blocker is wedged,
    or because the work genuinely is independent and the scope tokens
    were mis-set.

    Refuses if:
      * --reason is missing or empty (force-start is auditable; an
        unattributed override defeats the audit log).
      * the item does not exist.
      * the item is not in status=pending (already running, done, or
        abandoned items can't be force-started).

    On success:
      * status flips to running, started_at + registered_at + heartbeat
        are stamped (same as `register`).
      * `force_started_at` (epoch seconds, unix int) and
        `force_started_reason` are written to the queue record so the
        item carries its own provenance.
      * `force_started_blockers_overridden` is the list of running
        items whose scope overlapped this one (the conflicts that the
        normal register path would have refused on).
      * an audit row is appended to QUEUE_FORCE_START_LOG.
      * a `queue-running` claude-event is emitted with
        force_started=true so downstream consumers can distinguish the
        override path from a normal register.

    Same atomic flock-on-queue.json discipline as register/done.
    """
    raw_reason = (args.reason or "").strip()
    if not raw_reason:
        print(
            "ERROR: --reason is required for force-start (override is auditable).",
            file=sys.stderr,
        )
        sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                f"ERROR: queue item {args.id!r} not found.",
                file=sys.stderr,
            )
            sys.exit(1)

        status = target.get("status")
        if status != "pending":
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                f"ERROR: force-start refused: {args.id} status={status!r} "
                f"(must be pending; running/done/abandoned items cannot be "
                f"force-started).",
                file=sys.stderr,
            )
            sys.exit(1)

        # Capture the blockers we are overriding so the audit log + queue
        # record carry the provenance. We do NOT bail on overlaps — that's
        # the entire point of force-start.
        scope = target.get("scope", [])
        gid = target.get("group_id")
        cross_blockers = _running_scope_conflicts(
            items, scope, exclude_id=target.get("id"),
        )
        # Same-group not-yet-running peers (the FIFO blockers within this
        # group) — they don't strictly "conflict" via overlapping scope
        # but they do block readiness. Captured for the audit log.
        same_group_pending_peers = [
            it for it in items
            if it.get("group_id") == gid
            and it.get("id") != target.get("id")
            and it.get("status") == "pending"
        ]

        blockers_overridden = []
        for c in cross_blockers:
            blockers_overridden.append({
                "id": c["id"],
                "group_id": c.get("group_id"),
                "status": c.get("status"),
                "scope": c.get("scope", []),
                "reason": "running scope overlap",
            })
        for p in same_group_pending_peers:
            blockers_overridden.append({
                "id": p["id"],
                "group_id": p.get("group_id"),
                "status": p.get("status"),
                "scope": p.get("scope", []),
                "reason": "same-group pending peer (FIFO blocker)",
            })

        # Autostop overlapping running peers (Andrew 2026-05-02 21:10 UTC):
        # any RUNNING item whose scope OVERLAPS the force-started item is
        # auto-abandoned, its recovery context captured, and (best-effort)
        # its agent process killed. The interrupter (the new agent) will
        # decide what to do with the leftovers — we never auto-stash.
        # Capture happens BEFORE `target` flips to running so the autostop
        # routine doesn't accidentally include `target` in its scope-
        # overlap walk (the running-status filter would catch it anyway,
        # but we belt-and-suspenders by running this first).
        autostop_bundles = _autostop_overlapping_peers(
            items, target, raw_reason=raw_reason,
        )

        now_iso = _fmt_ts()
        target["status"] = "running"
        target["started_at"] = now_iso
        target["registered_at"] = now_iso
        target["last_heartbeat_at"] = now_iso
        target["pid"] = None  # ephemeral-shell PID is not useful here
        target["force_started_at"] = int(datetime.now(timezone.utc).timestamp())
        target["force_started_reason"] = raw_reason
        target["force_started_blockers_overridden"] = blockers_overridden
        target["force_started_autostopped_peers"] = [
            b["queue_id"] for b in autostop_bundles
        ]

        _recompute_group_heads(items)
        promoted = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    # Audit log: append a JSONL row. Best-effort — never block the
    # promotion on a log write failure.
    try:
        QUEUE_FORCE_START_LOG.parent.mkdir(parents=True, exist_ok=True)
        audit_row = {
            "timestamp": promoted["force_started_at"],
            "timestamp_iso": now_iso,
            "queue_id": promoted["id"],
            "reason": raw_reason,
            "scope": promoted.get("scope", []),
            "group_id": promoted.get("group_id"),
            "summary": _item_summary(promoted),
            "blockers_overridden": blockers_overridden,
            "autostopped_peers": [b["queue_id"] for b in autostop_bundles],
        }
        with open(QUEUE_FORCE_START_LOG, "a") as logf:
            logf.write(json.dumps(audit_row) + "\n")
    except OSError as exc:
        print(
            f"WARNING: failed to append to {QUEUE_FORCE_START_LOG}: {exc}",
            file=sys.stderr,
        )

    # Recovery bundle: persist a per-force-start JSON file containing the
    # full recovery context (prompts, transcript paths, git status/diff,
    # queue summaries) for every autostopped peer. The new agent reads
    # this to decide resume/integrate/stash/abandon for each leftover.
    # The file is always written, even when there are zero autostopped
    # peers — the empty-list case is a useful "you're force-starting in
    # the clear" signal for downstream consumers.
    bundle_path = _write_force_start_bundle(
        target_id=promoted["id"],
        target_summary=_item_summary(promoted),
        raw_reason=raw_reason,
        autostop_bundles=autostop_bundles,
    )

    # Lifecycle pingme — same shape as register, with the override called
    # out so it's visually distinct in the notification stream.
    _pingme_notify(
        title=f"queue force-started: {promoted['id']}",
        message=(
            f"{_item_summary(promoted)}\n"
            f"scope: {','.join(promoted.get('scope', []))} "
            f"| priority: {promoted.get('priority', 5)}\n"
            f"force-started, blockers overridden: {len(blockers_overridden)}\n"
            f"reason: {raw_reason}"
        ),
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    # Claude-event emit: queue-running with force_started=true so consumers
    # can branch on the override path (alerting, exporter labels, etc.).
    _claude_event_notify(
        tag="queue-running",
        message=(
            f"queue running (force-started): {promoted['id']} "
            f"({_item_summary(promoted)})"
        ),
        data={
            "queue_id": promoted["id"],
            "group_id": promoted.get("group_id"),
            "scope": promoted.get("scope", []),
            "summary": _item_summary(promoted),
            "created_by": promoted.get("created_by", ""),
            "force_started": True,
            "force_started_reason": raw_reason,
            "force_started_blockers_overridden": [
                b["id"] for b in blockers_overridden
            ],
        },
        priority="low",
        silent=getattr(args, "silent", False),
    )

    # Claude-event emit: dedicated `force-start` tag so `claude-event-watch`
    # surfaces force-starts distinctly to the main loop. The companion
    # obligation (next call) provides the hard gate; this event is the
    # signal-via-bus layer requested by Andrew (2026-05-02 19:54 ET):
    # "force starting should both emit an event AND add a hard obligation
    # to spawn." Routed in claude-event-routing.md.
    #
    # Recovery bundle path is included so the main loop can paste it into
    # the spawned Agent's prompt verbatim — the Agent reads the file to
    # see what was autostopped and triages.
    _claude_event_notify(
        tag="force-start",
        message=(
            f"queue force-started: {promoted['id']} "
            f"({_item_summary(promoted)}) -- main loop must dispatch "
            f"Agent before any other tool call"
            + (
                f" | autostopped {len(autostop_bundles)} running peer(s); "
                f"recovery bundle: {bundle_path}"
                if autostop_bundles else ""
            )
        ),
        data={
            "queue_id": promoted["id"],
            "group_id": promoted.get("group_id"),
            "scope": promoted.get("scope", []),
            "summary": _item_summary(promoted),
            "created_by": promoted.get("created_by", ""),
            "force_started_reason": raw_reason,
            "autostopped_peers": [b["queue_id"] for b in autostop_bundles],
            "recovery_bundle_path": bundle_path,
        },
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    # Obligations gate: hard-deny every non-exempt main-loop tool call
    # until an Agent has been spawned for this queue id. The Agent tool
    # is in UNIVERSAL_RECOVERY_EXEMPT_PATTERNS so the spawning call is
    # never blocked by its own gate. TTL 15min so a wedged main loop
    # doesn't deadlock forever.
    _obligations_register_force_start(
        queue_id=promoted["id"],
        summary=_item_summary(promoted),
        reason=raw_reason,
        bundle_path=bundle_path,
        autostopped_count=len(autostop_bundles),
    )

    if args.json:
        # Surface the recovery bundle path in JSON output too — UIs
        # (queue-minisite Force-Start button) want to thread the path
        # through to the next agent's prompt without re-running force-
        # start to fish it out.
        promoted_out = dict(promoted)
        promoted_out["force_started_recovery_bundle_path"] = bundle_path
        promoted_out["force_started_autostopped_peers"] = [
            b["queue_id"] for b in autostop_bundles
        ]
        print(json.dumps(promoted_out, indent=2))
    else:
        print(f"force-started: {args.id} (now running)")
        print(f"  group   : {promoted.get('group_id')}")
        print(f"  scope   : {','.join(promoted.get('scope', []))}")
        print(f"  reason  : {raw_reason}")
        if blockers_overridden:
            print(f"  blockers overridden: {len(blockers_overridden)}")
            for b in blockers_overridden:
                print(
                    f"    - {b['id']} ({b['reason']}; "
                    f"scope={','.join(b.get('scope', []))})"
                )
        else:
            print("  blockers overridden: none "
                  "(item was already ready — force-start was a no-op gate skip)")
        if autostop_bundles:
            print(f"  autostopped running peers: {len(autostop_bundles)}")
            for b in autostop_bundles:
                kill_outcome = b.get("agent_kill_outcome") or {}
                kill_str = (
                    "killed" if kill_outcome.get("ok")
                    else f"kill skipped ({kill_outcome.get('reason') or kill_outcome.get('exit_code')})"
                )
                print(
                    f"    - {b['queue_id']} (agent={b.get('agent_id') or 'n/a'}, "
                    f"{kill_str}; scope={','.join(b.get('scope', []))})"
                )
            if bundle_path:
                print(f"  recovery bundle: {bundle_path}")
                print(
                    "  NOTE: pass this path to the spawned Agent so it can "
                    "triage (resume/integrate/stash/abandon)."
                )
        elif bundle_path:
            print(f"  recovery bundle: {bundle_path} (no peers autostopped)")


def cmd_queue_heartbeat(args):
    """Refresh the liveness timestamp (and optionally PID) on a running item.

    Counterpart to the `last_heartbeat_at` field stamped by `register`.
    Designed to be called periodically by long-running subagents so the
    work-queue-exporter can distinguish "still active" from "abandoned"
    without false-positive orphan alerts.

    Behavior:
      * Item must exist and be in status=running. Anything else exits 1.
      * Default: bumps `last_heartbeat_at` to now and DOES NOT touch `pid`.
        This is the safe path for subagents calling from an ephemeral shell
        — `os.getpid()` would just stamp a soon-dead bash PID and trigger
        the very false-positive this CLI exists to prevent.
      * `--pid <N>` to stamp an explicit owning PID (caller asserts they
        have a real long-lived PID to point at). Bad values are rejected
        rather than falling back to the caller's PID.
      * `--keep-pid` is retained as a no-op alias for backward compatibility
        with the previous default (which DID stamp the caller PID); new
        callers can omit it.

    No pingme / claude-event emissions -- heartbeats are high-frequency by
    design and we don't want to spam the lifecycle bus. The exporter polls
    queue.json every scrape and surfaces both fields as gauges.
    """
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        if target.get("status") != "running":
            print(
                f"heartbeat refused: {args.id} status={target.get('status')!r} "
                f"(must be running)",
                file=sys.stderr,
            )
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        now = _fmt_ts()
        target["last_heartbeat_at"] = now
        # Only update `pid` when the caller has explicitly asserted a value.
        # Default (and `--keep-pid`) leave the existing pid alone — never
        # stamp the ephemeral caller-shell PID, which would defeat the
        # purpose of the CLI. Sentinel `--pid 0` CLEARS the pid (back to
        # null) — useful for migrating existing items that were stamped
        # with the now-known-bad ephemeral-shell-PID default before the
        # 2026-05-01 fix.
        if args.pid is not None and not args.keep_pid:
            try:
                pid_int = int(args.pid)
                if pid_int == 0:
                    target["pid"] = None
                else:
                    target["pid"] = pid_int
            except (TypeError, ValueError):
                # Leave existing pid untouched on bad input rather than
                # silently corrupting it.
                pass
        updated = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    if args.json:
        print(json.dumps(updated, indent=2))
    else:
        print(
            f"heartbeat: {args.id} pid={updated.get('pid')} "
            f"last_heartbeat_at={updated.get('last_heartbeat_at')}"
        )


def cmd_queue_wedge(args):
    """Flip a running queue item to status=wedged with a reason.

    Wedged is a transient "in-flight but stuck" state. The item still
    owns its scope (peers cannot grab it via spawn-gating) but is
    flagged distinctly in CLI/exporter/UI so the operator can see the
    wedge at a glance instead of the row sitting indistinguishable from
    a healthy long-runner.

    Two ways to recover:
      * `queue unwedge <id>`  -- back to running (the agent recovered)
      * `queue abandon <id>`  -- operator gives up

    Behavior:
      * Item must exist and be in status=running. Any other status (pending,
        wedged, done, abandoned) refuses.
      * `--reason TEXT` is REQUIRED -- a wedge without a reason defeats
        the operator-attention purpose. Common reasons:
          - "context_limit"       (claude-watch wedged-pane fired)
          - "prolonged-thinking"  (foreground monitor fired)
          - "heartbeat-stale"     (last_heartbeat_at older than threshold)
          - "operator-flag"       (manual: anything else)
      * Stamps `wedged_at` (ISO timestamp), `wedged_reason`. Preserves
        `started_at`, `last_heartbeat_at`, `pid` for post-mortem.
      * Emits a `queue-wedged` claude-event so the main loop / dashboard
        can surface a banner alert.
      * Pingme notification fires by default (this is an attention-
        required event); --silent suppresses it.
    """
    raw_reason = (args.reason or "").strip()
    if not raw_reason:
        print(
            "ERROR: --reason is required for wedge "
            "(common values: context_limit, prolonged-thinking, "
            "heartbeat-stale, operator-flag).",
            file=sys.stderr,
        )
        sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        status = target.get("status")
        if status != "running":
            print(
                f"wedge refused: {args.id} status={status!r} (must be running)",
                file=sys.stderr,
            )
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)

        target["status"] = "wedged"
        target["wedged_at"] = _fmt_ts()
        target["wedged_reason"] = raw_reason
        # group_head stays as-is -- a wedged item is still the in-flight
        # head of its group. _recompute_group_heads will confirm.
        _recompute_group_heads(items)
        updated = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    log_completed(
        f"[queue {target['id']} WEDGED] {target.get('description','')} "
        f"(reason: {raw_reason})",
        extra={
            "source": "queue",
            "event": "wedge",
            "id": target["id"],
            "group_id": target.get("group_id"),
            "reason": raw_reason,
        },
    )

    # Pingme: wedge IS an attention-required event. High priority so the
    # banner cuts through other notifications.
    _pingme_notify(
        title=f"queue WEDGED: {target['id']}",
        message=(
            f"{_item_summary(target)}\n"
            f"reason: {raw_reason} | "
            f"scope: {','.join(target.get('scope', []))}"
        ),
        priority="high",
        silent=getattr(args, "silent", False),
    )

    # Claude-event emit: queue-wedged. Main loop dashboard / status banner
    # picks this up and surfaces the wedge prominently. Includes
    # queue_id + reason so consumers can format their own banner without
    # round-tripping queue.json.
    _claude_event_notify(
        tag="queue-wedged",
        message=(
            f"queue WEDGED: {target['id']} ({_item_summary(target)}) "
            f"-- reason: {raw_reason}"
        ),
        data={
            "queue_id": target["id"],
            "group_id": target.get("group_id"),
            "scope": target.get("scope", []),
            "summary": _item_summary(target),
            "wedged_reason": raw_reason,
            "wedged_at": target["wedged_at"],
        },
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    if args.json:
        print(json.dumps(updated, indent=2))
    else:
        print(
            f"wedged: {args.id} reason={raw_reason!r} "
            f"wedged_at={target['wedged_at']}"
        )


def cmd_queue_unwedge(args):
    """Flip a wedged queue item back to status=running.

    Used when the operator (or claude-watch's recovery path) sees the
    agent has recovered from the wedge -- e.g. after a self-clear, after
    Andrew manually pinged the agent and it resumed, or after the
    underlying API issue cleared.

    Behavior:
      * Item must exist and be in status=wedged. Any other status refuses.
      * Flips status=running. Refreshes `last_heartbeat_at` so the
        exporter doesn't immediately re-flag the item as stale.
      * Records `unwedged_at` (ISO timestamp). Preserves `wedged_at` /
        `wedged_reason` on the row for post-mortem -- they are the
        history, not current state.
      * Emits a `queue-unwedged` claude-event so dashboards can clear
        the wedge banner.
      * Pingme is opt-out via --silent (default fires; you want to
        confirm the recovery landed).
    """
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        status = target.get("status")
        if status != "wedged":
            print(
                f"unwedge refused: {args.id} status={status!r} (must be wedged)",
                file=sys.stderr,
            )
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)

        prior_reason = target.get("wedged_reason") or "(unspecified)"
        now = _fmt_ts()
        target["status"] = "running"
        target["unwedged_at"] = now
        # Bump heartbeat so the exporter doesn't immediately flag the
        # item as stale right after recovery.
        target["last_heartbeat_at"] = now
        # Intentionally preserve wedged_at + wedged_reason on the row --
        # they are now the audit trail, not current state.
        _recompute_group_heads(items)
        updated = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    log_completed(
        f"[queue {target['id']} UNWEDGED] {target.get('description','')}",
        extra={
            "source": "queue",
            "event": "unwedge",
            "id": target["id"],
            "group_id": target.get("group_id"),
            "prior_reason": prior_reason,
        },
    )

    _pingme_notify(
        title=f"queue unwedged: {target['id']}",
        message=(
            f"{_item_summary(target)}\n"
            f"prior reason: {prior_reason} | "
            f"scope: {','.join(target.get('scope', []))}"
        ),
        priority="low",
        silent=getattr(args, "silent", False),
    )

    _claude_event_notify(
        tag="queue-unwedged",
        message=f"queue unwedged: {target['id']} ({_item_summary(target)})",
        data={
            "queue_id": target["id"],
            "group_id": target.get("group_id"),
            "scope": target.get("scope", []),
            "summary": _item_summary(target),
            "prior_reason": prior_reason,
            "unwedged_at": now,
        },
        priority="low",
        silent=getattr(args, "silent", False),
    )

    if args.json:
        print(json.dumps(updated, indent=2))
    else:
        print(
            f"unwedged: {args.id} prior_reason={prior_reason!r} "
            f"unwedged_at={now}"
        )


def cmd_queue_block(args):
    """Flip a running queue item to status=blocked with a reason.

    Blocked is a "parked on external blocker" state. The agent has done
    all the work it can autonomously and is waiting on something the
    queue/agent system cannot resolve: a human greenlight, a third-party
    API window, a branch-protection toggle, etc.

    Distinct from `wedged`:
      * `wedged`  -- the system can't progress (stuck agent, context
                     limit, prolonged thinking). Implies action.
      * `blocked` -- the system did its part; an EXTERNAL party needs to
                     do something. No live agent expected.

    Distinct from `running`:
      * `running` -- agent actively working, expected to have a live
                     transcript. The WorkQueueOrphaned alert fires when
                     a running item has no live owner.
      * `blocked` -- no live agent expected by design. Exporter labels
                     this state separately so orphan-detection skips it.

    Accepts BOTH pending and running as the pre-state:
      * pending -> blocked -- a freshly-added item that is already parked
                     on an external blocker. Common enough that forcing a
                     register (-> running) -> block two-step is pure
                     ceremony (register would briefly acquire the scope
                     lock only for block to release it again). A pending
                     item never held the lock, so nothing to release.
      * running -> blocked -- an agent that did its autonomous work and is
                     now parked; releases the scope lock it held.

    Recovery:
      * `queue unblock <id>` -- blocked -> running (blocker cleared)
      * `queue done <id>`    -- blocked -> done (work was actually
                                complete, just needed acknowledgement)
      * `queue abandon <id>` -- blocked -> abandoned (operator gives up)

    Behavior:
      * Item must exist and be in status=pending OR status=running. Any
        other status (wedged, blocked, done, abandoned) refuses. Pick a
        coherent state machine: pending/running -> blocked is supported;
        wedged must first `unwedge` (back to running) before blocking.
      * `--reason TEXT` is REQUIRED -- a block without a reason defeats
        the operator-attention purpose. Common reasons:
          - "awaiting human greenlight"
          - "awaiting branch-protection toggle"
          - "third-party API rate-limited until $WHEN"
          - "awaiting hardware install"
      * Stamps `blocked_at` (ISO timestamp), `block_reason`. Preserves
        `started_at`, `last_heartbeat_at`, `pid` for post-mortem.
      * Emits a `queue-blocked` claude-event so dashboards / banners can
        surface the block prominently.
      * Pingme notification fires by default; --silent suppresses it.
    """
    raw_reason = (args.reason or "").strip()
    if not raw_reason:
        print(
            "ERROR: --reason is required for block "
            "(common values: 'awaiting human greenlight', "
            "'awaiting branch-protection toggle', "
            "'third-party API rate-limited').",
            file=sys.stderr,
        )
        sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        status = target.get("status")
        if status not in ("pending", "running"):
            print(
                f"block refused: {args.id} status={status!r} "
                f"(must be pending or running)",
                file=sys.stderr,
            )
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)

        target["status"] = "blocked"
        target["blocked_at"] = _fmt_ts()
        target["block_reason"] = raw_reason
        # Blocked RELEASES the scope lock: it no longer serializes, is no
        # longer head-eligible, and must not bridge scopes. _recompute_groups
        # (invoked by _recompute_group_heads) re-splits any component this
        # item was bridging and clears its head flag. A pending item never
        # acquired the lock (register does that), so this is a no-op for it;
        # a running item's lock is released here -- either way unblock
        # re-acquires the scope exactly like a fresh register.
        _recompute_group_heads(items)
        updated = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    log_completed(
        f"[queue {target['id']} BLOCKED] {target.get('description','')} "
        f"(reason: {raw_reason})",
        extra={
            "source": "queue",
            "event": "block",
            "id": target["id"],
            "group_id": target.get("group_id"),
            "reason": raw_reason,
        },
    )

    # Pingme: block IS an attention-required event (an external party
    # needs to do something). Normal priority -- distinct from a wedge
    # which is "system broken, fix me NOW".
    _pingme_notify(
        title=f"queue BLOCKED: {target['id']}",
        message=(
            f"{_item_summary(target)}\n"
            f"reason: {raw_reason} | "
            f"scope: {','.join(target.get('scope', []))}"
        ),
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    # Claude-event emit: queue-blocked. Dashboards / status banner can
    # surface the block; the main loop can route the event to the
    # appropriate "ping the operator" handler.
    _claude_event_notify(
        tag="queue-blocked",
        message=(
            f"queue BLOCKED: {target['id']} ({_item_summary(target)}) "
            f"-- reason: {raw_reason}"
        ),
        data={
            "queue_id": target["id"],
            "group_id": target.get("group_id"),
            "scope": target.get("scope", []),
            "summary": _item_summary(target),
            "block_reason": raw_reason,
            "blocked_at": target["blocked_at"],
        },
        priority="normal",
        silent=getattr(args, "silent", False),
    )

    if args.json:
        print(json.dumps(updated, indent=2))
    else:
        print(
            f"blocked: {args.id} reason={raw_reason!r} "
            f"blocked_at={target['blocked_at']}"
        )


def cmd_queue_unblock(args):
    """Flip a blocked queue item back to status=running.

    Used when the external blocker clears -- Andrew greenlit, the
    branch-protection toggle landed, the third-party API window opened,
    etc. The agent (or a fresh agent registered against this id) can
    resume work.

    Behavior:
      * Item must exist and be in status=blocked. Any other status
        refuses.
      * RE-ACQUIRES the scope lock. While blocked the item held no scope,
        so a peer may have started running in an overlapping scope. Returning
        to running would double-occupy that scope, so unblock REFUSES (exit
        3) if any other running/wedged item now overlaps this item's scope --
        the operator must let that work finish (or abandon this item) first,
        exactly like a fresh `register` serializes. `--force` overrides.
      * Flips status=running. Refreshes `last_heartbeat_at` so the
        exporter doesn't immediately re-flag the item as stale.
      * Records `unblocked_at` (ISO timestamp). Preserves `blocked_at` /
        `block_reason` on the row for post-mortem -- they are now the
        audit trail, not current state.
      * Emits a `queue-unblocked` claude-event so dashboards can clear
        the block banner.
      * Pingme is opt-out via --silent (default fires; you want to
        confirm the recovery landed).
    """
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        status = target.get("status")
        if status != "blocked":
            print(
                f"unblock refused: {args.id} status={status!r} (must be blocked)",
                file=sys.stderr,
            )
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)

        # Re-acquire the scope lock: refuse if another running/wedged item
        # now holds an overlapping scope (a peer may have spawned while this
        # item was blocked and holding nothing). Mirrors register's
        # serialization guarantee. `--force` overrides.
        if not getattr(args, "force", False):
            reacquire_conflicts = _running_scope_conflicts(
                items, target.get("scope", []), exclude_id=target.get("id"),
            )
            if reacquire_conflicts:
                fcntl.flock(fh, fcntl.LOCK_UN)
                fh.close()
                ids = ", ".join(
                    f"{c['id']}({c.get('group_id')})" for c in reacquire_conflicts
                )
                print(
                    f"unblock refused: {args.id} cannot re-acquire its scope "
                    f"-- {len(reacquire_conflicts)} running/wedged item(s) now "
                    f"hold an overlapping scope: {ids}. Let that work finish "
                    f"(or `queue abandon {args.id}`) first, or pass --force if "
                    f"concurrent execution is safe.",
                    file=sys.stderr,
                )
                sys.exit(3)

        prior_reason = target.get("block_reason") or "(unspecified)"
        now = _fmt_ts()
        target["status"] = "running"
        target["unblocked_at"] = now
        target["last_heartbeat_at"] = now
        # Intentionally preserve blocked_at + block_reason on the row --
        # they are now the audit trail, not current state.
        _recompute_group_heads(items)
        updated = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    log_completed(
        f"[queue {target['id']} UNBLOCKED] {target.get('description','')}",
        extra={
            "source": "queue",
            "event": "unblock",
            "id": target["id"],
            "group_id": target.get("group_id"),
            "prior_reason": prior_reason,
        },
    )

    _pingme_notify(
        title=f"queue unblocked: {target['id']}",
        message=(
            f"{_item_summary(target)}\n"
            f"prior reason: {prior_reason} | "
            f"scope: {','.join(target.get('scope', []))}"
        ),
        priority="low",
        silent=getattr(args, "silent", False),
    )

    _claude_event_notify(
        tag="queue-unblocked",
        message=f"queue unblocked: {target['id']} ({_item_summary(target)})",
        data={
            "queue_id": target["id"],
            "group_id": target.get("group_id"),
            "scope": target.get("scope", []),
            "summary": _item_summary(target),
            "prior_reason": prior_reason,
            "unblocked_at": now,
        },
        priority="low",
        silent=getattr(args, "silent", False),
    )

    if args.json:
        print(json.dumps(updated, indent=2))
    else:
        print(
            f"unblocked: {args.id} prior_reason={prior_reason!r} "
            f"unblocked_at={now}"
        )


def cmd_queue_update_scope(args):
    """Add (or remove) scope tokens on an existing queue item, idempotently.

    Primary motivation: `workload run LABEL -- CMD` needs to inject the
    `workload:LABEL` scope token onto the queue item that the caller has
    pre-registered (and whose qid was passed via `--queue-id`). Without
    that token, the work-queue-exporter has no way to map the queue
    item to its heartbeat file under `/run/claude/workloads/`, so
    `worktask_queue_progress_age_seconds` never gets emitted and the
    `WorkQueueStuck` / `WorkQueueStuckSoft` alerts false-fire on healthy
    long-running workloads (q-2026-05-20-13b9 was the trigger — a
    `resource:` scoped queue item bound to a workload via --queue-id
    never gained its `workload:` token).

    Semantics:
      * Tokens are passed as positional args; multiple tokens add/remove
        in one atomic write.
      * Default mode = add. `--remove` removes the listed tokens.
      * Add is idempotent: tokens already on the item are silently
        skipped (no duplicate, no error).
      * Remove is idempotent: tokens not on the item are silently
        skipped (no error).
      * The item's existing scope is preserved — this is a delta op,
        not a replace.
      * No `workload:` HARD-DENY check (unlike `queue add`). The whole
        point of this subcommand is the inverse — to LET the workload
        runner inject its own scope token onto a pre-registered item.

    Exit codes:
      * 0 — write succeeded (or no-op because all tokens were already
        present / already absent).
      * 1 — item not found, or no tokens supplied.

    See feedback note on q-2026-05-20-7482 for the systemic context.
    """
    raw_tokens = list(args.tokens or [])
    # Allow comma-joined forms for symmetry with `queue add --scope a,b`.
    expanded = []
    seen = set()
    for raw in raw_tokens:
        for piece in raw.split(","):
            piece = piece.strip()
            if not piece:
                continue
            if piece in seen:
                continue
            seen.add(piece)
            expanded.append(piece)
    if not expanded:
        print("ERROR: at least one token required", file=sys.stderr)
        sys.exit(1)
    try:
        tokens = [_normalize_token(t) for t in expanded]
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    # Validate `repo:<name>` tokens against the configured repos dir when
    # ADDING scope (not when removing -- you must be able to strip a stale
    # invalid token). Same fail-open / bypass semantics as `queue add`.
    if not getattr(args, "remove", False):
        try:
            _validate_repo_scope_tokens(tokens)
        except ValueError as e:
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        existing = list(target.get("scope") or [])
        existing_set = set(existing)
        added = []
        removed = []
        if args.remove:
            new_scope = [t for t in existing if t not in set(tokens)]
            removed = [t for t in tokens if t in existing_set]
        else:
            new_scope = list(existing)
            for t in tokens:
                if t in existing_set:
                    continue
                new_scope.append(t)
                existing_set.add(t)
                added.append(t)
        if new_scope != existing:
            target["scope"] = new_scope
            target["scope_updated_at"] = _fmt_ts()
            _queue_write_and_unlock(fh, data)
        else:
            # No-op: release the lock without rewriting the file.
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    if args.json:
        print(json.dumps({
            "id": args.id,
            "scope": new_scope,
            "added": added,
            "removed": removed,
        }, indent=2))
        return
    if args.remove:
        if removed:
            print(f"removed from {args.id}: {','.join(removed)}")
        else:
            print(f"no-op: tokens not present on {args.id}")
    else:
        if added:
            print(f"added to {args.id}: {','.join(added)}")
        else:
            print(f"no-op: tokens already present on {args.id}")


