# --- hostjob reconciliation ------------------------------------------------
# The `hostjob` detached runner (examples/compose/bin/hostjob) creates a
# first-class queue row (scope `hostjob:<label>`, created-by `hostjob`) and,
# on worker exit, its reaper flips that row done/abandon + emits a
# `hostjob-done` claude-event. That flip is FAIL-SOFT: if `session-task` isn't
# on the reaper's PATH, errors, or times out — or if a later `hostjob clean`
# removes the terminal state dir before the flip lands — the row leaks stuck
# `running` forever. The q-site minisite already compensates by reconciling at
# RENDER time against the runner's authoritative `<HOSTJOB_LOG_DIR>/<label>/
# status.json`; the CLI did NOT, so `queue list` showed the raw (stale) truth
# while the web view looked clean — the exact web/CLI divergence Andrew hit
# (botchat #2029, earlier #1527). We close the gap by reconciling the SHARED
# store (queue.json) so BOTH views agree and the leak self-heals. See
# `_reconcile_hostjob_rows`.
#
# HOSTJOB_LOG_DIR mirrors the runner's STATE_ROOT (default ~/.cache/hostjob);
# overridable so the minisite / tests can point elsewhere.
HOSTJOB_LOG_DIR = Path(
    os.environ.get(
        "HOSTJOB_LOG_DIR",
        str(Path.home() / ".cache" / "hostjob"),
    )
)
# A hostjob queue row registers a beat BEFORE the runner writes status.json,
# so an absent state dir within this window means "just launched", not
# "finished-and-cleaned". Beyond it, an absent dir => the job reached a
# terminal state and was cleaned (clean REFUSES to remove a running job).
# Mirrors the minisite's STARTING_WINDOW_SECONDS default (60s).
HOSTJOB_STARTING_WINDOW_SECONDS = float(
    os.environ.get("HOSTJOB_STARTING_WINDOW_SECONDS", "60")
)

# Queue item lifecycle states:
#   pending    -- created but not yet claimed by a running agent
#   running    -- claimed (via `register`) and actively being worked
#   wedged     -- was running but the owning agent is stuck (context-limit /
#                 prolonged-thinking / heartbeat-stale). Still owns its scope
#                 (peers cannot spawn into the same scope) but is flagged
#                 distinctly in CLI/exporter/UI so the operator can see the
#                 wedge without scrolling logs. Set via `queue wedge <id>
#                 --reason ...`. Cleared via `queue unwedge <id>` (back to
#                 running) or `queue abandon <id>` (operator gives up).
#   blocked    -- the agent has done all the work it can autonomously and is
#                 waiting on an EXTERNAL blocker (human greenlight,
#                 third-party API, branch-protection toggle, etc.). NOT the
#                 same as wedged (which is for items the system can't progress
#                 through code/state-machine issues). Still owns its scope
#                 so peers can't grab it. Distinguished from running in the
#                 exporter so the WorkQueueOrphaned alert (which fires on
#                 "running without live agent") does NOT fire on blocked
#                 items -- by design, blocked items have no live agent.
#                 Set via `queue block <id> --reason ...`. Cleared via
#                 `queue unblock <id>` (back to running), `queue done <id>`
#                 (work was actually complete) or `queue abandon <id>`.
#   quarantined -- `queue abandon` was called on an item that OWNED ITS
#                 SCOPE (running/wedged) without positive evidence that the
#                 owning process is gone. NOT terminal, and it KEEPS the
#                 scope lock. See the "Quarantine" block below for the full
#                 rationale. Cleared via `queue done <id>` (the agent came
#                 back and finished — the strongest possible proof it was
#                 alive), `queue release <id>` (operator asserts it's gone)
#                 or `queue resurrect <id>` (respawn a replacement).
#   done       -- terminal: completed successfully
#   abandoned  -- terminal: gave up (with optional reason)
#
# --------------------------------------------------------------------------
# Quarantine: why `abandon` on a live-scope item is NOT terminal
# --------------------------------------------------------------------------
#
# `queue abandon` used to free the scope immediately. The caller decides to
# abandon on an INFERENCE about liveness — "no output file", "stale mtime",
# "no child process", "it's been quiet too long" — none of which observe the
# process exiting. Silence is not death.
#
# Incident: an agent was declared dead and abandoned. It was in fact still
# running and worked for another ~48 minutes. Because abandon freed the
# scope, a replacement was spawned for the same work; both agents finished
# and both wrote. Most of the outputs happened to dedupe on an exact-match
# key, but one pair disagreed on that key and a user-visible duplicate
# escaped. The scope lock existed precisely to prevent that, and an
# inference dissolved it.
#
# So: an abandon of a scope-owning item moves it to `quarantined`, which
# still holds the scope (it is in RUNNING_STATUSES and SERIALIZING_STATUSES)
# but is rendered distinctly everywhere so a human can tell "presumed dead"
# from "known alive". Three ways out, in descending order of evidential
# strength:
#
#   1. `queue done <id>` -- the agent itself reported completion. This is
#      proof it was alive, and it is exactly the case the incident missed.
#   2. `queue resurrect <id>` -- the operator wants a replacement. Resurrect
#      abandons the old row (terminal) and creates a new one carrying the
#      same scope, so the respawn path for a genuinely-dead agent needs no
#      extra step and no manual unwedging.
#   3. `queue release <id>` -- an explicit operator assertion that the
#      process is gone. Terminal `abandoned`.
#
# `queue abandon --confirmed-dead` skips quarantine outright, for callers
# that hold POSITIVE evidence of exit rather than an inference. The workload
# reaper is the canonical one: it reads the wrapped command's exit code, so
# it knows the process terminated. Do NOT pass it because an agent "looks"
# dead.
#
# Both `release` and `--confirmed-dead` consult claude-watch's active-agents
# state, but only in the direction that is sound: a LIVE agent record
# REFUSES the release (positive evidence of life). The ABSENCE of a record
# authorizes nothing — that absence is the same weak inference that caused
# the incident. `--force` overrides the refusal for an operator who knows
# better than the state file.
#
# Deliberately NOT implemented: a quarantine auto-expiry timer. A timer is
# another inference that the agent is dead, and inference is the bug — a TTL
# that fires while the agent is alive reproduces the incident exactly, just
# later. The unwedge story does not need one: `resurrect` is the same
# command the respawn path already uses, and `release` is one line. Both are
# printed on the abandon output and in `queue list`.
#
# Three distinct status sets, each scoping a DIFFERENT question. Conflating
# them is the historical source of the "blocked item holds its scope" class
# of bugs (#371 fixed RUNNING_STATUSES but left ACTIVE_STATUSES wrong; the
# group-formation / connectivity sense was still bridging through blocked
# items -- see SERIALIZING_STATUSES below).
#
#   RUNNING_STATUSES = items that OWN A SLOT (a peer cannot spawn into the
#   same scope while one of these is live). `running` + `wedged` +
#   `quarantined`: a wedge is transient and the agent still holds the scope;
#   a quarantined item MIGHT still hold it (that is the entire point — we do
#   not know, so we do not release). `blocked` is EXCLUDED --
#   `queue block` RELEASES the scope lock (blocked items are exempt from the
#   orphaned-running alert), so a blocked item must not own a slot.
#
#   SERIALIZING_STATUSES = items that PARTICIPATE IN SCOPE SERIALIZATION:
#   they form groups (connected components over overlapping scope) and gate
#   readiness. `pending` + `running` + `wedged` + `quarantined`. `blocked` is EXCLUDED here
#   too -- a blocked item must NOT connect (bridge) otherwise-independent
#   scopes into one serialization group, and must NOT make a same-group peer
#   not-ready. This is the set that group formation (`_group_ids_overlapping`,
#   `_recompute_groups`) and head selection (`_group_head`) consult, matching
#   the proven-correct web UI `_compute_ready_now` (which gates on
#   ("pending","running") membership only). A blocked item acts like a
#   done/abandoned item for serialization: parked, holding nothing.
#
#   ACTIVE_STATUSES = the "in-flight, non-terminal" set used for OPERATOR
#   VISIBILITY (`queue list` / `queue groups` default views) and the
#   "can still edit deps" gate (`queue depend`). `blocked` IS included here
#   -- a parked item is still something the operator wants to see and can
#   still be unblocked / re-deped. Visibility != scope-holding.
ACTIVE_STATUSES = ("pending", "running", "wedged", "blocked", "quarantined")
SERIALIZING_STATUSES = ("pending", "running", "wedged", "quarantined")
RUNNING_STATUSES = ("running", "wedged", "quarantined")

# Terminal (non-recoverable) statuses. `quarantined` is deliberately NOT
# here: it is a holding state, not an outcome.
TERMINAL_STATUSES = ("done", "abandoned")

