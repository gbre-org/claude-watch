# ---------------------------------------------------------------------------
# Layer 1: resume-action.json (single "top-of-mind" slot)
# ---------------------------------------------------------------------------


def load():
    """Load current resume action, or None."""
    if not TASK_FILE.exists():
        return None
    try:
        data = json.loads(TASK_FILE.read_text())
        if not data:
            return None
        return data
    except (json.JSONDecodeError, OSError):
        return None


def save(data):
    """Save resume action."""
    TASK_FILE.parent.mkdir(parents=True, exist_ok=True)
    TASK_FILE.write_text(json.dumps(data, indent=2) + "\n")


def cmd_set(args):
    data = {
        "task": args.description,
        "created_at": datetime.now(timezone.utc).isoformat(),
    }
    if args.context:
        try:
            data["context"] = json.loads(args.context)
        except json.JSONDecodeError:
            print(f"ERROR: --context must be valid JSON: {args.context}", file=sys.stderr)
            sys.exit(1)
    save(data)
    print(f"Resume action set: {args.description}")


def cmd_append(args):
    current = load()
    if not current:
        print("No current resume action. Use 'set' first.", file=sys.stderr)
        sys.exit(1)
    current["task"] += "\n" + args.text
    current["updated_at"] = datetime.now(timezone.utc).isoformat()
    save(current)
    print("Appended to resume action.")


def cmd_get(args):
    current = load()
    if not current:
        sys.exit(1)  # silent for scripting
    print(json.dumps(current, indent=2))


def cmd_show(args):
    current = load()
    if not current:
        print("No pending resume action.")
        return
    print("=" * 60)
    print("PENDING RESUME ACTION")
    print("=" * 60)
    print(f"Task: {current['task']}")
    if current.get("context"):
        print(f"Context: {json.dumps(current['context'], indent=2)}")
    print(f"Set at: {current['created_at']}")
    if current.get("updated_at"):
        print(f"Updated: {current['updated_at']}")
    print("=" * 60)


def log_completed(description, extra=None):
    COMPLETED_FILE.parent.mkdir(parents=True, exist_ok=True)
    entry = {
        "task": description,
        "completed_at": datetime.now(timezone.utc).isoformat(),
    }
    if extra:
        entry.update(extra)
    with open(COMPLETED_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")


def cmd_complete(args):
    log_completed(args.description)
    print(f"Logged completed task: {args.description}")


def _classify_entry(entry):
    """Return ('resume' | 'queue-done' | 'queue-abandoned' | 'queue-merge' | 'other', tag_str).

    Uses structured fields (source, event) when present, and falls back to
    parsing the task-string prefix for legacy rows written before the queue
    layer was added.
    """
    source = entry.get("source")
    event = entry.get("event")
    task = entry.get("task", "") or ""
    if source == "queue":
        if event == "merge":
            qid = entry.get("new_group_id") or entry.get("group_id") or "?"
            return "queue-merge", f"[queue MERGE {qid}]"
        if event == "abandon" or "abandoned" in task[:40]:
            qid = entry.get("id") or "?"
            gid = entry.get("group_id") or "?"
            return "queue-abandoned", f"[queue {qid} {gid} ABANDONED]"
        qid = entry.get("id") or "?"
        gid = entry.get("group_id") or "?"
        return "queue-done", f"[queue {qid} {gid}]"
    # Legacy: inspect task prefix
    if task.startswith("[queue "):
        # Best-effort: pull id if present (format: "[queue q-YYYY-MM-DD-xxxx] ...")
        m = re.match(r"^\[queue (q-\S+?)(?:\s+abandoned)?\]", task)
        if m and "abandoned" in task[: 60]:
            return "queue-abandoned", f"[queue {m.group(1)} ABANDONED]"
        if m:
            return "queue-done", f"[queue {m.group(1)}]"
        return "queue-done", "[queue]"
    if task.startswith("[resume action]"):
        return "resume", "[resume-action]"
    return "other", "[other]"


def _entry_display_task(entry, kind):
    """Strip the layer-prefix from the task string (we render our own tag)."""
    task = entry.get("task", "?") or "?"
    for prefix in ("[resume action] ", "[resume action]"):
        if task.startswith(prefix):
            return task[len(prefix):]
    m = re.match(r"^\[queue [^\]]+\]\s*", task)
    if m:
        return task[m.end():]
    return task


def _entry_timestamp(entry):
    """Return the most authoritative timestamp for an entry as a datetime, or None."""
    ts_str = entry.get("completed_at") or entry.get("abandoned_at") or entry.get("created_at")
    if not ts_str:
        return None
    try:
        return datetime.fromisoformat(ts_str)
    except ValueError:
        return None


def _load_queue_items_silent():
    """Load queue.json items without taking a write lock, for scope lookup.

    Returns dict id -> item, or empty dict on any failure.
    """
    try:
        if not QUEUE_FILE.exists():
            return {}
        raw = QUEUE_FILE.read_text()
        if not raw.strip():
            return {}
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            # Best-effort: salvage the leading valid document (recovers items
            # written before a trailing concurrent-write fragment).
            data = _salvage_leading_json(raw)
            if data is None:
                return {}
        out = {}
        for it in data.get("items", []):
            if isinstance(it, dict) and "id" in it:
                out[it["id"]] = it
        return out
    except OSError:
        return {}


def _scope_for_queue_entry(entry, queue_items):
    """Best-effort scope lookup for a queue history entry.

    Uses the queue.json file if the item is still present, else returns None.
    """
    qid = entry.get("id")
    if not qid:
        return None
    it = queue_items.get(qid)
    if not it:
        return None
    return it.get("scope") or None


def _render_history_entries(entries, include_scope=True, width_total=None):
    """Pretty-print a list of entries with source tags. Returns list of lines."""
    if not entries:
        return ["(no entries)"]
    queue_items = _load_queue_items_silent() if include_scope else {}
    lines = []
    for entry in entries:
        try:
            kind, tag = _classify_entry(entry)
        except Exception:
            lines.append("  (corrupt entry)")
            continue
        ts = entry.get("completed_at") or entry.get("abandoned_at") or "?"
        if "T" in ts:
            ts = ts.split("T")[0] + " " + ts.split("T")[1][:8]
        desc = _entry_display_task(entry, kind)
        # Truncate description for one-line display
        if len(desc) > 140:
            desc = desc[:137] + "..."
        lines.append(f"  [{ts}] {tag} {desc}")
        if include_scope and kind.startswith("queue") and kind != "queue-merge":
            scope = _scope_for_queue_entry(entry, queue_items)
            if scope:
                scope_str = ",".join(scope)
                if len(scope_str) > 80:
                    scope_str = scope_str[:77] + "..."
                lines.append(f"        scope: {scope_str}")
    return lines


def _filter_entries(entries, since=None, layer=None):
    """Filter a list of parsed history entries by time window and/or layer."""
    cutoff = None
    if since:
        cutoff = datetime.now(timezone.utc) - _parse_duration(since)
    out = []
    for entry in entries:
        if cutoff is not None:
            ts = _entry_timestamp(entry)
            if ts is None or ts < cutoff:
                continue
        if layer and layer != "all":
            kind, _ = _classify_entry(entry)
            if layer == "resume" and kind != "resume":
                continue
            if layer == "queue" and not kind.startswith("queue"):
                continue
        out.append(entry)
    return out


def _load_all_history_entries():
    """Load and parse completed-tasks.jsonl. Returns list of dicts (oldest first)."""
    if not COMPLETED_FILE.exists():
        return []
    out = []
    for line in COMPLETED_FILE.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            out.append({"_corrupt": True, "task": "(corrupt)"})
    return out


def cmd_history(args):
    n = args.count
    entries = _load_all_history_entries()
    if not entries:
        print("No completed tasks.")
        return

    # Apply --since / --layer filters BEFORE tail limit
    entries = _filter_entries(entries, since=getattr(args, "since", None),
                              layer=getattr(args, "layer", None))
    if not entries:
        print("No completed tasks (after filters).")
        return

    # Tail last N
    recent = entries[-n:] if len(entries) > n else entries

    # Header describes what filters were in effect so the user knows what
    # they're looking at.
    filter_bits = []
    if getattr(args, "since", None):
        filter_bits.append(f"since={args.since}")
    if getattr(args, "layer", None) and args.layer != "all":
        filter_bits.append(f"layer={args.layer}")
    filter_suffix = f" ({', '.join(filter_bits)})" if filter_bits else ""

    print(f"Last {len(recent)} completed tasks{filter_suffix}:")
    include_scope = not getattr(args, "no_scope", False)
    for line in _render_history_entries(recent, include_scope=include_scope):
        print(line)


def cmd_clear(args):
    if TASK_FILE.exists():
        current = load()
        if current:
            log_completed(f"[resume action] {current['task'][:200]}")
        TASK_FILE.unlink()
        print("Resume action cleared and logged as completed.")
    else:
        print("No resume action to clear.")


def for_session_resume():
    current = load()
    if not current:
        return ""
    lines = [
        "",
        "!" * 60,
        "!! RESUME ACTION — DO THIS IMMEDIATELY AFTER WATCHERS ARE UP",
        "!" * 60,
        "",
        f"Task: {current['task']}",
    ]
    if current.get("context"):
        lines.append(f"Context: {json.dumps(current['context'])}")
    lines.append(f"(set at {current['created_at']})")
    lines.append("")
    lines.append("After completing this, run: session-task clear")
    lines.append("!" * 60)
    lines.append("")
    return "\n".join(lines)


def for_session_resume_history(n_resume=5, n_queue=5, since="7d"):
    """Task-history block for session-resume, split into two panels.

    - Resume-action completions (the narrative thread)  : last n_resume in window
    - Queue completions (what finished since last review): last n_queue in window

    Everything older than `since` is excluded. This prevents a flurry of
    queue sweeps from drowning out the last few resume-action narratives.
    """
    entries = _load_all_history_entries()
    if not entries:
        return "No completed tasks recorded yet."

    try:
        windowed = _filter_entries(entries, since=since, layer="all")
    except ValueError:
        windowed = entries

    resume_entries = [e for e in windowed if _classify_entry(e)[0] == "resume"]
    queue_entries = [e for e in windowed if _classify_entry(e)[0].startswith("queue")]

    resume_tail = resume_entries[-n_resume:]
    queue_tail = queue_entries[-n_queue:]

    parts = []
    parts.append(f"### Resume-action trail (last {len(resume_tail)} in {since})")
    if resume_tail:
        parts.extend(_render_history_entries(resume_tail, include_scope=False))
    else:
        parts.append("  (none)")
    parts.append("")
    parts.append(f"### Queue completions (last {len(queue_tail)} in {since})")
    if queue_tail:
        parts.extend(_render_history_entries(queue_tail, include_scope=True))
    else:
        parts.append("  (none)")

    return "\n".join(parts)


# ---------------------------------------------------------------------------
# Layer 2: queue.json (scope-based serialization groups)
# ---------------------------------------------------------------------------


def _queue_empty():
    return {
        "schema_version": QUEUE_SCHEMA_VERSION,
        "items": [],
        "locked_scopes": {},
    }


def _atomic_write_text(path, text):
    """Write `text` to `path` atomically: temp file on the same filesystem,
    fsync, then os.replace (an atomic rename). A reader -- or a racing writer
    in a filesystem domain where our advisory flock is NOT honored, e.g. across
    a macOS/Docker bind-mount -- can never observe a half-written or byte-
    interleaved file; it sees either the complete old contents or the complete
    new contents. This is the core fix for the 2026-08-16 queue.json corruption.
    """
    path = Path(path)
    fd, tmp = tempfile.mkstemp(
        prefix=path.name + ".", suffix=".tmp", dir=str(path.parent)
    )
    try:
        with os.fdopen(fd, "w") as tf:
            tf.write(text)
            tf.flush()
            os.fsync(tf.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _salvage_leading_json(raw):
    """Return the leading valid JSON object in `raw` (ignoring any trailing
    bytes), or None. Recovers the common concurrent-write corruption where a
    complete document is followed by an orphaned tail from another writer."""
    try:
        obj, _end = json.JSONDecoder().raw_decode(raw.lstrip())
    except (json.JSONDecodeError, ValueError):
        return None
    if isinstance(obj, dict) and isinstance(obj.get("items"), list):
        return obj
    return None


def _quarantine_corrupt(raw):
    """Preserve corrupt bytes to a timestamped queue.json.corrupt.<ts> file
    (timestamped so repeated corruptions don't clobber each other). Returns the
    path written, or None on failure."""
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    dest = QUEUE_FILE.parent / f"queue.json.corrupt.{ts}"
    try:
        dest.write_text(raw)
        return dest
    except OSError:
        try:
            fallback = QUEUE_FILE.with_suffix(".json.corrupt")
            fallback.write_text(raw)
            return fallback
        except OSError:
            return None


def _read_bak():
    """Return the last-good queue dict from the .bak snapshot, or None."""
    try:
        if not QUEUE_BAK_FILE.exists():
            return None
        obj = json.loads(QUEUE_BAK_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if isinstance(obj, dict) and isinstance(obj.get("items"), list):
        return obj
    return None


def _read_queue_with_recovery():
    """Read + parse queue.json with layered corruption recovery. Never raises.

    Returns (data_dict, recovery_info). recovery_info is None on a clean parse;
    otherwise a dict describing the fallback taken so the caller can alert
    LOUDLY. Recovery order on unparseable JSON:
      1. salvage the leading valid document from the corrupt bytes (recovers
         items written before a trailing concurrent-write fragment),
      2. fall back to the last-good .bak snapshot,
      3. reset to empty (last resort -- in-flight state lost).
    The corrupt bytes are always quarantined first.
    """
    if not QUEUE_FILE.exists():
        return _queue_empty(), None
    try:
        raw = QUEUE_FILE.read_text()
    except OSError as exc:
        return _queue_empty(), {
            "mode": "empty", "reason": f"unreadable: {exc}",
            "recovered_items": 0, "quarantine": None, "corrupt_bytes": 0,
        }
    if not raw.strip():
        return _queue_empty(), None
    try:
        return json.loads(raw), None
    except json.JSONDecodeError as exc:
        reason = str(exc)
    quarantine = _quarantine_corrupt(raw)
    q = str(quarantine) if quarantine else None
    salvaged = _salvage_leading_json(raw)
    if salvaged is not None:
        return salvaged, {
            "mode": "salvage-leading", "reason": reason,
            "recovered_items": len(salvaged.get("items", [])),
            "quarantine": q, "corrupt_bytes": len(raw),
        }
    bak = _read_bak()
    if bak is not None:
        return bak, {
            "mode": "bak", "reason": reason,
            "recovered_items": len(bak.get("items", [])),
            "quarantine": q, "corrupt_bytes": len(raw),
        }
    return _queue_empty(), {
        "mode": "empty", "reason": reason, "recovered_items": 0,
        "quarantine": q, "corrupt_bytes": len(raw),
    }


def _alert_queue_recovery(info):
    """Emit a LOUD alert (stderr + urgent/high claude-event) whenever queue.json
    corruption triggered a recovery/reset. NEVER silent -- the 2026-08-16
    incident silently reset the queue to empty, losing all in-flight items."""
    mode = info.get("mode")
    n = info.get("recovered_items", 0)
    q = info.get("quarantine") or "(not preserved)"
    if mode == "empty":
        tag = "queue-corrupt-reset-empty"
        priority = "urgent"
        msg = (f"queue.json CORRUPT and UNRECOVERABLE -- reset to EMPTY "
               f"(0 items recovered). IN-FLIGHT QUEUE STATE LOST. "
               f"Corrupt bytes quarantined at {q}.")
    elif mode == "bak":
        tag = "queue-corrupt-recovered-bak"
        priority = "high"
        msg = (f"queue.json CORRUPT -- recovered {n} item(s) from the last-good "
               f".bak snapshot. Corrupt bytes quarantined at {q}.")
    else:
        tag = "queue-corrupt-recovered-salvage"
        priority = "high"
        msg = (f"queue.json CORRUPT -- salvaged {n} item(s) from the leading "
               f"valid document (trailing fragment discarded). Corrupt bytes "
               f"quarantined at {q}.")
    print(f"[session-task] {msg}", file=sys.stderr)
    try:
        _claude_event_notify(tag, msg, {
            "recovered_items": n,
            "quarantine": info.get("quarantine") or "",
            "corrupt_bytes": info.get("corrupt_bytes", 0),
            "reason": info.get("reason", ""),
        }, priority=priority)
    except Exception:  # noqa: BLE001 -- alerting must never break the queue op
        pass


def _queue_open_locked(mode):
    """Acquire the queue write lock and read queue.json with corruption recovery.

    Returns (lock_handle, data). The lock is fcntl.flock(LOCK_EX) held on a
    DEDICATED, never-renamed lock file (queue.json.lock) -- decoupled from the
    data file so queue.json can be rewritten atomically (temp + os.replace)
    without the rename invalidating an in-progress writer's lock (which would
    reintroduce lost updates among same-domain writers). Caller MUST release via
    _queue_write_and_unlock (writes + unlocks) or _queue_unlock_readonly
    (unlocks only). `mode` is informational -- we always take LOCK_EX.
    """
    QUEUE_FILE.parent.mkdir(parents=True, exist_ok=True)
    lock_fd = os.open(str(QUEUE_LOCK_FILE), os.O_RDWR | os.O_CREAT, 0o600)
    lock_fh = os.fdopen(lock_fd, "r+")
    fcntl.flock(lock_fh, fcntl.LOCK_EX)
    # Read under the lock so same-domain writers serialize.
    data, recovery = _read_queue_with_recovery()
    if recovery is not None:
        _alert_queue_recovery(recovery)
    # Normalize
    if not isinstance(data, dict) or "items" not in data:
        data = _queue_empty()
    data.setdefault("schema_version", QUEUE_SCHEMA_VERSION)
    data.setdefault("items", [])
    # locked_scopes is a dict: {<token>: {"reason": "...", "locked_at": "iso"}}
    # Persists in queue.json so it survives /clear and process restarts.
    locked = data.get("locked_scopes")
    if not isinstance(locked, dict):
        locked = {}
    # Defensive: drop any obviously-malformed entries.
    cleaned: dict[str, dict] = {}
    for k, v in locked.items():
        if not isinstance(k, str) or not k:
            continue
        if isinstance(v, dict):
            cleaned[k] = {
                "reason": str(v.get("reason") or ""),
                "locked_at": str(v.get("locked_at") or ""),
            }
        else:
            # Tolerate legacy bare-string entries.
            cleaned[k] = {"reason": str(v) if v else "", "locked_at": ""}
    data["locked_scopes"] = cleaned

    # Read-time migration (2026-05-08): legacy items carrying a `depends_on`
    # list are translated into `task:<id>` scope tokens. Both representations
    # are unioned in `_iter_dep_ids` so behavior is identical regardless of
    # which form a record is stored in -- but going forward we materialize
    # deps as scope tokens so locks, depends_on, and serialization scope all
    # speak the same language. The legacy field is preserved on read and
    # only stripped when the item is rewritten via `_queue_write_and_unlock`.
    for it in data.get("items", []):
        if not isinstance(it, dict):
            continue
        legacy = it.get("depends_on")
        if not legacy or not isinstance(legacy, list):
            continue
        scope = list(it.get("scope") or [])
        existing_targets = {
            _task_token_target(t) for t in scope if _is_task_token(t)
        }
        added = False
        for d in legacy:
            if not isinstance(d, str) or not d:
                continue
            if d in existing_targets:
                continue
            scope.append(f"task:{d}")
            existing_targets.add(d)
            added = True
        if added:
            it["scope"] = scope
        # Drop the legacy field once the migration runs -- we keep the same
        # info as scope tokens. The next write persists it.
        it.pop("depends_on", None)
    return lock_fh, data


def _queue_write_and_unlock(fh, data):
    """Atomically persist queue.json, snapshot to .bak, and release the lock.

    The temp+rename write guarantees a reader or racing (cross-domain) writer
    never observes a torn or byte-interleaved file -- the root cause of the
    3.9MB corruption. The .bak snapshot is the last-good full write, used as a
    recovery source by `_read_queue_with_recovery` if queue.json is later found
    corrupt. `fh` is the flock lock handle returned by `_queue_open_locked`.
    """
    data["schema_version"] = QUEUE_SCHEMA_VERSION
    text = json.dumps(data, indent=2) + "\n"
    _atomic_write_text(QUEUE_FILE, text)
    # Best-effort last-good snapshot; never fail the queue op on a .bak error.
    try:
        _atomic_write_text(QUEUE_BAK_FILE, text)
    except OSError as exc:
        print(f"[session-task] queue .bak snapshot failed: {exc}",
              file=sys.stderr)
    fcntl.flock(fh, fcntl.LOCK_UN)
    fh.close()


def _queue_unlock_readonly(fh):
    fcntl.flock(fh, fcntl.LOCK_UN)
    fh.close()


def _new_id():
    day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    return f"q-{day}-{secrets.token_hex(2)}"


def _new_group_id():
    return f"g-{secrets.token_hex(4)}"


# --- scope tokens --------------------------------------------------------

_TYPED_TOKEN_RE = re.compile(r"^(repo|resource|book|agent-proto):")
# `path:<repo>/<subdir>` scope tokens (added 2026-05-11 to fix
# over-serialization within large repos -- e.g. docker-gomorrah's
# monitoring/ vs queue-minisite/ subtrees both tagging `repo:docker-gomorrah`
# even though their files are disjoint). Semantics: a `path:` token is a
# finer-grained claim WITHIN a repo. The first segment is the repo name;
# everything after is a path within that repo.
#  - Two `path:X/...` tokens overlap iff one path is a prefix of the other
#    (segment-wise) -- siblings are disjoint.
#  - `repo:X` overlaps every `path:X/...` (the broad claim still wins).
#  - `path:X/...` and `path:Y/...` never overlap (different repo).
_PATH_TOKEN_PREFIX = "path:"
# `task:<queue-id>` scope tokens (added 2026-05-08 to unify --depends-on with
# scope). Semantics: an item carrying `task:<id>` in its scope is blocked
# until queue id <id> reaches a terminal state (done). The token is INERT
# for normal scope-conflict / scope-overlap purposes -- it does NOT
# serialize peers. Two items both carrying `task:q-A` are NOT in scope
# conflict; the readiness gate (in _item_is_ready) consults the queue to
# resolve the dep separately. This way `--depends-on q-A` is just
# parser-level sugar for `--scope task:q-A`, and `queue lock task:q-A`
# Just Works without a second code path.
_TASK_TOKEN_PREFIX = "task:"


def _is_task_token(tok):
    return isinstance(tok, str) and tok.startswith(_TASK_TOKEN_PREFIX)


def _task_token_target(tok):
    """Return the queue id referenced by a `task:<id>` token, or None."""
    if not _is_task_token(tok):
        return None
    return tok[len(_TASK_TOKEN_PREFIX):]


def _normalize_token(tok):
    """Normalize a single scope token.

    - Expand leading ~ in file: tokens.
    - Strip a trailing /** on file: tokens (it's redundant with prefix match,
      kept purely as readability sugar in prompts).
    - Leave '*' alone.
    - Typed tokens (repo:/resource:/book:/agent-proto:) are exact-match.
    - `path:<repo>/<subdir>` tokens (since 2026-05-11) normalize the suffix:
      collapse repeated slashes, strip leading/trailing slashes, and reject
      empty / repo-only forms (`path:X` must use `repo:X` instead). The
      stored form is always `path:<repo>/<a>/<b>/...` with single-slash
      separators and no trailing slash.
    - `task:<id>` tokens (since 2026-05-08) are exact-match and inert for
      scope-conflict purposes; their semantics live in _item_is_ready.
    """
    if not tok or not isinstance(tok, str):
        raise ValueError(f"Scope token must be non-empty string: {tok!r}")
    if tok == "*":
        return "*"
    if tok.startswith("file:"):
        path = tok[len("file:"):]
        # Strip trailing /** or ** (explicit recursive intent -- same semantic)
        if path.endswith("/**"):
            path = path[:-3]
        elif path.endswith("**"):
            path = path[:-2]
        # Expand ~
        if path.startswith("~"):
            path = os.path.expanduser(path)
        # Keep trailing slash intent: directories prefix-match like file:/foo/
        # matches file:/foo/bar. We do NOT force or strip trailing slash --
        # prefix match handles both file:/foo and file:/foo/.
        return f"file:{path}"
    if tok.startswith(_PATH_TOKEN_PREFIX):
        body = tok[len(_PATH_TOKEN_PREFIX):]
        # Collapse repeated separators and strip leading/trailing /.
        segments = [s for s in body.split("/") if s]
        if len(segments) < 2:
            # `path:` is meant for sub-repo claims. A bare `path:X` would be
            # indistinguishable from `repo:X` and would muddle the overlap
            # rules -- force callers to use `repo:X` for the whole-repo claim.
            raise ValueError(
                f"path: tokens require a repo AND a subpath "
                f"(use repo:<name> for the whole repo): {tok!r}"
            )
        return f"{_PATH_TOKEN_PREFIX}{'/'.join(segments)}"
    if _TYPED_TOKEN_RE.match(tok):
        return tok
    if _is_task_token(tok):
        return tok
    # Unknown / untyped token: accept as-is (exact match).
    return tok


def _list_valid_repos():
    """Return the sorted list of directory names under SESSION_TASK_REPOS_DIR.

    Returns None (distinct from an empty list) when the repos dir does not
    exist or isn't a directory -- callers treat None as "can't validate,
    fail open". Hidden dirs (leading '.') are excluded; they're never repo
    working trees a `repo:` scope would name.
    """
    root = SESSION_TASK_REPOS_DIR
    try:
        if not root.is_dir():
            return None
        return sorted(
            p.name
            for p in root.iterdir()
            if p.is_dir() and not p.name.startswith(".")
        )
    except OSError:
        # Unreadable / permission error -> fail open (return None).
        return None


def _validate_repo_scope_tokens(tokens):
    """Validate that every `repo:<name>` token names a real repos-dir dir.

    Only the `repo:` prefix is checked; all other scope namespaces
    (`resource:`, `path:`, `hostjob:`, `slack-mcp-*`, free-form, ...) pass
    through untouched.

    Fail-open cases (no error raised):
      * SESSION_TASK_REPOS_DIR missing / not a dir / unreadable
        (`_list_valid_repos()` is None) -- e.g. a stripped-down deploy or a
        test tmpdir with no `repos/` subtree.
      * `SESSION_TASK_REPOS_NO_VALIDATE` env var set to a non-empty,
        non-"0" value (deliberate escape hatch for genuine edge cases:
        a repo not yet cloned, a scratch scope, etc.).

    Raises ValueError with an actionable message (naming the bad token, the
    repos dir, and the valid repo list) on the first invalid `repo:` token.
    """
    bypass = os.environ.get("SESSION_TASK_REPOS_NO_VALIDATE", "").strip()
    if bypass not in ("", "0"):
        return
    valid = _list_valid_repos()
    if valid is None:
        return  # can't validate -> fail open
    valid_set = set(valid)
    for tok in tokens or []:
        if not isinstance(tok, str) or not tok.startswith("repo:"):
            continue
        name = tok[len("repo:"):].strip()
        if not name:
            # An empty repo:<> token is malformed regardless of the dir list.
            raise ValueError(
                f"scope {tok!r} invalid: empty repo name "
                f"(use repo:<name> where <name> is a directory in "
                f"{SESSION_TASK_REPOS_DIR})"
            )
        if name not in valid_set:
            listing = ", ".join(valid) if valid else "(none)"
            raise ValueError(
                f"scope {tok!r} invalid: no directory {name!r} in "
                f"{SESSION_TASK_REPOS_DIR}. Valid repos: {listing}. "
                f"(If this is a genuine edge case -- e.g. a repo not yet "
                f"cloned -- set SESSION_TASK_REPOS_NO_VALIDATE=1 to bypass, "
                f"or point SESSION_TASK_REPOS_DIR at the right root.)"
            )


# ---------------------------------------------------------------------------
# Add-time scope/target heuristic (botchat #2346, 2026-07-24)
# ---------------------------------------------------------------------------
#
# Andrew flagged a distinct failure from the invented-scope-name bug the
# repo-dir validator (`_validate_repo_scope_tokens`) already catches: a task
# whose DESCRIPTION clearly names one repo but whose `--scope` claims a
# DIFFERENT (real) repo. The concrete case: a task editing
# `<org>/platform-html-to-pdf` was scoped `repo:platform` (the monorepo)
# -- both are real dirs, so the dir validator passed it -- but the scope is the
# WRONG repo, over-serializing/racing independent per-repo work.
#
# This heuristic runs at `queue add` time: when the description/summary names a
# SINGLE, unambiguous target repo (via an `<org>/<repo>` / `~/repos/<repo>`
# path, a `<repo> #<num>` PR reference, or a bare known-repo-dir name) and the
# `--scope` does NOT include a matching `repo:<that>` (nor a `path:<that>/...`
# nor `*`), we emit a loud stderr WARNING. It NEVER hard-rejects (Andrew:
# "prefer warn-loudly over hard-reject at add-time if the heuristic could
# misfire") -- the enforcing gate is spawn-time. It is deliberately
# conservative: it only fires on a clear single target, and defers entirely
# when the text is ambiguous (0 or >1 candidate repos).

# Git-forge orgs whose repos get referred to as `<org>/<repo>` in task text.
# CONFIGURABLE, never hardcoded to a particular user's employer/client: set
# `CLAUDE_REPO_ORGS` to a comma/whitespace-separated list (e.g.
# `CLAUDE_REPO_ORGS="acme-sf,acme-labs"`). The upstream project's own org is
# always recognised so a default install still resolves `<owner>/<repo>`.
DEFAULT_REPO_ORGS = ("hndrewaall",)
_ORG_TOKEN_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def _repo_orgs():
    """Configured `<org>/<repo>` prefixes, defaults included.

    Implausible tokens are ignored rather than fatal -- a typo'd env var must
    never break `queue add`.
    """
    orgs = set(DEFAULT_REPO_ORGS)
    for tok in re.split(r"[,\s]+", os.environ.get("CLAUDE_REPO_ORGS", "")):
        tok = tok.strip()
        if tok and _ORG_TOKEN_RE.match(tok):
            orgs.add(tok)
    return sorted(orgs)


def _build_repo_path_mention_res():
    """Path-shaped mentions: `<org>/<repo>`, `~/repos/<repo>`,
    `/Users/.../repos/<repo>`, `repo:<name>`. Captures the trailing repo
    segment. We intentionally match a small set of known org/path prefixes
    rather than any `a/b` (which would false-positive on prose like "and/or").
    """
    res = [re.compile(re.escape(org) + r"/([A-Za-z0-9._-]+)") for org in _repo_orgs()]
    res.append(
        re.compile(r"(?:~|/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+)/repos/([A-Za-z0-9._-]+)")
    )
    res.append(re.compile(r"repo:([A-Za-z0-9._-]+)"))
    return res


_REPO_PATH_MENTION_RES = _build_repo_path_mention_res()


def _repo_scope_names(scope):
    """Return the set of repo names claimed by `repo:` / `path:` scope tokens.

    `repo:X` -> X; `path:X/...` -> X. Used to check whether the scope already
    covers a heuristically-detected target repo.
    """
    names = set()
    for tok in scope or []:
        if not isinstance(tok, str):
            continue
        if tok.startswith("repo:"):
            n = tok[len("repo:"):].strip()
            if n:
                names.add(n)
        elif _is_path_token(tok):
            n = _path_token_repo(tok)
            if n:
                names.add(n)
    return names


def _detect_target_repos(text, valid_repos):
    """Detect repo dirs unambiguously named in free-text task description.

    Returns the set of `valid_repos` names the text refers to. Only names that
    are ACTUAL repo dirs (in `valid_repos`) count -- so a bare word that merely
    looks like a repo but names no real dir is ignored (keeps the heuristic
    from false-positiving on generic prose). Two detection modes:

      1. Path/org-prefixed mentions (`<org>/<repo>`, `~/repos/<repo>`,
         `repo:<repo>`) -- strong signal, matched anywhere in the text.
      2. Bare whole-word occurrence of a known repo dir name -- but ONLY for
         "distinctive" names (contain a '-' or '_', or are >= 8 chars). A
         short generic name like `config` or `p4` is too collision-prone with
         ordinary prose to treat a bare mention as a target.

    `valid_repos` is the list from `_list_valid_repos()` (None when the repos
    dir is absent -> caller treats that as "can't detect", no warning).
    """
    if not text or not valid_repos:
        return set()
    valid_set = set(valid_repos)
    found = set()

    # Mode 1: path/org-prefixed + explicit repo: mentions. Strip trailing
    # sentence punctuation (repo names may contain interior dots -- e.g.
    # claude-watch.bak.v13 -- but never a trailing period).
    for rx in _REPO_PATH_MENTION_RES:
        for m in rx.finditer(text):
            name = m.group(1).rstrip(".,;:!?)]}'\"")
            if name in valid_set:
                found.add(name)

    # Mode 2: bare whole-word mentions of distinctive repo dir names.
    for name in valid_set:
        if len(name) < 8 and "-" not in name and "_" not in name:
            # Too short/generic to trust a bare mention.
            continue
        if re.search(rf"(?<![A-Za-z0-9._-]){re.escape(name)}(?![A-Za-z0-9._-])", text):
            found.add(name)

    return found


def _longest_repo_name(names):
    """Pick the most-specific repo among a set (longest name wins).

    When a monorepo-style name is a PREFIX of a more-specific sibling that is
    ALSO present in the text (e.g. both `platform` and `platform-html-to-pdf`
    matched), the longer/more-specific name is the intended target. Returns
    None unless collapsing yields exactly one target.
    """
    names = set(names)
    if not names:
        return None
    if len(names) == 1:
        return next(iter(names))
    # Collapse names that are a prefix (segment-wise) of another present name.
    # `platform` is subsumed by `platform-html-to-pdf`; keep only maximal ones.
    maximal = set(names)
    for a in names:
        for b in names:
            if a != b and b.startswith(a + "-"):
                maximal.discard(a)
                break
    if len(maximal) == 1:
        return next(iter(maximal))
    return None


def _scope_target_mismatch_warning(scope, description, summary):
    """Return a warning string if the text names one repo the scope misses.

    Heuristic + non-brittle (botchat #2346): warns ONLY when
      * the repos dir is available (else we can't tell real dirs from prose),
      * the description/summary names exactly ONE unambiguous target repo dir,
      * `*` is NOT in scope (a universal claim covers everything), and
      * no `repo:<target>` / `path:<target>/...` token is in scope.

    Returns None (no warning) on ANY ambiguity -- 0 targets, >1 irreducible
    targets, missing repos dir. Never raises; purely advisory.
    """
    try:
        if any(t == "*" for t in (scope or [])):
            return None
        valid = _list_valid_repos()
        if not valid:
            return None
        text = " ".join(p for p in (description, summary) if p)
        targets = _detect_target_repos(text, valid)
        target = _longest_repo_name(targets)
        if not target:
            return None
        claimed = _repo_scope_names(scope)
        # Covered (no warning) when a claimed repo is EXACTLY the target or
        # MORE specific than it (C == T, or C is a `T-...` sub-repo -- e.g.
        # scope repo:platform-typesense covers a bare "platform" mention).
        # A claimed repo that is LESS specific than the target (e.g. scope
        # repo:platform vs target platform-html-to-pdf) is exactly the
        # over-broad case we DO warn about, so it is not coverage.
        if any(c == target or c.startswith(target + "-") for c in claimed):
            return None
        claimed_desc = ", ".join(sorted(f"repo:{c}" for c in claimed)) or "(no repo: scope)"
        return (
            f"scope/target mismatch: the task text names repo {target!r} "
            f"but --scope claims {claimed_desc}. If this task operates on "
            f"{target!r}, use `--scope repo:{target}` so it serializes with "
            f"other {target!r} work (and doesn't over-serialize/race a "
            f"different repo). If the scope is intentional, ignore this warning "
            f"or pass an explicit `repo:{target}` alongside."
        )
    except Exception:
        # Purely advisory -- never let a heuristic bug break `queue add`.
        return None


def _is_path_token(tok):
    return isinstance(tok, str) and tok.startswith(_PATH_TOKEN_PREFIX)


def _path_token_segments(tok):
    """Return the segment list of a normalized `path:<repo>/<a>/<b>` token.

    First element is the repo; remainder is the within-repo path. Caller is
    expected to pass an already-normalized token (so segments are non-empty
    and >= 2 long).
    """
    body = tok[len(_PATH_TOKEN_PREFIX):]
    return body.split("/")


def _path_token_repo(tok):
    """Return the repo name embedded in a `path:` token."""
    return _path_token_segments(tok)[0]


def _tokens_overlap(a, b):
    """Return True if two normalized scope tokens overlap.

    - '*' overlaps everything (including task: tokens).
    - Two file: tokens overlap if one is a prefix of the other.
    - Two `path:` tokens overlap iff they share the same repo AND one
      within-repo path is a (segment-wise) prefix of the other. Siblings
      (`path:X/a` vs `path:X/b`) are disjoint.
    - `repo:X` overlaps every `path:X/...` -- the broad whole-repo claim
      still wins over any narrower sub-claim. Cross-repo is never an
      overlap (`repo:X` vs `path:Y/...` is disjoint).
    - `task:<id>` tokens overlap only with the same exact `task:<id>` token
      (and '*'). They never overlap regular scope tokens. Lock machinery
      uses this so `queue lock task:q-XXXX` parks any pending item that
      lists `task:q-XXXX` in its scope.
    - Typed/other tokens overlap only if equal.

    NOTE: `task:` tokens are EXEMPT from group-merge and running-scope
    conflict checks. Those callers (`_group_ids_overlapping`,
    `_running_scope_conflicts`, `_group_scope`) filter task tokens out
    BEFORE calling this helper -- see `_serializing_scope`. Item readiness
    (the actual "wait for q-A" gate) is computed in `_item_is_ready` by
    consulting the queue, not by overlap.
    """
    if a == "*" or b == "*":
        return True
    a_is_file = a.startswith("file:")
    b_is_file = b.startswith("file:")
    if a_is_file and b_is_file:
        pa = a[len("file:"):]
        pb = b[len("file:"):]
        # Directory-style prefix: we treat file:/foo and file:/foo/ as the same.
        # Add trailing slash for correct prefix match so file:/foo doesn't
        # accidentally match file:/foobar.
        def with_sep(p):
            return p if p.endswith("/") else p + "/"
        if pa == pb:
            return True
        wa = with_sep(pa)
        wb = with_sep(pb)
        # Either is a directory-prefix of the other, OR one is an exact file
        # that lives under the other's directory.
        return wa.startswith(wb) or wb.startswith(wa)
    a_is_path = _is_path_token(a)
    b_is_path = _is_path_token(b)
    if a_is_path and b_is_path:
        # Same repo + segment-wise prefix => overlap. Siblings disjoint.
        sa = _path_token_segments(a)
        sb = _path_token_segments(b)
        if sa[0] != sb[0]:
            return False
        # Compare the within-repo segments (everything after the repo name).
        ra = sa[1:]
        rb = sb[1:]
        # One must be a (possibly equal) segment-wise prefix of the other.
        # Since both are normalized non-empty and the repo matched, this is
        # the standard prefix check.
        if len(ra) <= len(rb):
            return rb[: len(ra)] == ra
        return ra[: len(rb)] == rb
    # `repo:X` overlaps any `path:X/...`: the broad whole-repo claim wins.
    a_is_repo = a.startswith("repo:")
    b_is_repo = b.startswith("repo:")
    if a_is_repo and b_is_path:
        return a[len("repo:"):] == _path_token_repo(b)
    if b_is_repo and a_is_path:
        return b[len("repo:"):] == _path_token_repo(a)
    # Mixed types or two non-file/non-path tokens: exact match only.
    return a == b


def _serializing_scope(scope):
    """Return scope tokens that participate in serialization / group-merge.

    Filters out `task:<id>` tokens, which are inert dep markers (their
    semantics live in `_item_is_ready` and locks, not in scope conflicts).
    Used by `_group_ids_overlapping`, `_running_scope_conflicts`, and
    `_group_scope` so a `--depends-on` cross-group dep does NOT fold the
    dependent into the depended-on item's group.
    """
    return [t for t in (scope or []) if not _is_task_token(t)]


def _scope_sets_overlap(set_a, set_b):
    """True if any token from set_a overlaps any token from set_b."""
    for ta in set_a:
        for tb in set_b:
            if _tokens_overlap(ta, tb):
                return True
    return False


def _union_scopes(*sets):
    """Union of token sets, with simple dedupe."""
    merged = []
    seen = set()
    for s in sets:
        for t in s:
            if t not in seen:
                seen.add(t)
                merged.append(t)
    return merged


def _active_items(items):
    # NOTE: "active" here means "participates in scope serialization", NOT
    # "non-terminal for display". Only `_group_ids_overlapping` (group
    # formation) calls this, so it uses SERIALIZING_STATUSES -- a blocked
    # item must not bridge scopes into an existing group. (Display surfaces
    # that want blocked included filter on ACTIVE_STATUSES directly.)
    return [it for it in items if it.get("status") in SERIALIZING_STATUSES]


def _group_members(items, group_id):
    return [it for it in items if it.get("group_id") == group_id]


def _group_scope(items, group_id):
    members = _group_members(items, group_id)
    # task: tokens are inert for serialization purposes -- they get exposed
    # via item-level scope but are stripped from the aggregated group scope.
    return _serializing_scope(
        _union_scopes(*(m.get("scope", []) for m in members))
    )


def _group_ids_overlapping(items, new_scope):
    """Return list of group_ids whose aggregated scope overlaps new_scope.

    Only considers groups with at least one pending/running member.
    `task:<id>` tokens are inert here (they're cross-group dep markers,
    not serialization keys).
    """
    new_serializing = _serializing_scope(new_scope)
    if not new_serializing:
        # Item carries only inert (e.g. task:) tokens -- it never merges
        # into an existing group on serialization grounds.
        return []
    active = _active_items(items)
    by_group = {}
    for it in active:
        by_group.setdefault(it["group_id"], []).append(it)
    overlapping = []
    for gid, members in by_group.items():
        gscope = _serializing_scope(
            _union_scopes(*(m.get("scope", []) for m in members))
        )
        if _scope_sets_overlap(gscope, new_serializing):
            overlapping.append(gid)
    return overlapping


def _running_scope_conflicts(items, candidate_scope, *, exclude_id=None,
                             exclude_group=None):
    """Return list of running OR wedged items whose scope overlaps candidate_scope.

    Used for spawn-gating: if ANY running/wedged item overlaps the
    candidate's scope (even across groups -- which should be rare given
    the merge semantics but can happen for untracked/unregistered
    in-flight work), spawning is a conflict.

    Wedged items still own their scope -- the agent is stuck but hasn't
    released the slot. Letting a peer claim the same scope while the
    wedge is unresolved would defeat the queue's serialization guarantee.

    `exclude_id` skips a specific item (e.g. the candidate itself once
    it's been marked running). `exclude_group` skips an entire group (used
    when the caller already knows group-level invariant holds).
    """
    # task: tokens are inert for running-conflict purposes (they're
    # cross-group dep hints, not serialization keys). Strip them from
    # both sides before overlap check so two items both carrying
    # `task:q-A` don't falsely report a conflict.
    candidate_serializing = _serializing_scope(candidate_scope)
    out = []
    for it in items:
        if it.get("status") not in RUNNING_STATUSES:
            continue
        if exclude_id and it.get("id") == exclude_id:
            continue
        if exclude_group and it.get("group_id") == exclude_group:
            continue
        if _scope_sets_overlap(
            _serializing_scope(it.get("scope", [])), candidate_serializing
        ):
            out.append(it)
    return out


def _sort_key(item):
    # Spawn/readiness ordering within a group is PRIORITY-FIRST: higher
    # priority number sorts earlier (so it becomes the group head and goes
    # ready first), with created_at (insertion order) only as the FIFO
    # tiebreak among equal priorities. This is what lets a higher-priority
    # item added LATER overtake an earlier lower-priority same-scope peer
    # without abandon+re-add (see `queue reprioritize` / `queue promote`).
    return (-int(item.get("priority", 5)), item.get("created_at", ""))


def _group_head(items, group_id):
    """Return the current head (running/wedged if any, else next pending).

    Wedged items count as "in flight" for head-of-group purposes so a
    peer pending item in the same group cannot be promoted while the
    wedge is unresolved.

    `blocked` items are EXCLUDED from head candidacy entirely: per design
    `queue block` releases the scope lock, so a blocked item must never be
    the group head (which would pin the scope and starve a pending peer).
    This mirrors the proven-correct web UI `_compute_ready_now`, which
    computes the head from ("pending","running") membership only. Concretely:
    an in-flight (running/wedged) member is the head if present; otherwise
    the oldest *pending* member is the head -- a lone blocked member yields
    no head, freeing its pending peers to become ready.
    """
    members = [it for it in _group_members(items, group_id) if it.get("status") in SERIALIZING_STATUSES]
    if not members:
        return None
    running = [it for it in members if it.get("status") in RUNNING_STATUSES]
    if running:
        return sorted(running, key=_sort_key)[0]
    # FIFO fallback: head is the oldest *pending* member. Exclude blocked
    # (and any non-pending residue) so a blocked item never re-selects as
    # head via the fallback and pins the scope against its pending peers.
    pending = [it for it in members if it.get("status") == "pending"]
    if not pending:
        return None
    return sorted(pending, key=_sort_key)[0]


def _locked_tokens_blocking_item(item, locked_scopes):
    """Return the list of locked-scope tokens that overlap this item's scope.

    Empty list if `locked_scopes` is empty/None or no token overlaps.
    A "lock" is just a string token in the locked-scopes set; an item is
    blocked when ANY of its scope tokens overlaps ANY locked token (using
    the same overlap semantics as scope-conflict detection).
    """
    if not locked_scopes:
        return []
    item_scope = item.get("scope") or []
    blockers = []
    for tok in locked_scopes.keys():
        for it_tok in item_scope:
            if _tokens_overlap(it_tok, tok):
                blockers.append(tok)
                break
    return blockers


def _item_is_ready(items, item, locked_scopes=None):
    if item.get("status") != "pending":
        return False
    # Manual lock (added 2026-05-08): operator-declared "park this scope
    # until I say so" gate. Any pending item whose scope overlaps a locked
    # token is held in pending+blocked-by-lock state and is NOT ready.
    # Stored in queue.json under "locked_scopes" so it survives /clear.
    if _locked_tokens_blocking_item(item, locked_scopes):
        return False
    head = _group_head(items, item["group_id"])
    if head is None:
        return False
    if head["id"] != item["id"]:
        return False
    # Head must not be running OR wedged (anything in flight blocks).
    members = _group_members(items, item["group_id"])
    if any(m.get("status") in RUNNING_STATUSES for m in members):
        return False
    # Explicit interjob deps (added 2026-05-02; unified with scope tokens
    # 2026-05-08): every dep id must resolve to an item with status=done.
    # Targets that are missing, abandoned, or part of a dependency cycle
    # are treated as permanent blockers (the item stays not-ready until a
    # human edits the deps). Lazy read-time compute path -- no
    # transitive-closure cache.
    #
    # As of 2026-05-08, deps live BOTH on `depends_on` (legacy field, still
    # honored for back-compat in case any caller stamped one directly) AND
    # as `task:<id>` scope tokens (the new canonical surface, materialized
    # by `--depends-on` / `queue depend` and the read-time migration in
    # `_queue_open_locked`). They union here -- either source blocks.
    deps = list(_iter_dep_ids(item))
    if deps:
        if _has_dep_cycle(items, item["id"]):
            return False
        items_by_id = {it.get("id"): it for it in items if it.get("id")}
        for dep_id in deps:
            dep = items_by_id.get(dep_id)
            if dep is None:
                # Dangling dep — treat as a permanent blocker. Operator must
                # remove it explicitly via `queue depend ... --remove`.
                return False
            if dep.get("status") != "done":
                return False
    return True


def _iter_dep_ids(item):
    """Yield the queue ids this item depends on, deduplicated.

    Combines two sources:
      * `task:<id>` scope tokens (canonical 2026-05-08+).
      * Legacy `depends_on` list (older queue.json files; the read-time
        migration in `_queue_open_locked` translates these into task:
        scope tokens, so this branch is mostly defensive).

    Order is stable: `task:` tokens in scope order first, then any legacy
    `depends_on` entries that aren't already covered by a task: token.
    """
    seen: set[str] = set()
    for tok in (item.get("scope") or []):
        target = _task_token_target(tok)
        if target and target not in seen:
            seen.add(target)
            yield target
    for d in (item.get("depends_on") or []):
        if isinstance(d, str) and d and d not in seen:
            seen.add(d)
            yield d


def _has_dep_cycle(items, root_id):
    """Detect a dependency cycle reachable from root_id.

    Lazy DFS, computed at read time only when an item has any deps. We do
    NOT block writes on cycle detection (per the architecture brief —
    "Don't block writes on cycle check") to keep `queue depend` cheap;
    instead, ready_now flips False the moment a cycle becomes reachable.

    Bounded by the active item count (the call site walks a single
    item's dep graph), so worst case O(N) per ready_now call where N is
    the queue size. For the typical ≤50-item queue this is trivially
    fast.
    """
    by_id = {it.get("id"): it for it in items if it.get("id")}
    visited = set()
    on_path = set()

    root_item = by_id.get(root_id, {})
    walk = [(root_id, iter(list(_iter_dep_ids(root_item))))]
    on_path.add(root_id)
    while walk:
        _node, it_children = walk[-1]
        try:
            child = next(it_children)
        except StopIteration:
            popped, _ = walk.pop()
            on_path.discard(popped)
            visited.add(popped)
            continue
        if not isinstance(child, str):
            continue
        if child in on_path:
            return True
        if child in visited:
            continue
        child_item = by_id.get(child)
        if child_item is None:
            # Dangling — not a cycle (just a dead edge). The caller's
            # ready check will treat it as a permanent blocker.
            visited.add(child)
            continue
        on_path.add(child)
        walk.append((child, iter(list(_iter_dep_ids(child_item)))))
    return False


def _reaches(items, src_id, dst_id):
    """Return True if src_id transitively depends on dst_id.

    Plain forward-reachability DFS over the dep graph (the same edges
    ``_iter_dep_ids`` exposes). Used by ``cmd_queue_depend`` to name the
    offending dep when a cycle-creating edit is refused: an added edge
    ``item -> d`` closes a loop iff ``d`` already reaches ``item``.
    O(N) over the queue, same budget as ``_has_dep_cycle``.
    """
    if src_id == dst_id:
        return True
    by_id = {it.get("id"): it for it in items if it.get("id")}
    seen = set()
    stack = [src_id]
    while stack:
        node = stack.pop()
        if node in seen:
            continue
        seen.add(node)
        node_item = by_id.get(node)
        if node_item is None:
            continue
        for child in _iter_dep_ids(node_item):
            if child == dst_id:
                return True
            if child not in seen:
                stack.append(child)
    return False


def _gc_groups(items):
    """Remove any reference to groups that have no pending/running members.

    (Groups are derived from group_id on items, so nothing to remove except
    logging completed done/abandoned members as they age out. Items with
    status done/abandoned older than the prune threshold can be kicked by
    `queue prune`.)
    """
    return items


def _recompute_groups(items):
    """Re-derive group_id assignments from actual serializing connectivity.

    Groups are the serialization unit: a group must reflect a connected
    component of items whose scopes overlap AND that actually serialize
    (`SERIALIZING_STATUSES` = pending/running/wedged). A `blocked` (or
    terminal) item must NOT bridge two otherwise-independent scope
    components into one group -- that is exactly the bug where a multi-scope
    blocked item parked on an external blocker (e.g. a Drive push lock)
    bridged a running agent in scope A and a pending task in scope B, so the
    scope-B task could not spawn even though nothing was using its clone.

    Algorithm:
      1. Connectors = items in SERIALIZING_STATUSES. Union-find over them,
         joining two connectors whose serializing scopes overlap. Each
         resulting component becomes one group; its group_id is reused from
         the component's members (most common existing id) for stability,
         else a fresh id.
      2. Non-connectors (blocked / done / abandoned) do NOT bridge. Each
         attaches to a connector component ONLY IF its serializing scope
         overlaps EXACTLY ONE component (it then shares that group_id, which
         is harmless -- it owns no slot and is not the head). If it overlaps
         zero or MORE THAN ONE component, it is left in / given its OWN
         standalone group so it can never act as a bridge.

    Idempotent: running it on an already-correct layout is a no-op (modulo
    group_id label stability, which is preserved by the reuse heuristic).
    Mutates `items` in place (sets each item's "group_id").
    """
    if not items:
        return

    connectors = [it for it in items if it.get("status") in SERIALIZING_STATUSES]

    # --- 1. Union-find over connectors by serializing-scope overlap. ---
    parent = {it["id"]: it["id"] for it in connectors}

    def find(x):
        root = x
        while parent[root] != root:
            root = parent[root]
        # path-compress
        while parent[x] != root:
            parent[x], x = root, parent[x]
        return root

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    conn_serializing = {
        it["id"]: _serializing_scope(it.get("scope", [])) for it in connectors
    }
    for i in range(len(connectors)):
        si = conn_serializing[connectors[i]["id"]]
        if not si:
            continue
        for j in range(i + 1, len(connectors)):
            sj = conn_serializing[connectors[j]["id"]]
            if sj and _scope_sets_overlap(si, sj):
                union(connectors[i]["id"], connectors[j]["id"])

    # Component root -> list of connector items.
    comp_members = {}
    for it in connectors:
        comp_members.setdefault(find(it["id"]), []).append(it)

    # Assign a stable group_id per component: reuse the most common existing
    # group_id among the component's members (deterministic tiebreak on the
    # id string), else mint a fresh one.
    comp_gid = {}
    used_gids = set()
    for root, members in comp_members.items():
        counts = {}
        for m in members:
            g = m.get("group_id")
            if g:
                counts[g] = counts.get(g, 0) + 1
        if counts:
            # most frequent, tiebreak by smallest gid string for determinism
            gid = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[0][0]
            # avoid collision if another component already claimed this gid
            if gid in used_gids:
                gid = _new_group_id()
        else:
            gid = _new_group_id()
        comp_gid[root] = gid
        used_gids.add(gid)
        for m in members:
            m["group_id"] = gid

    # Component root -> aggregated serializing scope (for non-connector match).
    comp_scope = {}
    for root, members in comp_members.items():
        comp_scope[root] = _serializing_scope(
            _union_scopes(*(m.get("scope", []) for m in members))
        )

    # --- 2. Attach non-connectors without ever bridging components. ---
    for it in items:
        if it.get("status") in SERIALIZING_STATUSES:
            continue
        s = _serializing_scope(it.get("scope", []))
        overlapping_roots = []
        if s:
            for root, gscope in comp_scope.items():
                if gscope and _scope_sets_overlap(s, gscope):
                    overlapping_roots.append(root)
        if len(overlapping_roots) == 1:
            # Safe to co-locate: shares the single overlapping component's
            # group_id. It owns no slot and is never the head, so this only
            # affects display grouping -- it cannot bridge anything.
            it["group_id"] = comp_gid[overlapping_roots[0]]
        else:
            # Zero overlap, or overlaps MULTIPLE components (would bridge):
            # keep a standalone group so this item connects nothing.
            cur = it.get("group_id")
            if (not cur) or (cur in used_gids):
                cur = _new_group_id()
            it["group_id"] = cur
            used_gids.add(cur)


def _recompute_group_heads(items):
    """Ensure invariant: at most one running per group, head flag is accurate.

    First re-derives group membership from actual serializing connectivity
    (`_recompute_groups`) so a blocked/terminal item that previously bridged
    two scope components is split back out before heads are assigned. Then
    assigns the head flag per group.
    """
    _recompute_groups(items)
    by_group = {}
    for it in items:
        by_group.setdefault(it.get("group_id"), []).append(it)
    for gid, members in by_group.items():
        head = _group_head(items, gid)
        for m in members:
            m["group_head"] = (head is not None and m["id"] == head["id"])


# --- queue subcommands ---------------------------------------------------


def _fmt_ts():
    return datetime.now(timezone.utc).isoformat()


def _pingme_notify(title, message, priority="normal", silent=False):
    """Fire a queue Pushover notification via the ``queue-notify`` CLI.

    Called from queue lifecycle hooks (register / done / abandon / etc.).
    Queue notifications go through a DEDICATED Pushover application token
    (distinct from ``pingme``'s general-purpose token) and deliver quietly
    (``sound=vibrate``). ``queue-notify`` reuses pingme's Pushover *user*
    key, so notifications still land on the same recipient. See
    ``tools/session-task/queue-notify`` for the credential lookup; the
    dedicated token lives in local config (``~/.config/queue-notify/env``),
    never in this (public) repo.

    Failures MUST NOT block the underlying queue state transition, so every
    error path here is swallowed to stderr and returns None.

    Suppression:
        * ``silent=True`` (from ``--silent`` on the CLI) skips the call.
        * ``PINGME_SESSION_TASK=0`` env var skips all session-task queue
          notifications (useful for batch scripts / noisy flows).
        * ``queue-notify`` not on PATH -> silent no-op (not an error).

    The function name is retained (rather than renamed to ``_queue_notify``)
    to avoid churning the ~dozen lifecycle call sites; the keyword/signature
    is identical to the prior pingme-based version.
    """
    if silent:
        return None
    if os.environ.get("PINGME_SESSION_TASK") == "0":
        return None
    notifier = shutil.which("queue-notify")
    if not notifier:
        return None
    if priority not in ("low", "normal", "high", "emergency"):
        priority = "normal"
    cmd = [notifier, "-p", priority, message, title]
    try:
        subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except Exception as exc:  # noqa: BLE001 -- never block the queue op
        print(f"[queue-notify] notification failed "
              f"({exc.__class__.__name__}): {exc}",
              file=sys.stderr)
        return None
    return cmd


def _claude_event_notify(tag, message, data, priority="low", silent=False):
    """Emit a claude-event for a queue lifecycle transition.

    Wraps the ``claude-event`` CLI. Events land in ``~/claude-events/`` and
    are picked up by ``claude-event-watch``, letting the main loop react to
    queue transitions (e.g. spawn the next-in-group item when a blocker
    clears).

    MUST NEVER block or fail the underlying queue op. All errors are caught
    and logged to stderr as a warning. A broken ``claude-event`` is a
    warning, not a crash.

    Suppression mirrors pingme:
        * ``silent=True`` (from ``--silent`` on the CLI) skips the call.
        * ``CLAUDE_EVENT_SESSION_TASK=0`` env var skips all emits
          (useful for batch scripts / test harnesses).
        * ``claude-event`` not on PATH -> silent no-op (not an error).
    """
    if silent:
        return None
    if os.environ.get("CLAUDE_EVENT_SESSION_TASK") == "0":
        return None
    emitter = shutil.which("claude-event")
    if not emitter:
        return None
    if priority not in ("low", "normal", "high", "urgent"):
        priority = "low"
    cmd = [
        emitter,
        message,
        "--source", "queue",
        "--tag", tag,
        "--priority", priority,
    ]
    # Flatten data dict into repeated --data KEY=VAL args. Nested structures
    # (scope list) get JSON-serialised so the consumer can round-trip them.
    for k, v in (data or {}).items():
        if isinstance(v, (list, dict)):
            v = json.dumps(v, separators=(",", ":"))
        cmd.extend(["--data", f"{k}={v}"])
    try:
        subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except Exception as exc:  # noqa: BLE001 -- never block the queue op
        print(
            f"[claude-event] emit failed ({exc.__class__.__name__}): {exc}",
            file=sys.stderr,
        )
        return None
    return cmd


def _obligations_register_force_start(queue_id, summary, reason, ttl_secs=900,
                                       bundle_path=None, autostopped_count=0):
    """Register a `force_started_unspawned` obligation on the queue id.

    Wired by `cmd_queue_force_start` after a successful pending->running
    promotion. The obligation gates `*` (every tool) until the main loop
    actually spawns an Agent for the queue item -- the predicate clears
    the moment claude-watch's active-agents JSON shows a live record for
    the qid. The Agent tool itself is in `UNIVERSAL_RECOVERY_EXEMPT_PATTERNS`
    so the spawning Agent call is never blocked by the gate it satisfies.

    MUST NEVER block or fail the underlying queue op. All errors are
    caught and logged to stderr as a warning. Suppression mirrors
    pingme / claude-event:
      * `OBLIGATIONS_FORCE_START=0` env var skips the call entirely
        (test harnesses, scripted batch runs).
      * `obligations` not on PATH -> silent no-op (not an error).

    The TTL defaults to 15 min (900s). If the main loop genuinely can't
    dispatch within that window the obligation auto-expires rather than
    deadlocking forever; this matches Andrew's "short" guidance in the
    spec. Bump or pass a larger value if that proves too tight in
    practice.

    ``bundle_path`` (when present) is woven into the deny banner so the
    main loop sees the recovery context location at gate-fire time. The
    spawned Agent is expected to read that file as its FIRST action so
    it can triage the autostopped peers' uncommitted work.
    """
    if os.environ.get("OBLIGATIONS_FORCE_START") == "0":
        return None
    cli = shutil.which("obligations")
    if not cli:
        return None
    bundle_hint = ""
    if bundle_path:
        if autostopped_count:
            bundle_hint = (
                f" Autostopped {autostopped_count} running peer(s); "
                f"the recovery bundle at {bundle_path} contains their "
                f"prompts, transcript paths, and uncommitted git state — "
                f"the spawning Agent must read it and triage."
            )
        else:
            bundle_hint = (
                f" Recovery bundle at {bundle_path} (no peers autostopped)."
            )
    deny_msg = (
        f"FORCE-START: q={queue_id} ({summary}) was force-started but no "
        f"Agent has been spawned for it yet. Dispatch the agent before "
        f"running any other tool. Reason: {reason}.{bundle_hint}"
    )
    params = json.dumps({"queue_id": queue_id})
    cmd = [
        cli,
        "add",
        "--tool-pattern", "*",
        "--predicate", "force_started_unspawned",
        "--params", params,
        "--ttl", str(int(ttl_secs)),
        "--deny-msg", deny_msg,
        "--enforcement", "gate",
        "--created-by", f"force-start:{queue_id}",
    ]
    try:
        subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except Exception as exc:  # noqa: BLE001 -- never block the queue op
        print(
            f"[obligations] force-start register failed "
            f"({exc.__class__.__name__}): {exc}",
            file=sys.stderr,
        )
        return None
    return cmd


def _item_summary(item):
    """Read the one-line summary of a queue item, defaulting to placeholder.

    Legacy items (written before 2026-04-19) have no ``summary`` field; they
    surface as ``DEFAULT_SUMMARY`` until edited via ``queue set-summary``.
    """
    s = (item.get("summary") or "").strip()
    return s if s else DEFAULT_SUMMARY


def _elapsed_minutes(started_at_iso):
    """Return integer minutes elapsed since an ISO-8601 timestamp, or None."""
    sec = _elapsed_seconds(started_at_iso)
    if sec is None:
        return None
    return sec // 60


def _elapsed_seconds(started_at_iso):
    """Return integer seconds elapsed since an ISO-8601 timestamp, or None.

    Used by the claude-event emitter so the consumer can render minute-level
    precision for short tasks (<60s) that would otherwise log as "0m".
    """
    if not started_at_iso:
        return None
    try:
        started = datetime.fromisoformat(started_at_iso)
    except (TypeError, ValueError):
        return None
    now = datetime.now(timezone.utc)
    if started.tzinfo is None:
        # Treat naive as UTC rather than crashing -- queue writes utc iso.
        started = started.replace(tzinfo=timezone.utc)
    delta = now - started
    return max(0, int(delta.total_seconds()))


def _load_active_agents_state():
    """Load the active-agents JSON via state-file with binary-fallback.

    Returns a parsed dict ({"agents": [...]}) or None when both paths
    fail. Two layers:

      1. ``CLAUDE_AGENTS_STATE`` — atomic file maintained by a cron that
         runs ``claude-watch active-agents --json --write-state``. Read
         first because it's cheap (one open + json.load) and always
         current within ~60s on canonical homelab deploys.

      2. Binary fallback (``CLAUDE_AGENTS_STATE_FALLBACK_BIN``) — when
         the state file is missing / unreadable / empty AND the
         ``claude-watch`` binary is on PATH, shell out to
         ``claude-watch active-agents --json`` and parse the result.
         This is the bootstrap / container-deploy path where no cron
         exists. Idempotent: walks the JSONL trees in
         ``~/.claude/projects/<host>/<session>/subagents/`` and prints
         the same JSON shape the cron would publish.

    The fallback is opt-out: set ``CLAUDE_AGENTS_STATE_FALLBACK_BIN=""``
    (or ``"0"``) to disable, which matches the pre-fallback behavior
    (skip archive when the state file is missing).

    Failures inside the fallback are non-fatal — a missing binary,
    non-zero exit, or invalid JSON yields None so callers degrade to
    the historical "no agent record" stderr warning and skip the
    archive.
    """
    state = None
    try:
        with open(CLAUDE_AGENTS_STATE, "r") as f:
            state = json.load(f)
    except (OSError, json.JSONDecodeError):
        state = None
    if isinstance(state, dict) and state.get("agents"):
        return state

    # State file missing / empty / unreadable — try the binary fallback.
    fallback_bin = CLAUDE_AGENTS_STATE_FALLBACK_BIN
    if not fallback_bin or fallback_bin in ("0", "false", "False"):
        return state if isinstance(state, dict) else None

    # Resolve once. shutil.which() avoids a misleading FileNotFoundError
    # traceback for the common "no claude-watch on PATH" case.
    resolved = shutil.which(fallback_bin)
    if resolved is None:
        return state if isinstance(state, dict) else None

    try:
        # 10s cap — the FS walk is typically <500ms even on busy hosts.
        # capture both streams so a verbose stderr from the binary
        # doesn't bleed into our own stderr (callers print their own
        # diagnostic).
        r = subprocess.run(
            [resolved, "active-agents", "--json"],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return state if isinstance(state, dict) else None
    if r.returncode != 0:
        return state if isinstance(state, dict) else None

    try:
        live = json.loads(r.stdout)
    except (ValueError, TypeError):
        return state if isinstance(state, dict) else None
    if not isinstance(live, dict):
        return state if isinstance(state, dict) else None
    return live


def _agent_id_for_queue(queue_id):
    """Look up the spawned agent_id for a queue item via claude-watch state.

    Returns the agent_id string, or None if no record is locatable for
    ``queue_id``. Uses ``_load_active_agents_state`` (state-file with
    binary fallback) so container deploys without the cron-written
    state file still get a current agent map by invoking
    ``claude-watch active-agents --json`` inline.

    Dedup rule when the same queue_id appears on multiple records
    mirrors ``claude_agents.agents_by_queue_id``: live > stale; among
    same liveness, smaller jsonl_age_seconds wins.
    """
    state = _load_active_agents_state()
    if not isinstance(state, dict):
        return None
    best = None
    for rec in state.get("agents", []) or []:
        if not isinstance(rec, dict):
            continue
        if rec.get("queue_id") != queue_id:
            continue
        if best is None:
            best = rec
            continue
        b_alive = bool(best.get("alive"))
        r_alive = bool(rec.get("alive"))
        if r_alive and not b_alive:
            best = rec
            continue
        if r_alive == b_alive:
            b_age = best.get("jsonl_age_seconds")
            r_age = rec.get("jsonl_age_seconds")
            if r_age is not None and (b_age is None or r_age < b_age):
                best = rec
    if best is None:
        return None
    aid = best.get("agent_id")
    return aid if isinstance(aid, str) and aid else None


def _live_agent_for_queue(queue_id):
    """Return the agent_id of a LIVE spawned agent bound to ``queue_id``, else None.

    Distinct from ``_agent_id_for_queue`` (which returns the best-ranked
    record even when the agent is dead/stale): here we report an agent id
    ONLY when the active-agents state marks it ``alive``. Used by
    ``queue update`` to decide whether editing an item's task spec would be
    futile — a LIVE agent is already executing against the old description,
    so rewriting it in place is meaningless. A pending item (no binding) or a
    registered-but-not-yet-spawned item (no live agent record) returns None
    and is a valid update target.

    Fails soft: a missing/unreadable state file yields None (treated as "no
    live agent"), matching the rest of the archive/resurrect machinery. The
    guard is therefore advisory when claude-watch state is unavailable; the
    honest signal (a live agent) is what triggers the refusal.
    """
    state = _load_active_agents_state()
    if not isinstance(state, dict):
        return None
    for rec in state.get("agents", []) or []:
        if not isinstance(rec, dict):
            continue
        if rec.get("queue_id") != queue_id:
            continue
        if bool(rec.get("alive")):
            aid = rec.get("agent_id")
            if isinstance(aid, str) and aid:
                return aid
    return None


def _find_agent_jsonl(agent_id):
    """Locate the most-recent JSONL transcript for ``agent_id``.

    Layout::
        <CLAUDE_AGENTS_JSONL_ROOT>/<session-uuid>/subagents/agent-<id>.jsonl

    Returns a ``Path`` or None. Path-traversal-safe: agent_id is matched
    against a strict regex before any filesystem walk. Multiple project
    roots (e.g. one per cwd token) are supported by setting
    ``CLAUDE_AGENTS_JSONL_ROOT`` to the parent — we walk one level deep
    looking for ``subagents/`` containers.
    """
    if not isinstance(agent_id, str):
        return None
    if not re.match(r"^[a-z0-9-]{4,64}$", agent_id):
        return None
    root = CLAUDE_AGENTS_JSONL_ROOT
    if not root.is_dir():
        return None
    needle = f"agent-{agent_id}.jsonl"
    best = None  # (mtime, path)
    # Two-level walk: <root>/<host-token>/<session>/subagents/<file>, OR
    # <root>/<session>/subagents/<file> (the gomorrah deploy mounts the
    # host-token level directly so the session is one level down). Try
    # both shapes — first hit wins per session-uuid, then we rank by mtime.
    candidates_dirs = [root]
    try:
        for child in root.iterdir():
            if child.is_dir():
                candidates_dirs.append(child)
    except OSError:
        return None
    seen = set()
    for d in candidates_dirs:
        try:
            sessions = list(d.iterdir())
        except OSError:
            continue
        for sess in sessions:
            candidate = sess / "subagents" / needle
            if candidate in seen:
                continue
            seen.add(candidate)
            try:
                mt = candidate.stat().st_mtime
            except OSError:
                continue
            if best is None or mt > best[0]:
                best = (mt, candidate)
    return best[1] if best else None


def _find_transcripts_for_queue_marker(queue_id, *, freshness_secs=24 * 60 * 60):
    """Locate JSONL transcripts whose contents reference ``Queue item: <queue_id>``.

    Walks the same two-level layouts as ``_find_agent_jsonl``:

        <CLAUDE_AGENTS_JSONL_ROOT>/<session-uuid>/subagents/agent-<id>.jsonl
        <CLAUDE_AGENTS_JSONL_ROOT>/<host-token>/<session-uuid>/subagents/agent-<id>.jsonl

    Mirrors the multi-dir resolver approach used by claude-watch's Rust
    ``find_active_subagents_dirs`` (src/active_agents.rs): when the parent
    Claude process crashes + resumes, surviving subagents write
    continuation frames into a fresh session-uuid dir under a new project
    slug. The original `Queue item: q-XXXX` marker lives ONLY in the
    pre-restart transcript; the continuation file's first frame is a
    `tool_result` (exit-code reply from the dead parent). Resurrect needs
    the ORIGINAL spawn prompt, not the degraded continuation, so we walk
    every recent subagents dir and grep for the marker.

    Returns a list of ``Path`` objects whose contents contain the literal
    marker, sorted by mtime ASCENDING (oldest first). The oldest is the
    original spawn; later mtimes are post-restart continuations. Callers
    that want the original prompt should consume `[0]`.

    ``freshness_secs`` caps how far back to scan (default 24h, matching
    ``DEFAULT_SUBAGENTS_DIR_FRESHNESS_SECS`` in src/active_agents.rs).
    A file is included iff its mtime is within the window OR the queue id
    is rare enough that operator override should still surface it; in
    practice we apply the window because stale transcripts on the gomorrah
    deploy easily exceed 100MB+ and grepping all history is wasteful.
    """
    if not isinstance(queue_id, str) or not queue_id:
        return []
    if not re.match(r"^q-[a-z0-9-]{4,64}$", queue_id):
        return []
    root = CLAUDE_AGENTS_JSONL_ROOT
    if not root.is_dir():
        return []
    needle = f"Queue item: {queue_id}"
    now = datetime.now(timezone.utc).timestamp()
    hits = []  # (mtime, path)
    # Same two-level walk as _find_agent_jsonl.
    candidate_roots = [root]
    try:
        for child in root.iterdir():
            if child.is_dir():
                candidate_roots.append(child)
    except OSError:
        return []
    seen = set()
    for d in candidate_roots:
        try:
            sessions = list(d.iterdir())
        except OSError:
            continue
        for sess in sessions:
            sub = sess / "subagents"
            if not sub.is_dir():
                continue
            try:
                files = list(sub.iterdir())
            except OSError:
                continue
            for f in files:
                if not f.name.startswith("agent-") or not f.name.endswith(".jsonl"):
                    continue
                if f in seen:
                    continue
                seen.add(f)
                try:
                    st = f.stat()
                except OSError:
                    continue
                age = now - st.st_mtime
                if age > freshness_secs:
                    continue
                # Substring scan: faster than json-parse-every-line. The
                # marker is short and unique enough that false positives
                # in raw JSONL content are vanishingly unlikely.
                try:
                    with open(f, "r", encoding="utf-8", errors="replace") as fh:
                        for line in fh:
                            if needle in line:
                                hits.append((st.st_mtime, f))
                                break
                except OSError:
                    continue
    # Oldest first. The pre-restart transcript carries the marker; any
    # later continuation re-citing the marker in a follow-up user message
    # would still sort behind it.
    hits.sort(key=lambda t: t[0])
    return [p for _, p in hits]


def _registering_subagent_agent_id(queue_id, *, freshness_secs=600):
    """Best-effort resolve the agent_id of the subagent invoking ``register``.

    Owner-attribution fix (#3615/#3617). The spawn-time
    ``post-tool-agent-arm-hook`` (PostToolUse:Agent) binds
    ``agent_id -> queue_id`` only for the ORIGINAL spawn marker. When an
    agent is RESUMED onto a ROTATED queue id (e.g. a d6cb -> e8cd rebind)
    via a mid-flight ``session-task queue register``, no PostToolUse:Agent
    hook re-fires, so the new item never gets an owner and the dashboard
    reports "owner unknown" though the agent is actively running it. This
    resolves the invoking subagent so ``register`` can stamp the item's
    true owner.

    Mechanism (same transcript layout as ``_find_agent_jsonl`` /
    ``_find_transcripts_for_queue_marker``): Claude Code flushes the
    assistant tool_use frame -- which literally contains the
    ``session-task queue register <queue_id>`` command string -- into the
    subagent's JSONL transcript BEFORE the Bash tool executes. So at
    register time the freshly-modified subagent transcript already
    references this brand-new queue id, and the ONLY subagent transcript
    referencing it is the current agent's (the main loop that created the
    id runs in the top-level session, NOT under a ``subagents/`` dir). We
    scan recently-modified subagent transcripts newest-first and return the
    agent_id of the first one whose contents mention the id.

    Returns None (a SAFE no-op for the caller) when:
      * invoked from the MAIN LOOP -- its transcript is not under a
        ``subagents/`` dir, so nothing matches -> no stamp;
      * a genuine FIRST spawn -- the agent does not exist yet at register
        time, so no transcript references the id -> no stamp (the arm-hook
        will bind it after the Agent tool returns);
      * the transcript root is missing / unreadable.

    Cost is bounded by ``freshness_secs`` (only transcripts touched within
    that window are content-scanned; the invoking agent's transcript was
    touched ~now, so newest-first ordering makes it the first hit). Never
    raises -- fail-soft to None so a resolver hiccup can never wedge a
    register.
    """
    if not isinstance(queue_id, str) or not re.match(
        r"^q-[a-z0-9-]{4,64}$", queue_id
    ):
        return None
    root = CLAUDE_AGENTS_JSONL_ROOT
    try:
        if not root.is_dir():
            return None
    except OSError:
        return None
    now = datetime.now(timezone.utc).timestamp()
    name_re = re.compile(r"^agent-([a-z0-9-]{4,64})\.jsonl$")
    # Same two-level walk as _find_transcripts_for_queue_marker:
    #   <root>/<session-uuid>/subagents/agent-<id>.jsonl
    #   <root>/<host-token>/<session-uuid>/subagents/agent-<id>.jsonl
    candidate_roots = [root]
    try:
        for child in root.iterdir():
            if child.is_dir():
                candidate_roots.append(child)
    except OSError:
        return None
    entries = []  # (mtime, agent_id, path)
    seen = set()
    for d in candidate_roots:
        try:
            sessions = list(d.iterdir())
        except OSError:
            continue
        for sess in sessions:
            sub = sess / "subagents"
            try:
                if not sub.is_dir():
                    continue
                files = list(sub.iterdir())
            except OSError:
                continue
            for f in files:
                if f in seen:
                    continue
                seen.add(f)
                m = name_re.match(f.name)
                if not m:
                    continue
                try:
                    st = f.stat()
                except OSError:
                    continue
                if now - st.st_mtime > freshness_secs:
                    continue
                entries.append((st.st_mtime, m.group(1), f))
    # Newest-first: the invoking agent's transcript was just written, so it
    # sorts first and short-circuits the scan on the common path.
    entries.sort(key=lambda e: e[0], reverse=True)
    # Read only the TAIL of each candidate. The reference we care about (the
    # register tool_use frame, plus any recent inbox/agent-msg read that
    # cited the rotated id) is always among the most-recent writes, so a
    # bounded tail suffices AND keeps this off the critical path even when a
    # transcript is huge (gomorrah transcripts routinely exceed 100MB, per
    # _find_transcripts_for_queue_marker). needle is ASCII, so a mid-char
    # seek can't corrupt a match within the window.
    tail_bytes = 512 * 1024
    for _mt, aid, f in entries:
        try:
            size = f.stat().st_size
            with open(f, "rb") as fh:
                if size > tail_bytes:
                    fh.seek(size - tail_bytes)
                chunk = fh.read()
            if queue_id in chunk.decode("utf-8", errors="replace"):
                return aid
        except OSError:
            continue
    return None


def _archive_agent_transcript(item, *, reason="done"):
    """Best-effort archive of the spawning subagent's JSONL transcript.

    Called from cmd_queue_done / cmd_queue_abandon BEFORE the queue write
    is finalized, so the resulting ``log_archive_path`` field is persisted
    into queue.json alongside the status transition. Failures are non-
    fatal: missing claude-watch state, missing JSONL, or copy errors all
    log to stderr and return None — the lifecycle transition completes
    regardless. We never raise from inside here.

    Idempotent: if the archive file already exists for this queue id we
    leave it alone (the first archive wins) and return its relative
    path. Subsequent calls are a no-op.

    Returns the relative-to-archive-dir filename (e.g. "q-XXXX.jsonl") on
    success, or None on failure. The caller stores this on the item as
    ``log_archive_path`` so a queue viewer UI can detect that an archive
    exists and offer a "View log" affordance.
    """
    qid = item.get("id")
    if not isinstance(qid, str) or not qid:
        return None

    if not re.match(r"^q-[a-z0-9-]{4,64}$", qid):
        return None

    archive_name = f"{qid}.jsonl"
    dest = QUEUE_LOG_ARCHIVE_DIR / archive_name

    # Idempotent: never overwrite. The first archive (typically created
    # at done-time) wins; a later abandon would otherwise clobber the
    # canonical transcript with a partial copy if the agent dirtied the
    # file between transitions.
    if dest.exists():
        return archive_name

    aid = _agent_id_for_queue(qid)
    if aid is None:
        print(
            f"[archive] no agent record for {qid}; skipping transcript archive ({reason})",
            file=sys.stderr,
        )
        return None

    src = _find_agent_jsonl(aid)
    if src is None:
        print(
            f"[archive] no transcript file found for {qid} agent={aid}; "
            f"checked {CLAUDE_AGENTS_JSONL_ROOT} ({reason})",
            file=sys.stderr,
        )
        return None

    try:
        QUEUE_LOG_ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(
            f"[archive] failed to create {QUEUE_LOG_ARCHIVE_DIR}: {exc}",
            file=sys.stderr,
        )
        return None

    try:
        shutil.copyfile(src, dest)
    except OSError as exc:
        print(
            f"[archive] copy failed {src} -> {dest}: {exc}",
            file=sys.stderr,
        )
        return None

    print(
        f"[archive] {qid} -> {archive_name} (from agent={aid}, reason={reason})",
        file=sys.stderr,
    )
    return archive_name


def _extract_workload_label(scope):
    """Return the bare workload label encoded in a scope list, or None.

    `workload run <label>` creates a queue item with scope
    `["workload:<label>"]`. Mirrors the canonical extractor in
    queue-minisite/app.py — kept inline here so this script stays
    stdlib-only and the two implementations agree on the regex gate.

    Returns the bare label string (e.g. ``"saoirse-logical-200x"``) or
    None if the scope contains no `workload:` token, the token is
    malformed, or the value isn't a list. We honor only the FIRST match
    — multi-binding would be a bug elsewhere we don't paper over here.
    """
    if not isinstance(scope, list):
        return None
    for s in scope:
        if not isinstance(s, str):
            continue
        if not s.startswith("workload:"):
            continue
        label = s[len("workload:"):]
        if _WORKLOAD_LABEL_RE.match(label):
            return label
    return None


def _archive_workload_output(item, *, reason="done"):
    """Best-effort archive of a workload-bound queue item's stdout file.

    Workload-driven queue items (created by `workload run <label>`) carry
    scope `["workload:<label>"]` and have NO entry in the active-agents
    map (workloads aren't subagents). Their stdout/stderr lands in
    ``WORKLOAD_OUTPUT_DIR/<label>.output`` (default
    ``/tmp/claude-workloads/<label>.output``) which is on tmpfs and gets
    cleaned up. To make historical workload logs survive /tmp cleanup +
    session restart the same way subagent JSONL transcripts do, this
    helper copies that file into ``QUEUE_LOG_ARCHIVE_DIR`` at queue-done
    / queue-abandon time.

    Lifecycle / safety contract — mirrors ``_archive_agent_transcript``:

    * Best-effort. Missing source file or copy errors log to stderr and
      return None — the lifecycle transition completes regardless.
    * Idempotent on dest existence: if the archive already exists for
      this queue id we leave it alone (first archive wins) and return
      its relative path.
    * Path-traversal-safe. Both the queue id and the workload label are
      regex-gated before any filesystem walk.

    Returns the relative-to-archive-dir filename
    (``"<qid>.workload.txt"``) on success, or None on failure /
    not-applicable. The caller stores this on the item as
    ``log_archive_path`` (same field used by the agent variant — the
    suffix differentiates the on-disk format for downstream readers).
    """
    qid = item.get("id")
    if not isinstance(qid, str) or not qid:
        return None

    if not re.match(r"^q-[a-z0-9-]{4,64}$", qid):
        return None

    label = _extract_workload_label(item.get("scope") or [])
    if label is None:
        # Not a workload item — nothing to archive here. Caller will
        # have separately tried the agent-transcript variant.
        return None

    archive_name = f"{qid}.workload.txt"
    dest = QUEUE_LOG_ARCHIVE_DIR / archive_name

    # Idempotent: never overwrite. Same rule as the agent variant.
    if dest.exists():
        return archive_name

    src = WORKLOAD_OUTPUT_DIR / f"{label}.output"
    if not src.is_file():
        print(
            f"[archive] no workload output file for {qid} label={label}; "
            f"checked {src} ({reason})",
            file=sys.stderr,
        )
        return None

    try:
        QUEUE_LOG_ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(
            f"[archive] failed to create {QUEUE_LOG_ARCHIVE_DIR}: {exc}",
            file=sys.stderr,
        )
        return None

    try:
        shutil.copyfile(src, dest)
    except OSError as exc:
        print(
            f"[archive] copy failed {src} -> {dest}: {exc}",
            file=sys.stderr,
        )
        return None

    print(
        f"[archive] {qid} -> {archive_name} (from workload={label}, reason={reason})",
        file=sys.stderr,
    )
    return archive_name


def _archive_for_item(item, *, reason="done"):
    """Dispatch to the appropriate archive helper for ``item``.

    Workload-bound items (scope contains ``workload:<label>``) get the
    workload-output archive. Everything else falls through to the agent
    transcript archive. The two are mutually exclusive — workload items
    have no active-agent record by construction.

    Returns the archive filename (relative to ``QUEUE_LOG_ARCHIVE_DIR``)
    or None. Best-effort: failures inside the helpers are non-fatal and
    surface only as stderr warnings. Caller stamps ``log_archive_path``
    on the item with whatever we return.
    """
    if _extract_workload_label(item.get("scope") or []) is not None:
        return _archive_workload_output(item, reason=reason)
    return _archive_agent_transcript(item, reason=reason)


# ---------------------------------------------------------------------------
# Force-start autostop + recovery bundle (added 2026-05-02)
# ---------------------------------------------------------------------------
#
# When `queue force-start q-X` flips a blocked-pending item to running, any
# OTHER running item whose scope overlaps q-X's scope is now (per Andrew's
# 2026-05-02 21:10 UTC directive) auto-abandoned and its recovery context
# captured for the new agent to triage. The interrupter (the new agent)
# decides resume/integrate/stash/abandon — we do NOT auto-stash. We just
# bundle up the breadcrumbs so the next operator has the full picture.


def _extract_repo_paths_from_scope(scope_tokens):
    """Map scope tokens to local git-repo working-tree paths (best effort).

    Scope tokens we know how to map:
        ``repo:NAME``    -> ``~/repos/NAME`` (if present and a git repo)
        ``file:PATH``    -> nearest enclosing git repo root for PATH

    Tokens that don't resolve are silently dropped — the recovery bundle
    is always best-effort.
    """
    home = Path.home()
    repos_root = home / "repos"
    out = []
    seen = set()

    def _git_root(path):
        # Walk up looking for a `.git` directory. Capped at 8 levels to
        # avoid pathological filesystems eating cycles.
        p = Path(path)
        for _ in range(8):
            if (p / ".git").exists():
                return p
            if p.parent == p:
                return None
            p = p.parent
        return None

    for token in scope_tokens or []:
        if not isinstance(token, str):
            continue
        if token.startswith("repo:"):
            name = token[len("repo:"):].strip()
            if not name:
                continue
            cand = repos_root / name
            if (cand / ".git").exists() or cand.is_dir():
                if str(cand) in seen:
                    continue
                seen.add(str(cand))
                out.append(cand)
        elif token.startswith("file:"):
            raw = token[len("file:"):].strip()
            if not raw:
                continue
            # Expand ~ if present (scope tokens can include user-home paths).
            try:
                p = Path(os.path.expanduser(raw))
            except Exception:
                continue
            if not p.exists():
                # The path itself may be gone; still try to walk up the
                # parent chain to find a repo root.
                p = p.parent
            root = _git_root(p)
            if root is None:
                continue
            if str(root) in seen:
                continue
            seen.add(str(root))
            out.append(root)
        # `resource:` tokens are abstract (e.g. resource:hardware) — no
        # local working tree to snapshot. Skipped.

    return out


def _git_status_and_diff(repo_path, *, max_diff_chars=200_000):
    """Capture porcelain status + unified diff for a git repo, best-effort.

    Returns a dict ``{"path": str, "status": str, "diff": str,
    "diff_truncated": bool}`` or None on hard failure (not a repo).

    The diff is capped at ``max_diff_chars`` so a runaway uncommitted
    binary blob can't blow up the bundle file. ``diff_truncated`` flags
    truncation.
    """
    repo_path = Path(repo_path)
    git_dir = repo_path / ".git"
    if not git_dir.exists():
        return None

    def _run_git(*argv):
        try:
            r = subprocess.run(
                ["git", "-C", str(repo_path), *argv],
                capture_output=True,
                text=True,
                timeout=15,
            )
            if r.returncode != 0:
                return ""
            return r.stdout
        except Exception:
            return ""

    status = _run_git("status", "--porcelain=v1", "--untracked-files=normal")
    diff = _run_git("diff", "--no-color")
    truncated = False
    if len(diff) > max_diff_chars:
        diff = diff[:max_diff_chars]
        truncated = True

    return {
        "path": str(repo_path),
        "status": status,
        "diff": diff,
        "diff_truncated": truncated,
    }


def _agent_jsonl_path_for_queue(queue_id):
    """Resolve the live ``agent-<id>.jsonl`` path for a running queue item.

    Returns ``Path`` or None. This is the live (in-progress) transcript
    of the agent that owns the queue id, distinct from the archived copy
    at QUEUE_LOG_ARCHIVE_DIR/<qid>.jsonl that lands at done/abandon time.
    """
    aid = _agent_id_for_queue(queue_id)
    if aid is None:
        return None
    return _find_agent_jsonl(aid)


def _read_first_user_prompt_from_jsonl(jsonl_path, *, max_chars=20_000):
    """Pull the FIRST user message out of an agent's JSONL transcript.

    The first non-sidechain user record is the original Agent-tool prompt
    (the prompt the main loop dispatched the subagent with). We walk
    forward until we find a record where ``message.role == "user"`` and
    ``message.content`` is a string (or a list of content blocks we can
    flatten to text). Returns the text, capped at ``max_chars``, or None
    if the file is missing / unreadable / has no user message.
    """
    if jsonl_path is None:
        return None
    try:
        with open(jsonl_path, "r") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except (json.JSONDecodeError, ValueError):
                    continue
                msg = rec.get("message")
                if not isinstance(msg, dict):
                    continue
                if msg.get("role") != "user":
                    continue
                content = msg.get("content")
                text = None
                if isinstance(content, str):
                    text = content
                elif isinstance(content, list):
                    pieces = []
                    for blk in content:
                        if isinstance(blk, dict) and blk.get("type") == "text":
                            t = blk.get("text")
                            if isinstance(t, str):
                                pieces.append(t)
                    if pieces:
                        text = "\n".join(pieces)
                if text is None:
                    continue
                truncated = False
                if len(text) > max_chars:
                    text = text[:max_chars]
                    truncated = True
                return {"text": text, "truncated": truncated}
    except OSError:
        return None
    return None


def _capture_recovery_for_item(item):
    """Build the recovery dict for one autostopped peer queue item.

    Captures: queue id/group/desc/summary/scope, the agent's live JSONL
    path, the original prompt (best-effort extracted), the
    /tmp/claude-1000/.../tasks/<aid>.output path (if any), and per-repo
    git status + diff for every repo we can resolve from the item's
    scope tokens. None of these are required — every field defaults to
    None or [] on failure so the bundle is always serialisable.
    """
    qid = item.get("id")
    aid = _agent_id_for_queue(qid) if qid else None

    jsonl_path = _find_agent_jsonl(aid) if aid else None
    prompt = _read_first_user_prompt_from_jsonl(jsonl_path) if jsonl_path else None

    # Best-effort guess at the .output path — the harness writes one per
    # task at /tmp/claude-1000/-home-<user>/<session-uuid>/tasks/<aid>.output
    # but the agent_id we resolve here uses claude-watch's `a*` form. The
    # task-id is the same string post-prefix. We surface the directory we
    # think it lives in rather than asserting — the new agent can ls it.
    task_output_path = None
    if aid:
        candidates = []
        try:
            user = os.environ.get("USER", "hndrewaall")
            uid = os.environ.get("UID") or os.getuid()
            roots = [
                Path(f"/tmp/claude-{uid}/-home-{user}"),
            ]
            for r in roots:
                if not r.is_dir():
                    continue
                # Look for <session>/tasks/<aid>.output and tasks/<aid>.output
                for sess in [r] + list(r.iterdir()):
                    if not sess.is_dir():
                        continue
                    cand = sess / "tasks" / f"{aid}.output"
                    if cand.exists():
                        candidates.append(cand)
        except Exception:
            candidates = []
        if candidates:
            # Most-recent wins
            candidates.sort(key=lambda p: p.stat().st_mtime, reverse=True)
            task_output_path = str(candidates[0])

    repos = _extract_repo_paths_from_scope(item.get("scope", []))
    repo_snapshots = []
    for r in repos:
        snap = _git_status_and_diff(r)
        if snap is not None:
            repo_snapshots.append(snap)

    return {
        "queue_id": qid,
        "group_id": item.get("group_id"),
        "scope": list(item.get("scope", [])),
        "summary": _item_summary(item),
        "description": item.get("description", ""),
        "agent_id": aid,
        "agent_jsonl_path": str(jsonl_path) if jsonl_path else None,
        "task_output_path": task_output_path,
        "original_prompt": prompt,
        "repo_snapshots": repo_snapshots,
        "started_at": item.get("started_at"),
        "registered_at": item.get("registered_at"),
        "created_by": item.get("created_by", ""),
    }


def _agent_kill_best_effort(agent_id):
    """Try to kill the agent process tree for ``agent_id`` via claude-watch.

    Returns a dict describing the outcome (success, missing tool, no live
    process, error). Never raises. Agents between API calls (no live
    bash child) silently no-op — the obligations gate + abandoned queue
    row are sufficient to neutralise them on their next tool call.
    """
    if not isinstance(agent_id, str) or not agent_id:
        return {"ok": False, "reason": "no agent_id"}
    cli = shutil.which("claude-watch") or shutil.which("agent-ctl")
    if not cli:
        return {"ok": False, "reason": "claude-watch CLI not on PATH"}
    try:
        r = subprocess.run(
            [cli, "agent", "kill", agent_id],
            capture_output=True,
            text=True,
            timeout=15,
        )
        return {
            "ok": r.returncode == 0,
            "exit_code": r.returncode,
            "stdout": r.stdout[-500:],
            "stderr": r.stderr[-500:],
        }
    except Exception as exc:  # noqa: BLE001 -- best-effort
        return {"ok": False, "reason": f"exception: {exc.__class__.__name__}: {exc}"}


def _autostop_overlapping_peers(items, target, *, raw_reason):
    """Mark every running scope-overlapping peer of ``target`` as abandoned.

    Mutates ``items`` in place: each conflicting peer's status flips to
    ``abandoned`` with a clear ``abandon_reason`` explaining the override.
    Recovery bundles are captured BEFORE the mutation so we still have
    access to the running-state agent_id. Returns a list of bundle dicts
    (one per autostopped peer); callers persist them into the q-X bundle
    file and emit them in the claude-event.

    Best-effort agent kill is attempted for each abandoned peer. Failures
    are recorded inside the bundle (``agent_kill_outcome``) but never
    block the queue write — the abandon row + the obligations gate are
    sufficient to halt the agent on its next tool call regardless.

    Same atomic semantics as the surrounding flock — the caller (cmd_queue
    _force_start) holds the queue lock for this entire window.
    """
    target_id = target.get("id")
    target_scope = target.get("scope", [])
    abandoned_at = _fmt_ts()
    bundles = []
    for peer in items:
        if peer is target:
            continue
        if peer.get("id") == target_id:
            continue
        if peer.get("status") not in RUNNING_STATUSES:
            continue
        if not _scope_sets_overlap(
            _serializing_scope(peer.get("scope", [])),
            _serializing_scope(target_scope),
        ):
            continue

        # Capture BEFORE mutating: _agent_id_for_queue uses claude-watch's
        # active-agents.json which is keyed on queue_id, so the lookup
        # works either way, but we want to snapshot the running state for
        # downstream debugging.
        bundle = _capture_recovery_for_item(peer)

        # Best-effort kill (recorded in the bundle, never fatal).
        if bundle.get("agent_id"):
            bundle["agent_kill_outcome"] = _agent_kill_best_effort(
                bundle["agent_id"],
            )
        else:
            bundle["agent_kill_outcome"] = {
                "ok": False,
                "reason": "no agent_id resolved from active-agents.json",
            }

        # Mutate the peer record. Mirror the abandon-reason convention
        # used by cmd_queue_abandon so anything reading abandoned_reason
        # gets a uniform shape.
        peer["status"] = "abandoned"
        peer["abandoned_at"] = abandoned_at
        peer["abandon_reason"] = (
            f"autostopped by force-start of {target_id}: {raw_reason}"
        )
        peer["group_head"] = False
        peer["autostopped_by_force_start"] = target_id

        # Archive the spawning subagent's transcript (or workload output,
        # for workload-bound items) inside the queue lock window so the
        # archive lands BEFORE the queue.json write that transitions the
        # row to abandoned. _archive_for_item dispatches by scope and is
        # idempotent + best-effort.
        archive_path = _archive_for_item(peer, reason="autostop-force-start")
        if archive_path:
            peer["log_archive_path"] = archive_path

        bundle["abandoned_at"] = abandoned_at
        bundle["abandon_reason"] = peer["abandon_reason"]
        bundle["log_archive_path"] = peer.get("log_archive_path")

        bundles.append(bundle)

    return bundles


def _write_force_start_bundle(target_id, target_summary, raw_reason,
                              autostop_bundles):
    """Persist the per-force-start recovery bundle file.

    Path: ``FORCE_START_BUNDLE_DIR / <target_id>.json``. Idempotent: if
    the file already exists (rare — same q-X being force-started twice)
    we overwrite. The new agent's prompt should reference this path.

    Returns the path string on success, None on failure. Best-effort:
    failures log to stderr but never block the force-start.
    """
    if not isinstance(target_id, str) or not target_id:
        return None
    payload = {
        "schema_version": 1,
        "force_started_queue_id": target_id,
        "force_started_summary": target_summary,
        "force_started_reason": raw_reason,
        "force_started_at": _fmt_ts(),
        "autostopped_peers": autostop_bundles,
    }
    try:
        FORCE_START_BUNDLE_DIR.mkdir(parents=True, exist_ok=True)
        dest = FORCE_START_BUNDLE_DIR / f"{target_id}.json"
        # Atomic write via tmp+rename so a partial bundle never leaves a
        # corrupted file behind.
        tmp = dest.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(payload, indent=2) + "\n")
        os.replace(tmp, dest)
        return str(dest)
    except OSError as exc:
        print(
            f"[force-start] failed to write recovery bundle for {target_id}: {exc}",
            file=sys.stderr,
        )
        return None


def cmd_queue_add(args):
    scope_raw = args.scope or []
    if not scope_raw:
        print("ERROR: at least one --scope required (e.g. --scope '*')", file=sys.stderr)
        sys.exit(1)
    # Split each --scope value on commas so callers can pass either
    #   --scope foo --scope bar
    # or
    #   --scope foo,bar
    # interchangeably. Whitespace around tokens is stripped (in case anyone
    # writes `--scope foo, bar`). Empty fragments (e.g. trailing comma) are
    # dropped. Andrew flagged 2026-04-27 after q-3dfa silently failed to
    # serialize behind q-8106 because the comma-joined scope was stored as a
    # single opaque token, making exact-match conflict detection miss it.
    scope_split = []
    seen_split = set()
    for raw in scope_raw:
        for piece in raw.split(","):
            piece = piece.strip()
            if not piece:
                continue
            if piece in seen_split:
                continue
            seen_split.add(piece)
            scope_split.append(piece)
    if not scope_split:
        print("ERROR: at least one --scope required (e.g. --scope '*')", file=sys.stderr)
        sys.exit(1)
    try:
        scope = [_normalize_token(t) for t in scope_split]
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    # ------------------------------------------------------------------
    # Validate `repo:<name>` scope tokens against the configured repos dir.
    # Andrew (botchat #2043): the main loop kept INVENTING repo scope names
    # matching no real repo dir, so agents meant to serialize on the same
    # repo used different scope names and DIDN'T serialize. A `repo:<name>`
    # token must name an actual directory in SESSION_TASK_REPOS_DIR (default
    # ~/repos). Only the `repo:` prefix is validated; fail-open when the
    # repos dir is absent; bypass via SESSION_TASK_REPOS_NO_VALIDATE=1.
    # ------------------------------------------------------------------
    try:
        _validate_repo_scope_tokens(scope)
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    # ------------------------------------------------------------------
    # Hard-fail: manual queueing of a `workload:<label>` scope.
    #
    # The `workload run <label>` runner auto-creates a queue item with
    # scope `["workload:<label>"]` itself (see workload.rs
    # `auto_create_and_register_queue_item`). When a caller ALSO queues
    # a `workload:<label>` item manually before invoking `workload run`,
    # the labels can drift (workload:promote-ready-oa-pitt vs
    # workload:promote-oa-pitt) and two parallel queue rows end up
    # tracking the same tmux pane. Andrew flagged the double-row on
    # the queue minisite 2026-05-19 (sig_ts 1779225355734):
    # "can you update tooling so it's hard if not impossible to do
    # the manual queueing when you shouldnt".
    #
    # Refuse with exit 3 + ALL CAPS stderr banner (mirrors the existing
    # SPAWN-CHECK FAILED + REGISTER REFUSED bands). Bypass:
    #   * `--force-enqueue` flag — the workload runner itself already
    #     passes this on its auto-add call, so the runner path is
    #     unaffected; legacy CLI users invoking `queue add` manually
    #     for a workload: scope must pass it deliberately.
    #   * `QUEUE_GATE_BYPASS=1` env var — same emergency-bypass shape
    #     as the pre-agent-queue-gate hook.
    # ------------------------------------------------------------------
    workload_scopes = [t for t in scope if t.startswith("workload:")]
    if workload_scopes:
        force_bypass = bool(getattr(args, "force_enqueue", False))
        env_bypass = (
            os.environ.get("QUEUE_GATE_BYPASS", "").strip() not in ("", "0")
        )
        if not (force_bypass or env_bypass):
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(
                "!! QUEUE ADD REFUSED: MANUAL `workload:` SCOPE NOT ALLOWED.",
                file=sys.stderr,
            )
            print(
                "!! DO NOT MANUALLY QUEUE WORKLOAD SCOPES.",
                file=sys.stderr,
            )
            print(
                "!! USE `workload run <label> -- <cmd>` WHICH AUTO-CREATES",
                file=sys.stderr,
            )
            print(
                "!! THE QUEUE ITEM WITH THE CORRECT SCOPE + REGISTERS IT.",
                file=sys.stderr,
            )
            print("!!", file=sys.stderr)
            print(
                "!! Manual `workload:<label>` adds drift from the label",
                file=sys.stderr,
            )
            print(
                "!! the workload runner ACTUALLY uses, producing two",
                file=sys.stderr,
            )
            print(
                "!! parallel queue rows tracking one tmux pane.",
                file=sys.stderr,
            )
            print("!!", file=sys.stderr)
            print(
                f"!! OFFENDING TOKEN(S): {','.join(workload_scopes)}",
                file=sys.stderr,
            )
            print("!!", file=sys.stderr)
            print(
                "!! Emergency bypass (audited): `--force-enqueue` flag,",
                file=sys.stderr,
            )
            print(
                "!! or set `QUEUE_GATE_BYPASS=1` in the environment.",
                file=sys.stderr,
            )
            print(bar, file=sys.stderr)
            sys.exit(3)

    context = None
    if args.context:
        try:
            context = json.loads(args.context)
        except json.JSONDecodeError:
            print(f"ERROR: --context must be valid JSON: {args.context}", file=sys.stderr)
            sys.exit(1)

    # Soft-required one-line summary. Andrew 2026-04-19: "update queue
    # notifications to include one line summary. might have to require one
    # as input for task enqueuing ... like 10ish words long". We still accept
    # items without --summary (to avoid breaking legacy scripts / migration),
    # but we warn loudly to stderr so the caller notices. Pingme notifications
    # for items without a summary will read "(no summary)".
    summary = (args.summary or "").strip() or DEFAULT_SUMMARY
    if summary == DEFAULT_SUMMARY:
        print(
            "warning: no --summary provided; pingme notifications will say "
            "'(no summary)'. Pass --summary \"~10 word headline\" next time.",
            file=sys.stderr,
        )

    # ------------------------------------------------------------------
    # Add-time scope/target-repo heuristic (botchat #2346). WARN (never
    # reject) when the description/summary unambiguously names one repo the
    # --scope doesn't cover. Catches the `<org>/platform-html-to-pdf`-named
    # task scoped `repo:platform` case; stays silent on ambiguous text.
    # The enforcing gate is spawn-time (pre-agent-queue-gate-hook).
    # ------------------------------------------------------------------
    mismatch_warning = _scope_target_mismatch_warning(scope, args.description, summary)
    if mismatch_warning:
        print(f"warning: {mismatch_warning}", file=sys.stderr)

    # ------------------------------------------------------------------
    # Soft-serialize on running scope conflict: if any currently-running
    # item has overlapping scope, the new item is STILL enqueued — but
    # marked not-ready and recorded with the running peer(s) in
    # serialized_after, so the main loop will not spawn an agent for it
    # until the running peer finishes.
    #
    # History: Andrew 2026-04-17 asked for a "loud failure with all caps
    # and explicit instructions not to run" on add-time scope overlap.
    # That landed as a hard-fail (exit 3, "QUEUE ADD REFUSED" banner).
    # 2026-05-19 Andrew flagged the banner as misleading: enqueuing
    # behind active scope is normal serialization, not a refusal — the
    # only behavior we need to gate is the SPAWN, which the existing
    # ready_now=false + spawn-check exit-2 machinery already covers.
    # The banner now states the enqueue succeeded and tells the main
    # loop to wait for the running peer before spawning.
    # ------------------------------------------------------------------
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]

        # Parse --depends-on (comma-separated) and validate the targets
        # exist NOW. Each dep is materialized as a `task:<id>` scope token
        # (added 2026-05-08). The legacy `depends_on` field is no longer
        # written; the read-time migration in `_queue_open_locked`
        # translates pre-existing entries on next load.
        deps_raw = getattr(args, "depends_on", None) or []
        deps_split: list[str] = []
        seen_dep = set()
        for raw in deps_raw:
            for piece in str(raw).split(","):
                piece = piece.strip()
                if not piece:
                    continue
                if piece in seen_dep:
                    continue
                seen_dep.add(piece)
                deps_split.append(piece)
        # Pull any task: tokens already supplied via --scope into the same
        # bucket so they share validation + dedupe with --depends-on. We
        # leave them in the scope list either way; dedupe below ensures we
        # don't double-stamp.
        scope_task_targets: list[str] = []
        for tok in scope:
            tgt = _task_token_target(tok)
            if tgt and tgt not in seen_dep:
                seen_dep.add(tgt)
                scope_task_targets.append(tgt)
        all_dep_targets = deps_split + scope_task_targets
        if all_dep_targets:
            existing_ids_now = {it["id"] for it in items}
            unknown = [d for d in all_dep_targets if d not in existing_ids_now]
            if unknown:
                fcntl.flock(fh, fcntl.LOCK_UN)
                fh.close()
                print(
                    f"ERROR: --depends-on references unknown queue id(s): "
                    f"{','.join(unknown)}",
                    file=sys.stderr,
                )
                sys.exit(1)

        # Materialize --depends-on as task: scope tokens. Append rather
        # than prepend so user-supplied --scope ordering is preserved as
        # the head of the list. Skip targets already present as task:
        # tokens (so --scope task:q-A --depends-on q-A is a no-op union).
        existing_task_targets = {
            _task_token_target(t) for t in scope if _is_task_token(t)
        }
        for d in deps_split:
            if d not in existing_task_targets:
                scope.append(f"task:{d}")
                existing_task_targets.add(d)

        # Recompute deps_split from scope so downstream display reflects
        # the canonical dep set (--depends-on entries plus any task:
        # tokens that came in via --scope).
        deps_split = [
            _task_token_target(t) for t in scope if _is_task_token(t)
        ]

        running_conflicts = _running_scope_conflicts(items, scope)
        # Note: --force-enqueue is preserved as a no-op for back-compat
        # with callers that still pass it. The default path now also
        # enqueues, so the flag no longer changes behavior; it remains
        # accepted (and documented) to avoid breaking legacy scripts.

        overlapping = _group_ids_overlapping(items, scope)

        if len(overlapping) == 0:
            group_id = _new_group_id()
        elif len(overlapping) == 1:
            group_id = overlapping[0]
        else:
            # Merge all overlapping groups into a brand-new group.
            group_id = _new_group_id()
            for it in items:
                if it.get("group_id") in overlapping:
                    it["group_id"] = group_id
            log_completed(
                f"[queue merge] {len(overlapping)} groups merged into {group_id}",
                extra={
                    "source": "queue",
                    "event": "merge",
                    "merged_groups": overlapping,
                    "new_group_id": group_id,
                },
            )

        new_id = _new_id()
        # Ensure unique id even if secrets collides (vanishingly rare).
        existing_ids = {it["id"] for it in items}
        while new_id in existing_ids:
            new_id = _new_id()

        item = {
            "id": new_id,
            "description": args.description,
            "summary": summary,
            "scope": scope,
            "group_id": group_id,
            "group_head": False,
            "status": "pending",
            "priority": int(args.priority),
            "created_at": _fmt_ts(),
            "created_by": args.created_by or "main-loop",
        }
        if context is not None:
            item["context"] = context
        items.append(item)

        _recompute_group_heads(items)

        # Determine ready_now + serialized_after
        group_members_sorted = sorted(
            [it for it in _group_members(items, group_id) if it.get("status") == "pending"],
            key=_sort_key,
        )
        position = next((i + 1 for i, it in enumerate(group_members_sorted) if it["id"] == new_id), -1)
        locked_scopes = data.get("locked_scopes") or {}
        ready_now = _item_is_ready(items, item, locked_scopes=locked_scopes)
        lock_blockers = _locked_tokens_blocking_item(item, locked_scopes)
        serialized_after = [it["id"] for it in group_members_sorted if it["id"] != new_id and _sort_key(it) < _sort_key(item)]
        # Also consider in-flight (running or wedged) items in same group
        running_in_group = [it["id"] for it in _group_members(items, group_id) if it.get("status") in RUNNING_STATUSES]
        serialized_after = running_in_group + serialized_after

        _queue_write_and_unlock(fh, data)
    except Exception:
        try:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
        except Exception:
            pass
        raise

    # Surface unmet dependencies separately from scope-serialized blockers
    # so the main loop / UI can distinguish "wait for queue head" from
    # "wait for explicit dep". depends_on is the operator-declared edge.
    dep_blockers: list[str] = []
    if deps_split:
        items_by_id_now = {it["id"]: it for it in items}
        for d in deps_split:
            tgt = items_by_id_now.get(d)
            if tgt is None or tgt.get("status") != "done":
                dep_blockers.append(d)

    # Build spawn_instruction string for the main loop to read literally.
    if ready_now:
        spawn_instruction = f"READY: register-and-spawn (session-task queue register {new_id})"
    else:
        parts: list[str] = []
        if lock_blockers:
            parts.append("locks: " + ",".join(lock_blockers))
        if dep_blockers:
            parts.append("deps: " + ",".join(dep_blockers))
        if serialized_after:
            parts.append("queue: " + ",".join(serialized_after))
        if parts:
            spawn_instruction = "BLOCKED: do not spawn, wait for " + " | ".join(parts)
        else:
            spawn_instruction = "BLOCKED: do not spawn (no head visible)"

    # Print result. running_conflicts is populated whenever the new scope
    # overlapped a running peer; it no longer implies any error condition
    # (the item was enqueued and is correctly serialized behind the peer).
    running_conflict_info = [
        {"id": c["id"], "group_id": c.get("group_id"), "scope": c.get("scope", [])}
        for c in running_conflicts
    ]

    if args.json:
        print(json.dumps({
            "id": new_id,
            "group_id": group_id,
            "position": position,
            "ready_now": ready_now,
            "serialized_after": serialized_after,
            "depends_on": deps_split,
            "dep_blockers": dep_blockers,
            "lock_blockers": lock_blockers,
            "scope": scope,
            "running_scope_conflicts": running_conflict_info,
            "spawn_instruction": spawn_instruction,
        }, indent=2))
    else:
        print(f"added: {new_id}")
        print(f"assigned: group={group_id}, position={position}, ready_now={'true' if ready_now else 'false'}, serialized_after={serialized_after}")
        if deps_split:
            print(f"depends_on: {deps_split} (unmet: {dep_blockers})")
        if lock_blockers:
            print(f"lock_blockers: {lock_blockers}")
        print(f"spawn_instruction: {spawn_instruction}")

    # Soft-serialize banner: emit to stderr regardless of --json mode so
    # JSON callers still get the informational note about why this item
    # is queued behind a running peer. Stays out of the stdout JSON.
    if running_conflicts:
        _print_add_conflict_banner(new_id, scope, running_conflicts)

    # NOTE: queue-added claude-event emit removed 2026-04-27 (Andrew DM:
    # "Remove queue added event, too noisy"). queue add is task creation,
    # not a state transition. The main loop already holds the return value
    # from queue add — surfacing it again as an event was double-handling.
    # State-transition emits (queue-done, queue-abandoned) remain in their
    # respective code paths. queue-running removed from register (noise —
    # the caller just triggered it); force-start still emits queue-running.


def _print_add_conflict_banner(new_id, new_scope, running_conflicts):
    """Informational stderr banner for queue-add soft-serialize.

    Emitted when a queue add carries scope that overlaps a currently-
    running peer. The new item HAS been enqueued (this is not a refusal)
    and is recorded as serialized behind the running peer; the main loop
    must simply wait to spawn an agent for it until the peer finishes.

    History: prior versions hard-failed this path with an ALL CAPS
    "QUEUE ADD REFUSED" banner + exit 3, and pointed callers at
    --force-enqueue as an escape hatch. Andrew flagged the wording as
    misleading (2026-05-19): enqueuing behind active scope is normal
    serialization. The spawn-gating already lives in ready_now=false +
    spawn-check exit 2; the loud "refused" framing was overkill.
    """
    print("", file=sys.stderr)
    bar = "-" * 72
    print(bar, file=sys.stderr)
    print(
        f"queued (serialized): {new_id} enqueued behind running peer(s) "
        f"with overlapping scope.",
        file=sys.stderr,
    )
    print(
        "main loop: DO NOT spawn an agent for this item yet. It will be "
        "promoted to ready",
        file=sys.stderr,
    )
    print(
        "when the running peer(s) reach done/abandoned. Use "
        "`session-task queue spawn-check`",
        file=sys.stderr,
    )
    print("or re-check `ready_now` before spawning.", file=sys.stderr)
    print("", file=sys.stderr)
    print(f"  new scope: {','.join(new_scope)}", file=sys.stderr)
    print("  running peer(s):", file=sys.stderr)
    for c in running_conflicts:
        print(
            f"    - {c['id']} (group {c.get('group_id')}): "
            f"{','.join(c.get('scope', []))}",
            file=sys.stderr,
        )
    print(bar, file=sys.stderr)


def _extract_hostjob_label(scope):
    """Return the hostjob label from an item's scope, or None.

    Hostjob rows carry a scope entry ``hostjob:<label>``. Only the first
    match is honored. Mirrors the minisite's ``_extract_hostjob_label``.
    """
    for s in scope or []:
        if isinstance(s, str) and s.startswith("hostjob:"):
            return s[len("hostjob:"):]
    return None


def _hostjob_effective_terminal(label, running_age_seconds):
    """Consult a hostjob's own status.json to detect a queue row still marked
    ``running`` that has in fact FINISHED. Returns the corrected terminal
    transition dict, or None to KEEP ``running``.

        {"status": "done", "reason": None}                # rc == 0
        {"status": "abandoned", "reason": "hostjob ..."}  # rc != 0 / crashed / cleaned

    This is the CLI-side twin of the minisite's ``_hostjob_effective_terminal``
    (queue-minisite/app.py). Same authoritative source (the runner's
    ``<HOSTJOB_LOG_DIR>/<label>/status.json``, which ``hostjob list`` also
    reads), same safety posture: we ONLY read status.json's EXPLICIT terminal
    state (never probe pid liveness — the CLI may run in a different PID
    namespace than the host worker), and an ABSENT state dir only reconciles
    once the row is older than the starting window (so a just-launched job
    whose status.json lands a beat after the row registers is never
    mis-flipped). Fail-soft: any unexpected shape returns None (keep running).
    """
    if not label:
        return None
    sp = HOSTJOB_LOG_DIR / label / "status.json"
    try:
        with open(sp, "r", encoding="utf-8", errors="replace") as f:
            st = json.load(f)
    except FileNotFoundError:
        # No state dir. Either finished + `hostjob clean`'d (clean REFUSES a
        # running job, so an absent dir past the starting window means it
        # reached terminal), or we're inside the launch race. Gate on the
        # window to exclude the race. rc is unrecoverable => present as a
        # plain `done` (no evidence of failure to justify abandoned).
        if (
            running_age_seconds is not None
            and running_age_seconds > HOSTJOB_STARTING_WINDOW_SECONDS
        ):
            return {"status": "done", "reason": None}
        return None
    except (OSError, ValueError):
        return None
    if not isinstance(st, dict):
        return None
    hj_status = st.get("status")
    if hj_status == "running":
        # The runner still considers the worker live — trust the reaper to
        # flip on exit. (No cross-namespace pid check.)
        return None
    # Terminal per the runner: done / crashed / stopped.
    rc = st.get("rc")
    try:
        rc_int = int(rc)
    except (TypeError, ValueError):
        rc_int = None
    if hj_status == "done" and rc_int == 0:
        return {"status": "done", "reason": None}
    exit_str = "unknown" if rc_int is None else str(rc_int)
    return {
        "status": "abandoned",
        "reason": "hostjob %s (status=%s exit=%s)" % (label, hj_status, exit_str),
    }


def _reconcile_hostjob_rows(items):
    """Heal hostjob rows stuck ``running`` whose runner reports terminal.

    Mutates ``items`` IN PLACE, transitioning each affected row to its
    authoritative terminal status (done / abandoned) with the same field
    stamps `cmd_queue_done`/`cmd_queue_abandon` write (``completed_at`` /
    ``abandoned_at`` / ``abandon_reason``, ``group_head`` cleared, plus a
    ``reconciled_hostjob`` provenance flag). Returns the list of
    ``(id, new_status)`` tuples reconciled (possibly empty).

    Called under the queue write-lock by mutating commands (`list` when it
    can persist, plus a dedicated `reconcile-hostjobs` command) so the SHARED
    queue.json is repaired — making the CLI and the render-time-reconciling
    q-site agree, and stopping the leak at its durable source. NEVER raises;
    any per-row error is skipped so one bad row can't block the sweep.
    """
    now = datetime.now(timezone.utc)
    reconciled = []
    for it in items:
        try:
            if it.get("status") != "running":
                continue
            label = _extract_hostjob_label(it.get("scope") or [])
            if not label:
                continue
            started_iso = it.get("registered_at") or it.get("started_at")
            age = None
            if started_iso:
                try:
                    started = datetime.fromisoformat(started_iso)
                    age = (now - started).total_seconds()
                except (TypeError, ValueError):
                    age = None
            eff = _hostjob_effective_terminal(label, age)
            if eff is None:
                continue
            it["status"] = eff["status"]
            it["group_head"] = False
            it["reconciled_hostjob"] = True
            it["reconciled_hostjob_at"] = _fmt_ts()
            if eff["status"] == "done":
                it["completed_at"] = _fmt_ts()
            else:
                it["abandoned_at"] = _fmt_ts()
                it["abandon_reason"] = eff.get("reason") or "hostjob finished (reconciled)"
            reconciled.append((it.get("id"), eff["status"]))
        except Exception:
            continue
    if reconciled:
        _recompute_group_heads(items)
    return reconciled


def cmd_queue_reconcile_hostjobs(args):
    """Sweep queue.json for stuck-`running` hostjob rows whose runner reports
    terminal, and heal them in the shared store.

    This is the durable, both-views-agree fix for the CLI/web divergence
    (Andrew, botchat #2029): the q-site reconciles hostjob rows at render
    time from the runner's status.json, but the CLI showed raw queue.json, so
    finished-but-unflipped hostjobs lingered as `running` only in `queue
    list`. Running this sweep transitions them to their real terminal state so
    BOTH surfaces match. Safe to run on any host with the runner's
    ``HOSTJOB_LOG_DIR`` visible (that's where status.json lives); on a host
    without it, absent-dir rows past the starting window reconcile to `done`.
    """
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        reconciled = _reconcile_hostjob_rows(items)
        if reconciled:
            _queue_write_and_unlock(fh, data)
        else:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    if getattr(args, "json", False):
        print(json.dumps(
            [{"id": i, "status": s} for i, s in reconciled], indent=2))
        return
    if not reconciled:
        print("no stuck hostjob rows to reconcile")
        return
    for i, s in reconciled:
        print(f"reconciled {i} -> {s}")
    print(f"reconciled {len(reconciled)} hostjob row(s)")


def cmd_queue_list(args):
    fh, data = _queue_open_locked("rw")
    items = list(data["items"])
    locked_scopes = data.get("locked_scopes") or {}
    # Self-heal hostjob rows stuck `running` whose runner reports terminal,
    # BEFORE filtering/rendering, so `queue list` matches the render-time-
    # reconciling q-site and the leak is durably repaired in the shared store
    # (botchat #2029). Guarded so a reconcile failure never blocks listing:
    # on error we release the lock read-only and render the raw items. When
    # nothing changes we also release without a write (no spurious churn).
    try:
        reconciled = _reconcile_hostjob_rows(data["items"])
        if reconciled:
            _queue_write_and_unlock(fh, data)
            items = list(data["items"])
        else:
            _queue_unlock_readonly(fh)
    except Exception:
        try:
            _queue_unlock_readonly(fh)
        except Exception:
            pass

    # Filter
    if args.group:
        items = [it for it in items if it.get("group_id") == args.group]
    if args.ready:
        items = [it for it in items if _item_is_ready(data["items"], it, locked_scopes=locked_scopes)]
    elif not args.all:
        # Default view: in-flight items (pending + running + wedged). Wedged
        # included so the operator notices stuck agents at a glance — the
        # whole point of the wedged state is to surface attention.
        items = [it for it in items if it.get("status") in ACTIVE_STATUSES]

    items.sort(key=lambda it: (it.get("group_id", ""), _sort_key(it)))

    if args.json:
        print(json.dumps(items, indent=2))
        return

    if not items:
        print("(no items)")
        return

    # Tabular. WEDGED items get a leading `!` marker on the head column;
    # BLOCKED items get a leading `~` marker (distinct so the eye catches
    # the difference: `!` = system stuck, `~` = parked on external). Status
    # column shows `wedged` / `blocked` verbatim so JSON consumers and
    # grepping operators see the same word.
    # ANSI color (TTY only) further distinguishes: red for wedged
    # (system broken), yellow for blocked (waiting on external). Other
    # rows render plain.
    is_tty = sys.stdout.isatty()
    RED = "\033[31m" if is_tty else ""
    YELLOW = "\033[33m" if is_tty else ""
    MAGENTA = "\033[35m" if is_tty else ""
    RESET = "\033[0m" if is_tty else ""
    print(f"{'ID':22} {'GROUP':14} {'ST':11} {'PR':3} {'H':1} {'SCOPE'}")
    for it in items:
        status = it.get("status")
        if status == "wedged":
            head_mark = "!"
            color, color_reset = RED, RESET
        elif status == "blocked":
            head_mark = "~"
            color, color_reset = YELLOW, RESET
        elif status == "quarantined":
            # `?` because that is exactly what a quarantine means: we do
            # NOT know whether the agent is alive. Magenta so it can't be
            # confused with a wedge (red) or a block (yellow).
            head_mark = "?"
            color, color_reset = MAGENTA, RESET
        else:
            head_mark = "*" if it.get("group_head") else " "
            color, color_reset = "", ""
        scope_str = ",".join(it.get("scope", []))
        if len(scope_str) > 48:
            scope_str = scope_str[:45] + "..."
        summary = _item_summary(it)
        if len(summary) > 90:
            summary = summary[:87] + "..."
        desc = it.get("description", "")
        if len(desc) > 80:
            desc = desc[:77] + "..."
        print(
            f"{color}{it['id']:22} {it.get('group_id',''):14} "
            f"{it.get('status',''):11} {it.get('priority',5):<3} {head_mark} "
            f"{scope_str}{color_reset}"
        )
        print(f"  summary: {summary}")
        print(f"  desc   : {desc}")
        # Surface the wedge / block reason inline so `queue list` is the
        # one-stop diagnosis surface -- no need to drill into `queue show`
        # for the most common operator question ("why is this stuck?").
        if status == "wedged" and it.get("wedged_reason"):
            print(f"  wedged : {it.get('wedged_reason')}")
        if status == "blocked" and it.get("block_reason"):
            print(f"  blocked: {it.get('block_reason')}")
        if status == "quarantined":
            # A quarantine is the one state where the operator MUST be told
            # what it means (scope still held) and how to end it — the whole
            # failure mode being fixed was someone assuming the scope was
            # free.
            print(
                f"  QUARANTINED (presumed dead, SCOPE STILL HELD) at "
                f"{it.get('quarantined_at') or '?'}: "
                f"{it.get('quarantine_reason') or '(no reason given)'}"
            )
            print(
                f"  release: queue done {it['id']} | queue resurrect "
                f"{it['id']} | queue release {it['id']} --reason '...'"
            )


def cmd_queue_show(args):
    fh, data = _queue_open_locked("r")
    items = list(data["items"])
    locked_scopes = data.get("locked_scopes") or {}
    _queue_unlock_readonly(fh)
    for it in items:
        if it["id"] == args.id:
            ready = _item_is_ready(items, it, locked_scopes=locked_scopes)
            out = dict(it)
            out["ready_now"] = ready
            out["group_scope"] = _group_scope(items, it["group_id"])
            out["lock_blockers"] = _locked_tokens_blocking_item(it, locked_scopes)
            # Surface dep state + dependents so a single `queue show` is
            # enough to inspect the dependency edges in / out of this item
            # without re-reading queue.json. Deps live as `task:<id>` scope
            # tokens (canonical 2026-05-08+); we expose the legacy
            # `depends_on` field in the output too so consumers (UI,
            # tests) keep the same shape.
            deps = list(_iter_dep_ids(it))
            by_id = {x.get("id"): x for x in items if x.get("id")}
            dep_status = []
            unmet = []
            for d in deps:
                tgt = by_id.get(d)
                if tgt is None:
                    dep_status.append({"id": d, "status": "missing"})
                    unmet.append(d)
                else:
                    s = tgt.get("status") or "?"
                    dep_status.append({"id": d, "status": s})
                    if s != "done":
                        unmet.append(d)
            # Mirror the dep set on the legacy `depends_on` key so existing
            # UI / tests / scripts keep reading the same field. The on-disk
            # record stores deps only as task: scope tokens.
            out["depends_on"] = deps
            out["depends_on_status"] = dep_status
            out["dep_blockers"] = unmet
            out["dep_cycle"] = _has_dep_cycle(items, it["id"]) if deps else False
            # Reverse-edges: items that name THIS item in their deps (via
            # task: scope token, or legacy depends_on for forward-compat).
            dependents = [
                x.get("id")
                for x in items
                if x.get("id") and it["id"] in list(_iter_dep_ids(x))
                and x.get("id") != it["id"]
            ]
            out["dependents"] = dependents
            print(json.dumps(out, indent=2))
            return
    print(f"not found: {args.id}", file=sys.stderr)
    sys.exit(1)


