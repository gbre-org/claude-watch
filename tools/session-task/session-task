        help="Suppress the pingme + claude-event notifications for this operation.",
    )

    q_unwedge = qsub.add_parser(
        "unwedge",
        help=(
            "Flip a wedged item back to status=running. Use when the agent "
            "has recovered (self-clear succeeded, API issue cleared, manual "
            "ping unblocked it). Preserves wedged_at/wedged_reason as audit."
        ),
    )
    q_unwedge.add_argument("id")
    q_unwedge.add_argument("--json", action="store_true")
    q_unwedge.add_argument(
        "--silent", action="store_true",
        help="Suppress the pingme + claude-event notifications for this operation.",
    )

    q_block = qsub.add_parser(
        "block",
        help=(
            "Flip a running item to status=blocked with a reason. Use when "
            "the agent has done all autonomous work and is parked on an "
            "EXTERNAL blocker (human greenlight, branch-protection toggle, "
            "third-party API window, etc.). Distinct from `wedged` (system "
            "stuck) -- blocked means the system did its part and waits on "
            "someone else. The exporter labels this state separately so the "
            "WorkQueueOrphaned alert (which fires on running-without-owner) "
            "does NOT fire on blocked items. Recover via `unblock`, `done`, "
            "or `abandon`."
        ),
    )
    q_block.add_argument("id")
    q_block.add_argument(
        "--reason",
        required=True,
        help=(
            "Why is the agent blocked? Common values: 'awaiting human "
            "greenlight', 'awaiting branch-protection toggle', "
            "'third-party API rate-limited until $WHEN'. Recorded on the "
            "item as `block_reason` and surfaced in CLI/exporter/UI."
        ),
    )
    q_block.add_argument("--json", action="store_true")
    q_block.add_argument(
        "--silent", action="store_true",
        help="Suppress the pingme + claude-event notifications for this operation.",
    )

    q_unblock = qsub.add_parser(
        "unblock",
        help=(
            "Flip a blocked item back to status=running. Use when the "
            "external blocker clears (operator greenlit, branch-protection "
            "toggle landed, API window opened). Preserves blocked_at + "
            "block_reason as audit trail."
        ),
    )
    q_unblock.add_argument("id")
    q_unblock.add_argument("--json", action="store_true")
    q_unblock.add_argument(
        "--force", action="store_true",
        help=(
            "Unblock even if another running/wedged item now holds an "
            "overlapping scope. Default REFUSES such an unblock (returning "
            "to running would re-acquire the scope lock and double-occupy "
            "it). Pass --force only if you know the conflicting work is safe "
            "to run concurrently."
        ),
    )
    q_unblock.add_argument(
        "--silent", action="store_true",
        help="Suppress the pingme + claude-event notifications for this operation.",
    )

    q_spawn = qsub.add_parser(
        "spawn-check",
        help=("Check whether it is safe to spawn an agent for this item. "
              "Exit 0 = ok, 1 = conflict, 2 = not found."),
    )
    q_spawn.add_argument("id")
    q_spawn.add_argument("--json", action="store_true")

    q_force_start = qsub.add_parser(
        "force-start",
        help=(
            "Manually promote a pending item to running, bypassing scope-"
            "conflict serialization. AUDITABLE: --reason is required and the "
            "override is appended to ~/.config/claude/queue-force-start.log."
        ),
    )
    q_force_start.add_argument("id")
    q_force_start.add_argument(
        "--reason",
        required=True,
        help=(
            "Why are you overriding scope serialization? Recorded on the item "
            "as `force_started_reason` and appended to the audit log."
        ),
    )
    q_force_start.add_argument("--json", action="store_true")
    q_force_start.add_argument(
        "--silent", action="store_true",
        help="Suppress the pingme lifecycle notification for this operation.",
    )

    q_promote = qsub.add_parser(
        "promote",
        aliases=["bump"],
        help=(
            "Convenience: raise a pending item's priority just above its "
            "group's current head so it becomes the next ready-to-spawn item "
            "(without abandon+re-add). For an explicit target priority use "
            "`queue reprioritize <id> --priority N`."
        ),
    )
    q_promote.add_argument("id")

    q_reprioritize = qsub.add_parser(
        "reprioritize",
        help=(
            "Set a PENDING item's priority to an explicit value, in place "
            "(no abandon+re-add). Higher priority number = earlier in spawn "
            "ordering among same-group peers (created_at is the tiebreak); 5 "
            "is the default. Raising it above the group head makes it ready "
            "first; lowering it de-prioritizes it. Refused on non-pending "
            "items (priority only affects pending spawn ordering)."
        ),
    )
    q_reprioritize.add_argument("id")
    q_reprioritize.add_argument(
        "--priority", type=int, required=True,
        help="New priority (int; higher = earlier; default elsewhere is 5).",
    )
    q_reprioritize.add_argument("--json", action="store_true")

    q_setsum = qsub.add_parser(
        "set-summary",
        help=("Add / replace the one-line summary on an existing item. "
              "Useful for legacy items missing a summary or for typo fixes."),
    )
    q_setsum.add_argument("id")
    q_setsum.add_argument("summary", help="New summary text (~10 words)")

    q_update = qsub.add_parser(
        "update",
        help=(
            "Edit a NOT-YET-SPAWNED item's task spec in place "
            "(description/summary/scope) instead of abandon+re-add. Refuses "
            "(exit 2) if a LIVE spawned agent is bound to the item unless "
            "--force; refuses (exit 1) on done/abandoned items."
        ),
    )
    q_update.add_argument("id")
    q_update.add_argument(
        "--description",
        help=(
            "New description / prompt text (replaces the existing one). "
            "Mutually exclusive with --desc-file."
        ),
    )
    q_update.add_argument(
        "--desc-file",
        help=(
            "Read the new description from FILE (or '-' for stdin). Handy for "
            "multi-line prompts that are awkward to pass on the command line. "
            "Mutually exclusive with --description."
        ),
    )
    q_update.add_argument(
        "--summary",
        help="New one-line (~10 word) summary. Must be non-empty when given.",
    )
    q_update.add_argument(
        "--scope",
        action="append",
        help=(
            "Replacement scope token(s) (repeatable; comma-separated values "
            "also accepted). REPLACES the whole scope list, normalized + "
            "deduped + repo-scope-validated like `queue add`. For incremental "
            "add/remove of individual tokens use `update-scope` instead."
        ),
    )
    q_update.add_argument(
        "--force",
        action="store_true",
        help=(
            "Override the live-spawned-agent guard (audited). Only if you KNOW "
            "the agent will re-read the item or you are about to abandon it."
        ),
    )
    q_update.add_argument("--json", action="store_true")

    q_setbr = qsub.add_parser(
        "set-block-reason",
        help=(
            "Update the block_reason on an ALREADY-blocked item, in place. "
            "Item must be status=blocked; preserves blocked_at (and status). "
            "Use this to refresh a stale block reason as the situation "
            "evolves without abandon+re-add (which loses item identity). To "
            "block a running item use `queue block <id> --reason ...`."
        ),
    )
    q_setbr.add_argument("id")
    q_setbr.add_argument(
        "--reason",
        required=True,
        help=(
            "New block_reason text. REQUIRED and non-empty. Replaces the "
            "existing block_reason on the item; records "
            "`block_reason_updated_at`; preserves the original `blocked_at`."
        ),
    )
    q_setbr.add_argument("--json", action="store_true")

    q_updscope = qsub.add_parser(
        "update-scope",
        help=(
            "Add (default) or remove (--remove) scope tokens on an existing "
            "item. Idempotent. Primary use: `workload run` injecting the "
            "`workload:<label>` token onto a pre-registered queue item so "
            "the work-queue-exporter can locate its heartbeat file."
        ),
    )
    q_updscope.add_argument("id")
    q_updscope.add_argument(
        "tokens",
        nargs="+",
        help=(
            "Scope token(s) to add. Comma-joined forms accepted "
            "(`workload:foo,resource:bar`). Tokens already on the item are "
            "silently skipped (no duplicate). With --remove, tokens are "
            "removed instead; tokens not present are silently skipped."
        ),
    )
    q_updscope.add_argument(
        "--remove",
        action="store_true",
        help="Remove the listed tokens instead of adding.",
    )
    q_updscope.add_argument("--json", action="store_true")

    q_depend = qsub.add_parser(
        "depend",
        help=(
            "Edit explicit interjob dependencies on a queue item. "
            "Stored (since 2026-05-08) as `task:<id>` scope tokens; "
            "ready_now flips True only when every dep is in 'done' state. "
            "Cross-group deps allowed. --clear strips only task: tokens "
            "(regular scope is preserved). Cycle-creating edits are "
            "REFUSED; ADDs on a running/wedged/blocked item require "
            "--force; done/abandoned items refuse all edits."
        ),
    )
    q_depend.add_argument("id")
    q_depend.add_argument(
        "--add",
        action="append",
        default=[],
        help=(
            "Queue id(s) to add as dependencies. Comma-separated values "
            "and repeated --add flags both work."
        ),
    )
    q_depend.add_argument(
        "--remove",
        action="append",
        default=[],
        help=(
            "Queue id(s) to remove from depends_on. Comma-separated values "
            "and repeated --remove flags both work."
        ),
    )
    q_depend.add_argument(
        "--clear",
        action="store_true",
        help="Remove ALL deps from this item (applied before --add).",
    )
    q_depend.add_argument(
        "--force",
        action="store_true",
        help=(
            "Allow --add on a running/wedged/blocked item. By default an "
            "ADD on a non-pending item is refused (a new dep cannot pause "
            "already-running work, so the edge would misrepresent state). "
            "Removes / --clear never need --force. done/abandoned items "
            "refuse all edits regardless of --force."
        ),
    )
    q_depend.add_argument("--json", action="store_true")

    q_prune = qsub.add_parser("prune", help="Remove done/abandoned items")
    q_prune.add_argument("--older-than", help="e.g. 7d, 24h, 30m")
    q_prune.add_argument("-n", "--dry-run", action="store_true")

    qsub.add_parser("banner", help="Top-5 ready items banner")

    # Manual scope locks (added 2026-05-08).
    q_lock = qsub.add_parser(
        "lock",
        help=(
            "Park any pending item whose scope overlaps <scope> until the "
            "scope is unlocked. Use to enqueue work that depends on a "
            "real-world condition (hardware install, manual config, etc.)."
        ),
    )
    q_lock.add_argument("scope", help="Scope token to lock (same syntax as --scope on `queue add`)")
    q_lock.add_argument(
        "--reason",
        help="Free-form note describing why the scope is locked. Surfaces in `queue locks`.",
    )
    q_lock.add_argument("--json", action="store_true")

    q_unlock = qsub.add_parser(
        "unlock",
        help=(
            "Remove <scope> from the locked-scopes set. Items previously "
            "blocked-only-by-the-lock become ready immediately. No-op (exit 0) "
            "if the scope was not locked."
        ),
    )
    q_unlock.add_argument("scope", help="Scope token to unlock")
    q_unlock.add_argument("--json", action="store_true")

    q_locks = qsub.add_parser(
        "locks",
        help="List currently locked scopes with reason, lock timestamp, and held-item count.",
    )
    q_locks.add_argument("--json", action="store_true")

    q_mig = qsub.add_parser("migrate", help="Parse legacy /tmp/claude-queued-tasks.txt")
    q_mig.add_argument("--from", dest="from_file", required=True)
    q_mig.add_argument("--yes", action="store_true")

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "set":
        return cmd_set(args)
    if args.command == "append":
        return cmd_append(args)
    if args.command == "get":
        return cmd_get(args)
    if args.command == "show":
        return cmd_show(args)
    if args.command == "clear":
        return cmd_clear(args)
    if args.command == "banner":
        banner = for_session_resume()
        if banner:
            print(banner)
        return
    if args.command == "complete":
        return cmd_complete(args)
    if args.command == "history":
        return cmd_history(args)
    if args.command == "history-raw":
        print(for_session_resume_history(
            n_resume=args.n_resume,
            n_queue=args.n_queue,
            since=args.since,
        ))
        return
    if args.command == "queue":
        qmap = {
            "add": cmd_queue_add,
            "list": cmd_queue_list,
            "reconcile-hostjobs": cmd_queue_reconcile_hostjobs,
            "show": cmd_queue_show,
            "scope": cmd_queue_scope,
            "groups": cmd_queue_groups,
            "ready": cmd_queue_ready,
            "done": cmd_queue_done,
            "abandon": cmd_queue_abandon,
            "release": cmd_queue_release,
            "resurrect": cmd_queue_resurrect,
            "pop": cmd_queue_pop,
            "register": cmd_queue_register,
            "heartbeat": cmd_queue_heartbeat,
            "wedge": cmd_queue_wedge,
            "unwedge": cmd_queue_unwedge,
            "block": cmd_queue_block,
            "unblock": cmd_queue_unblock,
            "spawn-check": cmd_queue_spawn_check,
            "force-start": cmd_queue_force_start,
            "promote": cmd_queue_promote,
            "bump": cmd_queue_promote,
            "reprioritize": cmd_queue_reprioritize,
            "set-summary": cmd_queue_set_summary,
            "update": cmd_queue_update,
            "set-block-reason": cmd_queue_set_block_reason,
            "update-scope": cmd_queue_update_scope,
            "depend": cmd_queue_depend,
            "prune": cmd_queue_prune,
            "banner": cmd_queue_banner,
            "lock": cmd_queue_lock,
            "unlock": cmd_queue_unlock,
            "locks": cmd_queue_locks,
            "migrate": cmd_queue_migrate,
        }
        fn = qmap.get(args.qcmd)
        if fn is None:
            parser.parse_args(["queue", "--help"])
            sys.exit(1)
        return fn(args)

    parser.print_help()
    sys.exit(1)


if __name__ == "__main__":
    main()
