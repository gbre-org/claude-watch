def cmd_queue_update(args):
    """Edit a NOT-YET-SPAWNED item's task spec (description/summary/scope) in place.

    Motivation (Andrew #2980): when requirements are clarified mid-flight,
    the main loop was forced to `abandon` + re-`add` just to correct a task's
    description/prompt -- which destroys the item's identity, audit trail,
    dependency edges, and queue position. This gives a direct,
    identity-preserving edit: `queue update <id> [--description ... |
    --desc-file FILE] [--summary ...] [--scope ... --scope ...]`.

    A superset of `set-summary` (summary only) and complementary to
    `update-scope` (delta add/remove of scope tokens): `update` REPLACES the
    description/summary and, when `--scope` is given, REPLACES the whole scope
    list (like `queue add`). For incremental scope token add/remove keep using
    `update-scope`.

    GUARD -- refuse editing the spec of an item with a LIVE spawned agent:
      * If a live agent is bound to the item (per claude-watch active-agents
        state), editing its task spec is meaningless -- the agent is already
        executing against the old description. Refuse (exit 2) unless
        `--force` is passed (audited; the operator asserts they know the
        agent will re-read the item, or is about to abandon it).
      * done / abandoned items always refuse (exit 1) -- nothing to correct on
        a finished item; there's no --force override for a terminal state.
      * Valid targets: pending, registered-but-not-yet-spawned (status running
        or wedged/blocked with NO live agent bound). The honest "already
        spawned" signal is the live-agent binding, NOT status=running: the
        main loop registers (-> running) BEFORE invoking the Agent tool, so a
        just-registered item legitimately has no live agent yet.

    Behavior:
      * At least one of --description/--desc-file/--summary/--scope required.
      * --description and --desc-file are mutually exclusive; --desc-file "-"
        reads the new description from stdin.
      * --summary must be non-empty when provided (mirrors set-summary).
      * --scope replaces the scope list: normalized + deduped + repo-scope
        validated exactly like `queue add` (bypass repo validation with
        SESSION_TASK_REPOS_NO_VALIDATE=1). Group heads are recomputed so
        readiness reflects the new scope; for group-aware incremental token
        edits prefer `update-scope`.
      * Pure metadata edit: no pingme, no claude-event (matches set-summary /
        reprioritize). Records `spec_updated_at` for audit. The updated
        description/summary WILL appear in the next register/done/abandon
        pingme for this item.
    """
    have_desc = getattr(args, "description", None) is not None
    have_desc_file = getattr(args, "desc_file", None) is not None
    have_summary = getattr(args, "summary", None) is not None
    have_scope = bool(getattr(args, "scope", None))

    if have_desc and have_desc_file:
        print(
            "ERROR: --description and --desc-file are mutually exclusive",
            file=sys.stderr,
        )
        sys.exit(1)
    if not (have_desc or have_desc_file or have_summary or have_scope):
        print(
            "ERROR: nothing to update; pass at least one of "
            "--description/--desc-file/--summary/--scope",
            file=sys.stderr,
        )
        sys.exit(1)

    # Resolve the new description text up front (before taking the lock).
    new_description = None
    if have_desc:
        new_description = args.description
    elif have_desc_file:
        try:
            if args.desc_file == "-":
                new_description = sys.stdin.read()
            else:
                with open(args.desc_file, "r") as f:
                    new_description = f.read()
        except OSError as e:
            print(f"ERROR: cannot read --desc-file {args.desc_file!r}: {e}",
                  file=sys.stderr)
            sys.exit(1)
    if new_description is not None:
        new_description = new_description.strip()
        if not new_description:
            print("ERROR: description must be non-empty", file=sys.stderr)
            sys.exit(1)

    new_summary = None
    if have_summary:
        new_summary = (args.summary or "").strip()
        if not new_summary:
            print("ERROR: --summary must be non-empty", file=sys.stderr)
            sys.exit(1)

    # Normalize + validate a replacement scope list (same pipeline as add).
    new_scope = None
    if have_scope:
        scope_split = []
        seen_split = set()
        for raw in args.scope:
            for piece in raw.split(","):
                piece = piece.strip()
                if not piece:
                    continue
                if piece in seen_split:
                    continue
                seen_split.add(piece)
                scope_split.append(piece)
        if not scope_split:
            print("ERROR: --scope, when given, must name at least one token",
                  file=sys.stderr)
            sys.exit(1)
        try:
            new_scope = [_normalize_token(t) for t in scope_split]
        except ValueError as e:
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)
        try:
            _validate_repo_scope_tokens(new_scope)
        except ValueError as e:
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)

        status = target.get("status")
        if status in ("done", "abandoned"):
            print(
                f"update refused: {args.id} status={status!r} -- nothing to "
                f"correct on a finished item (no --force override for a "
                f"terminal state).",
                file=sys.stderr,
            )
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)

        # GUARD: a LIVE spawned agent means the edit is futile.
        live_agent = _live_agent_for_queue(args.id)
        if live_agent and not getattr(args, "force", False):
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print("", file=sys.stderr)
            bar = "!" * 72
            print(bar, file=sys.stderr)
            print(
                f"!! UPDATE REFUSED: {args.id} HAS A LIVE SPAWNED AGENT "
                f"(agent={live_agent}).",
                file=sys.stderr,
            )
            print(
                "!! Editing the task spec of a running agent is meaningless -- "
                "the agent",
                file=sys.stderr,
            )
            print(
                "!! is already executing against the current description.",
                file=sys.stderr,
            )
            print("!!", file=sys.stderr)
            print(
                "!! To correct the spec: abandon the item, then re-add "
                "(or re-register)", file=sys.stderr,
            )
            print(
                f"!!   session-task queue abandon {args.id} --reason 'spec "
                f"changed mid-flight'", file=sys.stderr,
            )
            print("!!", file=sys.stderr)
            print(
                "!! Override (audited) -- only if you KNOW the agent will "
                "re-read the item", file=sys.stderr,
            )
            print(
                "!! or you are about to abandon it: pass --force.",
                file=sys.stderr,
            )
            print(bar, file=sys.stderr)
            sys.exit(2)

        changes = {}
        if new_description is not None:
            old_desc = target.get("description")
            if new_description != old_desc:
                changes["description"] = {"old": old_desc, "new": new_description}
                target["description"] = new_description
        if new_summary is not None:
            old_sum = target.get("summary") or DEFAULT_SUMMARY
            if new_summary != old_sum:
                changes["summary"] = {"old": old_sum, "new": new_summary}
                target["summary"] = new_summary
        if new_scope is not None:
            old_scope = list(target.get("scope") or [])
            if new_scope != old_scope:
                changes["scope"] = {"old": old_scope, "new": new_scope}
                target["scope"] = new_scope

        if not changes:
            # All requested edits were identical to current values.
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(f"no-op: {args.id} already matches the requested spec")
            return

        target["spec_updated_at"] = _fmt_ts()
        if new_scope is not None:
            # Scope changed -> readiness ordering may shift; recompute heads.
            _recompute_group_heads(items)
        updated = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    log_completed(
        f"[queue {args.id} SPEC-UPDATED] fields={','.join(sorted(changes))}"
        + (f" (--force over live agent {live_agent})" if live_agent else ""),
        extra={
            "source": "queue",
            "event": "update",
            "id": args.id,
            "group_id": target.get("group_id"),
            "fields": sorted(changes),
            "forced_over_live_agent": bool(live_agent),
        },
    )

    if getattr(args, "json", False):
        print(json.dumps({"id": args.id, "changes": changes, "item": updated},
                         indent=2))
        return
    print(f"updated: {args.id}")
    for field in ("description", "summary", "scope"):
        if field in changes:
            print(f"  {field}:")
            print(f"    old: {changes[field]['old']}")
            print(f"    new: {changes[field]['new']}")
    if live_agent:
        print(f"  (--force applied over live agent {live_agent})")


def cmd_queue_set_block_reason(args):
    """Update the block_reason on an ALREADY-blocked item, in place.

    Motivation: `queue block <id> --reason ...` only transitions a
    *pending* or *running* item to blocked and REFUSES an already-blocked
    item (the state machine allows pending/running -> blocked). So once an
    item is blocked, the block_reason was frozen -- when the real-world
    situation
    evolved (e.g. "awaiting build #140" after #140 already landed and
    produced its verdict), the only way to refresh the reason was
    abandon + re-add, which destroys the item's identity + audit trail.

    This subcommand mirrors `set-summary`: a pure in-place metadata edit
    that refreshes `block_reason` WITHOUT changing status and WITHOUT
    touching `blocked_at` (the original block timestamp is preserved as
    audit). It records `block_reason_updated_at` so the refresh itself is
    auditable, and keeps the prior reason available in the plain-text /
    --json output.

    Behavior:
      * Item must exist and be in status=blocked. Any other status
        (running, pending, wedged, done, abandoned) REFUSES (exit 1).
        Use `queue block <id> --reason ...` to take a *running* item to
        blocked; this command only EDITS the reason of an item that is
        already blocked.
      * `--reason TEXT` is REQUIRED and must be non-empty (an empty
        reason defeats the operator-attention purpose, same as `block`).
      * Preserves `blocked_at`. Does NOT flip status, does NOT touch
        heartbeat/pid. Idempotent in the sense that re-setting the same
        text just refreshes `block_reason_updated_at`.
      * Pure metadata edit: no pingme, no claude-event by default
        (matches `set-summary`). The refreshed reason WILL appear in the
        next unblock/done/abandon notification for this item.
    """
    new_reason = (args.reason or "").strip()
    if not new_reason:
        print(
            "ERROR: --reason is required for set-block-reason "
            "(an empty reason defeats the operator-attention purpose).",
            file=sys.stderr,
        )
        sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        status = target.get("status")
        if status != "blocked":
            print(
                f"set-block-reason refused: {args.id} status={status!r} "
                f"(must be blocked -- use `queue block <id> --reason ...` to "
                f"block a running item first)",
                file=sys.stderr,
            )
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)

        old_reason = target.get("block_reason") or "(unspecified)"
        target["block_reason"] = new_reason
        target["block_reason_updated_at"] = _fmt_ts()
        # Intentionally DO NOT touch blocked_at or status -- this is a pure
        # in-place reason edit; the original block timestamp is the audit.
        updated = dict(target)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise

    log_completed(
        f"[queue {target['id']} BLOCK-REASON-UPDATED] "
        f"{target.get('description','')} (reason: {new_reason})",
        extra={
            "source": "queue",
            "event": "set-block-reason",
            "id": target["id"],
            "group_id": target.get("group_id"),
            "old_reason": old_reason,
            "reason": new_reason,
        },
    )

    if getattr(args, "json", False):
        print(json.dumps(updated, indent=2))
    else:
        print(f"block_reason updated: {args.id}")
        print(f"  old: {old_reason}")
        print(f"  new: {new_reason}")
        print(f"  blocked_at (preserved): {target.get('blocked_at')}")


def cmd_queue_depend(args):
    """Edit explicit interjob dependencies on an existing queue item.

    `session-task queue depend <id> [--add q-AAA] [--remove q-BBB] [--clear]`

    Storage (since 2026-05-08): each dep is stored as a `task:<id>` scope
    token on the dragged item. The legacy `depends_on` field is no longer
    written; the read-time migration in `_queue_open_locked` translates
    pre-existing entries on next load. `ready_now` flips True only when
    every dep is `done`. Cross-group deps are allowed.

    Architecture (per Andrew's perf brief): WRITE is just a set
    add/remove on the dragged item. NO transitive-closure cache, NO
    cascade work. Cycles are detected lazily on READ via
    ``_has_dep_cycle`` AND prevented at write time (see below).

    --add / --remove accept comma-separated id lists. --clear wipes ALL
    task: scope tokens (regular scope tokens are preserved).

    Safe-edit semantics (the "don't silently re-gate live/terminal work"
    rules — 2026-06-17):

      * Cycle prevention. Before committing, the new edge set is applied
        speculatively and ``_has_dep_cycle`` is run on the dragged item.
        If the edit would introduce a NEW cycle (one not already present
        before the edit), the write is REFUSED (exit 3) and nothing is
        persisted. This is stricter than the old "detect lazily on read,
        warn after the fact" posture: an operator asking for a cyclic
        edge almost always made a mistake, and silently accepting it
        wedges ready_now=false forever. (A pre-existing cycle reachable
        only through OTHER items is not the edit's fault, so removes /
        clears that don't ADD an edge are never blocked by this guard —
        they're how you BREAK a cycle.)

      * done / abandoned items refuse ALL edits (exit 1). The item is
        terminal; re-gating it is meaningless and editing its dep set
        only corrupts the audit trail.

      * running / wedged items: ADDS are refused by default (exit 1)
        and require --force. Rationale: a running item is already past
        the ready_now gate — an agent is actively working it. Refusing
        by default surfaces the likely mistake. --force lets an operator
        who really means it (e.g. correcting a mis-modeled graph
        mid-flight) record the edge anyway.

        DEMOTION (2026-06-22): when a --force add (or a remove that
        leaves an unmet dep) DOES re-gate a running/wedged item — i.e.
        the post-edit dep set has an unmet dep — the item is no longer
        logically running: its work is gated on a dep that isn't done.
        It is therefore DEMOTED to `blocked` (mirroring `queue block`),
        with an auto `block_reason` naming the unmet dep(s). This avoids
        the old "lying" RUNNING+ORPHAN state: previously the status
        stayed `running` while ready_now went false and the agent
        binding went stale, so the exporter's WorkQueueOrphaned alert
        (status="running" + no-live-owner) fired on it. `blocked` is
        the honest state — exempt from the orphan alert, no live owner
        expected — and `queue unblock <id>` resumes it once the dep
        clears. (A force-add that does NOT introduce an unmet dep — e.g.
        the dep is already `done` — leaves the item running, as before.)

        blocked items: ADDS still require --force; a force-add that
        leaves an unmet dep keeps the item blocked (already the honest
        state). REMOVES / --clear on any of these states are always
        allowed (loosening a gate is always safe).

      * pending items: any edit is allowed (adds re-gate ready_now as
        intended; this is the normal case the verbs exist for).
    """
    add_raw = list(getattr(args, "add", None) or [])
    remove_raw = list(getattr(args, "remove", None) or [])
    do_clear = bool(getattr(args, "clear", False))

    if not (add_raw or remove_raw or do_clear):
        print(
            "ERROR: pass at least one of --add, --remove, --clear",
            file=sys.stderr,
        )
        sys.exit(1)

    def _flatten(raw):
        out: list[str] = []
        seen = set()
        for piece_raw in raw:
            for p in str(piece_raw).split(","):
                p = p.strip()
                if not p or p in seen:
                    continue
                seen.add(p)
                out.append(p)
        return out

    to_add = _flatten(add_raw)
    to_remove = _flatten(remove_raw)

    if args.id in to_add:
        print(
            f"ERROR: an item cannot depend on itself ({args.id})",
            file=sys.stderr,
        )
        sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(f"not found: {args.id}", file=sys.stderr)
            sys.exit(1)
        status = target.get("status")
        force = bool(getattr(args, "force", False))
        if status not in ACTIVE_STATUSES:
            # done / abandoned: terminal. Editing the dep set is moot and
            # only muddies the audit trail. Refuse outright.
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                f"ERROR: cannot edit deps on {status} item (terminal state)",
                file=sys.stderr,
            )
            sys.exit(1)
        if status != "pending" and to_add and not force:
            # running / wedged / blocked: ADDING a dep cannot actually
            # re-gate the item (ready_now is only consulted for pending
            # items at spawn time), so a new "depends on X" edge on an
            # already-running item is a lie about state. Refuse the ADD
            # unless --force. Removes / clears are still allowed below
            # (loosening a gate is always safe).
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                f"ERROR: cannot --add deps on {status} item without --force "
                f"(adding a dep does not pause an already-running item; "
                f"the edge would misrepresent state). Removes/--clear are "
                f"allowed; pass --force only if you really mean to record "
                f"the edge on a live item.",
                file=sys.stderr,
            )
            sys.exit(1)

        existing_ids = {it["id"] for it in items}
        unknown = [d for d in to_add if d not in existing_ids]
        if unknown:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                "ERROR: --add references unknown queue id(s): "
                + ",".join(unknown),
                file=sys.stderr,
            )
            sys.exit(1)

        before = list(_iter_dep_ids(target))
        # Split the target's scope into task: tokens vs everything else
        # so we can rebuild the task-token slice without disturbing the
        # rest. --clear wipes only task: tokens; regular scope is left
        # intact.
        non_task_scope = [
            t for t in (target.get("scope") or []) if not _is_task_token(t)
        ]
        if do_clear:
            after_deps: list[str] = []
        else:
            after_deps = list(before)

        # Removes first, then adds — so `--add x --remove x` is a no-op
        # rather than a delete (callers passing both for the same id is
        # almost certainly a mistake but we don't bake in surprises).
        if to_remove:
            after_deps = [d for d in after_deps if d not in set(to_remove)]
        for a in to_add:
            if a not in after_deps:
                after_deps.append(a)

        # Cycle PREVENTION (2026-06-17): refuse an edit that would
        # introduce a NEW cycle. We compute the cycle state both before
        # and after the speculative edit so we only blame edits that
        # actually create a cycle — a pre-existing cycle reachable only
        # via OTHER items must not block a remove/clear meant to break it.
        cycle_before = _has_dep_cycle(items, args.id)
        spec_scope = non_task_scope + [f"task:{d}" for d in after_deps]
        saved_scope = target.get("scope")
        target["scope"] = spec_scope
        try:
            cycle_after = _has_dep_cycle(items, args.id)
        finally:
            target["scope"] = saved_scope
        if cycle_after and not cycle_before:
            # The edit created the cycle. Identify which added dep(s)
            # close a loop back to this item so the message is actionable.
            offenders = [
                d for d in to_add
                if d in after_deps and _reaches(items, d, args.id)
            ]
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            print(
                "ERROR: refusing dep edit — it would create a dependency "
                "cycle"
                + (f" via {','.join(offenders)}" if offenders else "")
                + f" (item {args.id} would transitively depend on itself).",
                file=sys.stderr,
            )
            sys.exit(3)

        # Rewrite scope: regular tokens first (preserves user ordering),
        # then task: tokens in dep order. Drop the legacy field if a
        # migration left it lingering.
        target["scope"] = non_task_scope + [f"task:{d}" for d in after_deps]
        target.pop("depends_on", None)
        target["depends_on_updated_at"] = _fmt_ts()

        # Demote a re-gated live item (2026-06-22). A running / wedged item
        # that GAINS an unmet dependency (via --force --add, or a remove
        # that left an unmet dep behind) is no longer logically running:
        # its work is gated on a dep that isn't done. Leaving it `running`
        # produces a "lying" RUNNING+ORPHAN state in the exporter — ready_now
        # is false but status stays running with a now-stale/dead agent
        # binding, so the WorkQueueOrphaned alert (which filters
        # status="running" + no-live-owner) fires on it. A running item with
        # an unmet dep IS logically blocked, so flip it to `blocked` here —
        # mirroring `queue block`, which the exporter labels separately and
        # exempts from the orphan alert. The agent binding goes stale
        # naturally; `blocked` expects no live owner by design.
        by_id_lock = {x.get("id"): x for x in items if x.get("id")}
        unmet_after = [
            d for d in after_deps
            if (by_id_lock.get(d) is None)
            or (by_id_lock[d].get("status") != "done")
        ]
        demoted = False
        if status in RUNNING_STATUSES and unmet_after:
            target["status"] = "blocked"
            target["blocked_at"] = _fmt_ts()
            target["block_reason"] = (
                "auto-blocked: gained unmet dependency via `queue depend` "
                f"(unmet: {','.join(unmet_after)})"
            )
            demoted = True
            # group_head bookkeeping mirrors cmd_queue_block: a blocked item
            # is still the in-flight head of its group.
            _recompute_group_heads(items)

        _queue_write_and_unlock(fh, data)
    except Exception:
        try:
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
        except Exception:
            pass
        raise

    # Re-read to compute ready_now under the new edge set.
    fh2, data2 = _queue_open_locked("r")
    items2 = list(data2["items"])
    locked_scopes2 = data2.get("locked_scopes") or {}
    _queue_unlock_readonly(fh2)
    fresh = next((it for it in items2 if it["id"] == args.id), None)
    fresh_deps = list(_iter_dep_ids(fresh)) if fresh else list(after_deps)
    ready = _item_is_ready(items2, fresh, locked_scopes=locked_scopes2) if fresh else False
    cycle = (
        _has_dep_cycle(items2, args.id)
        if (fresh and fresh_deps)
        else False
    )
    # Compute `unmet` (a.k.a. dep_blockers) the same way `queue show` does
    # so the dep-edit output mirrors the rest of the CLI's contract: a dep
    # is "unmet" unless its target exists AND is `done`.
    by_id2 = {x.get("id"): x for x in items2 if x.get("id")}
    unmet = [
        d for d in fresh_deps
        if (by_id2.get(d) is None) or (by_id2[d].get("status") != "done")
    ]
    # Surface a demotion (running/wedged -> blocked) when a re-gating add
    # parked the live item on a now-unmet dep. Read the persisted status
    # for the authoritative post-edit value, but gate `was_demoted` on the
    # PRE-edit status being a live (running/wedged) state — an item that was
    # ALREADY blocked and stayed blocked was not demoted by this edit.
    fresh_status = fresh.get("status") if fresh else None
    was_demoted = (
        status in RUNNING_STATUSES
        and fresh_status == "blocked"
    )

    if getattr(args, "json", False):
        print(json.dumps(
            {
                "id": args.id,
                "depends_on": fresh_deps,
                "added": to_add,
                "removed": to_remove,
                "cleared": do_clear,
                "ready_now": ready,
                "unmet": unmet,
                # `dep_blockers` is the field name `queue add` / `queue show`
                # use; alias it so consumers reading either name work.
                "dep_blockers": unmet,
                "dep_cycle": cycle,
                "status": fresh_status,
                "demoted_to_blocked": was_demoted,
            },
            indent=2,
        ))
    else:
        print(f"deps updated: {args.id}")
        print(f"  before : {before}")
        print(f"  after  : {fresh_deps}")
        print(f"  unmet  : {unmet}")
        print(f"  ready_now: {'true' if ready else 'false'}")
        if was_demoted:
            print(
                f"  demoted: running -> blocked (gained unmet dependency; "
                f"releasing the stale agent binding so the exporter renders "
                f"it BLOCKED, not RUNNING+ORPHAN). `queue unblock {args.id}` "
                f"once the dep clears."
            )
        if cycle:
            # Should be unreachable for edits this verb makes (cycle
            # creation is now refused at write time), but a PRE-EXISTING
            # cycle reachable via other items can still surface here.
            print(
                "  WARNING: a dependency cycle is reachable from this item "
                "(pre-existing — not created by this edit); ready_now will "
                "stay false until the cycle is broken.",
                file=sys.stderr,
            )


def cmd_queue_promote(args):
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        if target.get("status") != "pending":
            print(f"can only promote pending items (status={target.get('status')})", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        # Bump priority high enough to be above everyone else in the group.
        members = _group_members(items, target["group_id"])
        max_p = max((int(m.get("priority", 5)) for m in members), default=5)
        target["priority"] = max(max_p + 1, int(target.get("priority", 5)) + 1)
        target["promoted_at"] = _fmt_ts()
        # Leave created_at alone -- the priority bump alone reorders the group
        # head (spawn ordering is priority-first via _group_head/_sort_key,
        # with created_at only the tiebreak). Rewriting created_at would
        # destroy the audit trail for no ordering benefit.
        _recompute_group_heads(items)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise
    print(f"promoted: {args.id} (priority={target['priority']})")


def cmd_queue_reprioritize(args):
    """Set a pending item's priority to an EXPLICIT value, in place.

    Motivation: previously the only way to reorder a same-scope (same-group)
    contender was `abandon` + re-`add` (which destroys the item's identity +
    audit trail) or `promote` (which only bumps to group head). This gives the
    operator a direct, identity-preserving knob: `queue reprioritize <id>
    --priority N`.

    Because spawn-readiness ordering within a group is priority-first
    (`_group_head` -> `_sort_key`: higher priority number wins, created_at is
    the tiebreak), raising an item's priority above its group's current head
    makes it the next ready-to-spawn item WITHOUT abandon+re-add. Lowering it
    de-prioritizes it behind same-group peers.

    Behavior:
      * Item must exist and be in status=pending. Reprioritizing a
        running/wedged/blocked/done/abandoned item is REFUSED (exit 1) -- the
        spawn ordering only consults priority for *pending* heads, so a
        priority edit on an in-flight item would be silently inert.
      * `--priority N` is REQUIRED (any int; higher = earlier; 5 is the
        system default). Recomputes group heads so `ready_now` reflects the
        new ordering immediately.
      * Pure metadata edit: no pingme, no claude-event (matches set-summary /
        promote). Records `priority_updated_at` for audit; keeps the prior
        priority in the output.
    """
    new_priority = int(args.priority)
    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        target = next((it for it in items if it["id"] == args.id), None)
        if target is None:
            print(f"not found: {args.id}", file=sys.stderr)
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        if target.get("status") != "pending":
            print(
                "can only reprioritize pending items "
                f"(status={target.get('status')}); priority only affects "
                "spawn ordering among pending same-group peers.",
                file=sys.stderr,
            )
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            sys.exit(1)
        old_priority = int(target.get("priority", 5))
        target["priority"] = new_priority
        target["priority_updated_at"] = _fmt_ts()
        _recompute_group_heads(items)
        # Recompute ready_now under the new ordering so callers can decide
        # whether the bump made this item spawnable.
        locked_scopes = data.get("locked_scopes") or {}
        ready_now = _item_is_ready(items, target, locked_scopes=locked_scopes)
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise
    if getattr(args, "json", False):
        print(json.dumps({
            "id": args.id,
            "old_priority": old_priority,
            "priority": new_priority,
            "ready_now": ready_now,
        }, indent=2))
    else:
        print(f"reprioritized: {args.id}")
        print(f"  old priority: {old_priority}")
        print(f"  new priority: {new_priority}")
        print(f"  ready_now: {'true' if ready_now else 'false'}")


_DURATION_RE = re.compile(r"^(\d+)([dhm])$")


def _parse_duration(s):
    m = _DURATION_RE.match(s)
    if not m:
        raise ValueError(f"bad duration: {s} (use Nd/Nh/Nm)")
    n, unit = int(m.group(1)), m.group(2)
    if unit == "d":
        return timedelta(days=n)
    if unit == "h":
        return timedelta(hours=n)
    return timedelta(minutes=n)


def cmd_queue_prune(args):
    cutoff = None
    if args.older_than:
        try:
            cutoff = datetime.now(timezone.utc) - _parse_duration(args.older_than)
        except ValueError as e:
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

    fh, data = _queue_open_locked("rw")
    try:
        items = data["items"]
        to_remove = []
        for it in items:
            if it.get("status") not in ("done", "abandoned"):
                continue
            if cutoff is None:
                to_remove.append(it)
                continue
            ts_str = it.get("completed_at") or it.get("abandoned_at")
            if not ts_str:
                continue
            try:
                ts = datetime.fromisoformat(ts_str)
            except ValueError:
                continue
            if ts < cutoff:
                to_remove.append(it)
        if args.dry_run:
            print(f"would prune {len(to_remove)} items")
            for it in to_remove:
                print(f"  {it['id']}  {it.get('status')}  {it.get('description','')[:60]}")
            fcntl.flock(fh, fcntl.LOCK_UN)
            fh.close()
            return
        keep = [it for it in items if it not in to_remove]
        data["items"] = keep
        _queue_write_and_unlock(fh, data)
    except Exception:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()
        raise
    print(f"pruned {len(to_remove)} items")


def cmd_queue_banner(args):
    fh, data = _queue_open_locked("r")
    items = list(data["items"])
    locked_scopes = data.get("locked_scopes") or {}
    _queue_unlock_readonly(fh)
    ready = [it for it in items if _item_is_ready(items, it, locked_scopes=locked_scopes)]
    ready.sort(key=_sort_key)
    pending = [it for it in items if it.get("status") == "pending"]
    running = [it for it in items if it.get("status") == "running"]
    wedged = [it for it in items if it.get("status") == "wedged"]
    blocked = [it for it in items if it.get("status") == "blocked"]

    if not ready and not pending and not running and not wedged and not blocked:
        return  # silent when empty -- banner only when something to show

    lines = [
        "",
        "#" * 60,
        "## SESSION-TASK QUEUE — TOP READY ITEMS",
        "#" * 60,
    ]
    # Wedged items lead the banner -- they're the highest-priority operator
    # signal: "you have a stuck agent, attention required".
    if wedged:
        lines.append(f"  !! WEDGED: {len(wedged)} item(s) need operator attention")
        for it in wedged[:5]:
            wr = it.get("wedged_reason") or "no reason"
            lines.append(
                f"     - [{it['id']}] {it.get('description','')[:70]}  ({wr[:40]})"
            )
        lines.append("")
    # Blocked items: parked on an external blocker. Lower urgency than
    # wedged (system isn't broken) but still surfaces in the banner so the
    # operator remembers what's waiting on their decision.
    if blocked:
        lines.append(f"  ~~ BLOCKED: {len(blocked)} item(s) parked on external blocker")
        for it in blocked[:5]:
            br = it.get("block_reason") or "no reason"
            lines.append(
                f"     - [{it['id']}] {it.get('description','')[:70]}  ({br[:40]})"
            )
        lines.append("")
    if ready:
        for it in ready[:5]:
            lines.append(
                f"  * [{it['id']}] pr={it.get('priority',5)} {it['description'][:80]}"
            )
            lines.append(
                f"        scope: {','.join(it.get('scope', []))[:90]}"
            )
    else:
        lines.append("  (no items are READY -- everything is blocked on a running peer or unblocked below)")

    waiting = [it for it in pending if not _item_is_ready(items, it, locked_scopes=locked_scopes)]
    if waiting:
        lines.append("")
        lines.append(f"  Waiting behind a group peer: {len(waiting)} item(s)")
    if running:
        lines.append(f"  In progress (running): {len(running)} item(s)")
    if locked_scopes:
        lines.append(f"  Locked scopes: {len(locked_scopes)} (see `session-task queue locks`)")

    lines.append("#" * 60)
    lines.append("")
    print("\n".join(lines))


