#!/usr/bin/env python3
"""cw-agent-stats — host-side producer of the live agent-activity snapshot.

Originally ``botchat/bin/botchat-agent-stats`` (botchat #2955/#2956, Andrew,
2026-08-21: *"live updating counter of agent tool calls (on all views,
including compact)"* + *"token count too if possible"*). The feature was then
removed from botchat altogether (2026-08-22, Andrew: "move what you have to
into cw"), so this script AND the survey library under it (``agentstats.py``,
vendored next to this file) are now claude-watch's own — no botchat checkout,
``sys.path`` hack, or botchat env is needed to run it.

Scans the live Claude Code subagent transcripts (``~/.claude/projects/<slug>/
<session>/subagents/agent-*.jsonl``) plus the main-loop transcript, folds them
into per-agent {tool calls, context tokens, output tokens, age} and writes ONE
JSON snapshot ATOMICALLY to ``--out``. Default ``--out`` (first match wins)::

    $CW_AGENT_STATS_OUT                               explicit file path
    $CLAUDE_WATCH_STATE_DIR/agent-stats.json          claude-watch state dir
    $BOTCHAT_DATA_DIR/agent-stats.json                DEPRECATED fallback (warns)
    /var/lib/claude-watch/agent-stats.json            the daemon's default state dir

i.e. the snapshot lands next to the daemon's ``active-agents.json`` — the
directory the compose stack already bind-mounts into the queue-minisite at
``/agents-state`` (``CW_STATE_PATH``), where ``queue-minisite/app.py`` reads
it by default (``QUEUE_MINISITE_AGENT_STATS_FILE``). The ``BOTCHAT_DATA_DIR``
fallback is kept for ONE release so an operator whose environment still
exports it does not silently lose the snapshot; it prints a deprecation line
on stderr and will be removed. The old ``~/.config/botchat/config`` file read
is GONE (that was botchat-specific plumbing, and it is exactly what kept this
producer writing into botchat's data dir after the botchat consumer was
removed).

Modes
-----
* ``--once``  (default): one tick, write the snapshot, exit.
* ``--loop``: tick every ``--interval`` seconds for ``--duration`` seconds, then
  exit — the CRON shape. ``* * * * *`` + ``--loop --duration 58 --interval 4``
  gives ~4s freshness with no daemon to babysit, and the per-file byte offsets
  live in-process so only the appended tail is parsed between ticks (one full
  parse of the live files per minute at process start, ~10ms).
* ``--print``: also dump the snapshot to stdout (``--no-write`` to only print).

Idempotent + single-instance friendly: wrap with ``flock -n`` in cron so an
overlapping minute can't double-write (harmless anyway — atomic replace).

Exit codes: 0 ok; 2 bad args; 1 the snapshot could not be written at all.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
import time
from pathlib import Path

# The survey/fold library is vendored NEXT TO this script (agentstats.py).
# Resolve it relative to this file's real location so the ~/bin symlink
# (``make install``) and the cron / launchd absolute-path invocations all
# find it without any PYTHONPATH or botchat checkout.
sys.path.insert(0, str(Path(__file__).resolve().parent))

import agentstats  # noqa: E402


DEFAULT_STATE_DIR = Path("/var/lib/claude-watch")


def _default_out() -> Path:
    """Resolve the snapshot path when ``--out`` is not given.

    Mirrors the Rust daemon's state-dir resolution (``CLAUDE_WATCH_STATE_DIR``
    env, else ``/var/lib/claude-watch`` — see ``src/stale_ready.rs`` /
    ``src/queue_check.rs``) so the snapshot lands beside ``active-agents.json``
    and rides the SAME bind-mount into the queue-minisite. Precedence:

    1. ``CW_AGENT_STATS_OUT`` — an explicit file path (this producer's own knob).
    2. ``CLAUDE_WATCH_STATE_DIR`` — ``<dir>/agent-stats.json``.
    3. ``BOTCHAT_DATA_DIR`` — ``<dir>/agent-stats.json``. DEPRECATED: the
       pre-vendoring default; honoured for one release with a stderr warning
       so an operator whose env still exports it keeps a working snapshot
       while they move the consumer off botchat's data dir. Will be removed.
    4. ``/var/lib/claude-watch/agent-stats.json``.

    Note the old ``~/.config/botchat/config`` file lookup is deliberately NOT
    carried over — that file is botchat's, and reading it is what kept the
    snapshot landing in botchat's data dir after the botchat consumer was
    removed. Operators wanting a non-default location pass ``--out`` or set
    ``CW_AGENT_STATS_OUT``.
    """
    explicit = os.environ.get("CW_AGENT_STATS_OUT", "").strip()
    if explicit:
        return Path(explicit)
    state_dir = os.environ.get("CLAUDE_WATCH_STATE_DIR", "").strip()
    if state_dir:
        return Path(state_dir) / agentstats.SNAPSHOT_FILENAME
    legacy = os.environ.get("BOTCHAT_DATA_DIR", "").strip()
    if legacy:
        print(
            "cw-agent-stats: BOTCHAT_DATA_DIR is deprecated as the snapshot location "
            f"(writing {legacy}/{agentstats.SNAPSHOT_FILENAME}); set CW_AGENT_STATS_OUT "
            "or CLAUDE_WATCH_STATE_DIR, or pass --out. This fallback will be removed.",
            file=sys.stderr,
        )
        return Path(legacy) / agentstats.SNAPSHOT_FILENAME
    return DEFAULT_STATE_DIR / agentstats.SNAPSHOT_FILENAME


def _default_prom_file() -> Path:
    """Resolve the node-exporter textfile-collector output path for the agent gauges.

    Design (2026-08-22, Andrew's call): this daemon is the ONE producer for
    both outputs — the agent-stats snapshot JSON above AND these Prometheus
    gauges — rather than a second hook-based capture pipeline. Mirrors
    claude-watch's own ``CLAUDE_WATCH_PROM_FILE`` convention
    (``src/metrics.rs::prom_file_path``):

    * ``CW_AGENT_STATS_PROM_FILE`` wins outright if set.
    * Else, if ``CLAUDE_WATCH_PROM_FILE`` is set (the Rust `claude-watch
      metrics` cron's own output path), write a SIBLING file in that same
      directory — so both producers land in the one node-exporter
      ``--collector.textfile.directory`` an operator already wired up,
      with no second env var to configure in the common case.
    * Else fall back to the hardcoded node-exporter default dir (matches
      ``metrics.rs``'s own fallback).
    """
    env = os.environ.get("CW_AGENT_STATS_PROM_FILE", "").strip()
    if env:
        return Path(env)
    sibling_of = os.environ.get("CLAUDE_WATCH_PROM_FILE", "").strip()
    if sibling_of:
        return Path(sibling_of).with_name("claude_agent_stats.prom")
    return Path("/var/lib/node-exporter/textfile/claude_agent_stats.prom")


def _esc_label(value: str) -> str:
    """Escape a string for use as a Prometheus text-format label value.

    Per the exposition format, only backslash, double-quote, and newline
    need escaping inside a quoted label value. Tool/model ids are
    attacker-free (they come from Claude Code's own transcript schema) but
    ``<synthetic>`` and similar bracketed/punctuated ids are real observed
    values, so escape properly rather than stripping characters.
    """
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def _prom_lines(snap: dict) -> list[str]:
    """Render the agent-stats snapshot as Prometheus textfile-collector lines.

    These are GAUGES, not monotonic counters: each value is the tool-call /
    token count accumulated so far by a still-live agent (per
    ``agentstats.AgentState``), which can only ever grow while the
    agent is live and then disappears from the file once it falls out of the
    live window. Because the whole file is rewritten every tick, stale label
    sets from agents that exited the window are dropped automatically — no
    separate expiry/TTL bookkeeping needed.

    ``model``/``tool`` breakdowns (claude-watch #663, the devbar-equivalent
    telemetry) ride on the ``tool_totals``/``model_totals`` fields the
    Collector already folds in the SAME ``feed_entry`` pass as everything
    else above (``AgentState.tool_counts``/``model_counts``, summed
    fleet-wide in ``Collector.tick``) — no second, heavier transcript
    survey. Like the per-agent gauges, these are windowed gauges (bounded
    by ``live_window_secs``), not monotonic counters: a tool/model that
    falls out of every live-or-recent transcript disappears from the file
    on the next tick, same "whole file rewritten" staleness handling.
    """
    totals = snap.get("totals") or {}
    lines = [
        "# HELP claude_agent_live_count Number of live Claude Code subagents in the current cw-agent-stats snapshot.",
        "# TYPE claude_agent_live_count gauge",
        f"claude_agent_live_count {int(totals.get('agents', 0))}",
        "# HELP claude_agent_spawned_count Distinct Claude Code subagent transcripts observed in the live/recent window (windowed gauge, not a monotonic lifetime counter).",
        "# TYPE claude_agent_spawned_count gauge",
        f"claude_agent_spawned_count {int(totals.get('agents_spawned', 0))}",
        "# HELP claude_agent_calls_total Tool calls made so far by a live Claude Code subagent (per-agent gauge; disappears once the agent falls out of the live window).",
        "# TYPE claude_agent_calls_total gauge",
        "# HELP claude_agent_tokens_total Tokens accounted so far by a live Claude Code subagent, by kind (context|output) (per-agent gauge; disappears once the agent falls out of the live window).",
        "# TYPE claude_agent_tokens_total gauge",
    ]
    for rec in snap.get("agents") or []:
        agent_id = _esc_label(str(rec.get("agent_id", "")))
        lines.append(f'claude_agent_calls_total{{agent_id="{agent_id}"}} {int(rec.get("tool_calls", 0))}')
        lines.append(
            f'claude_agent_tokens_total{{agent_id="{agent_id}",kind="context"}} {int(rec.get("context_tokens", 0))}'
        )
        lines.append(
            f'claude_agent_tokens_total{{agent_id="{agent_id}",kind="output"}} {int(rec.get("output_tokens", 0))}'
        )
    main = snap.get("main")
    if main:
        lines.append(
            "# HELP claude_agent_main_context_tokens Context tokens in the current main-loop transcript."
        )
        lines.append("# TYPE claude_agent_main_context_tokens gauge")
        lines.append(f'claude_agent_main_context_tokens {int(main.get("context_tokens", 0))}')

    tool_totals = snap.get("tool_totals") or {}
    if tool_totals:
        lines.append(
            "# HELP claude_tool_use_total Fleet-wide tool calls, by tool name, folded over every transcript in the live/recent window (windowed gauge, not a monotonic counter)."
        )
        lines.append("# TYPE claude_tool_use_total gauge")
        for tool, cnt in sorted(tool_totals.items()):
            lines.append(f'claude_tool_use_total{{tool="{_esc_label(tool)}"}} {int(cnt)}')

    model_totals = snap.get("model_totals") or {}
    if model_totals:
        lines.append(
            "# HELP claude_model_use_total Fleet-wide assistant turns, by model id, folded over every transcript in the live/recent window (windowed gauge, not a monotonic counter)."
        )
        lines.append("# TYPE claude_model_use_total gauge")
        for model, cnt in sorted(model_totals.items()):
            lines.append(f'claude_model_use_total{{model="{_esc_label(model)}"}} {int(cnt)}')

    model_output_tokens_totals = snap.get("model_output_tokens_totals") or {}
    if model_output_tokens_totals:
        lines.append(
            "# HELP claude_output_tokens_total Fleet-wide OUTPUT tokens, by model id, folded over every transcript in the live/recent window (windowed gauge, not a monotonic counter)."
        )
        lines.append("# TYPE claude_output_tokens_total gauge")
        for model, tok in sorted(model_output_tokens_totals.items()):
            lines.append(f'claude_output_tokens_total{{model="{_esc_label(model)}"}} {int(tok)}')
    return lines


def _write_prom(lines: list[str], path: Path) -> None:
    """Atomic textfile-collector write: temp file in the same dir + rename.

    Same shape as ``agentstats.write_snapshot`` (tmp + ``os.replace``)
    and Rust ``metrics.rs::write_prom`` — node-exporter polls this directory
    on its own schedule, so a half-written file would get scraped as a
    truncated/corrupt exposition and dropped for that scrape.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    content = "\n".join(lines) + "\n"
    fd, tmp = tempfile.mkstemp(prefix=".claude_agent_stats.", suffix=".tmp", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="cw-agent-stats",
        description="Write the live agent tool-call/token snapshot the queue-minisite reads.",
    )
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--once", action="store_true", help="one tick then exit (default)")
    mode.add_argument("--loop", action="store_true", help="tick every --interval for --duration seconds")
    ap.add_argument("--interval", type=float, default=4.0, help="seconds between ticks in --loop (default 4)")
    ap.add_argument("--duration", type=float, default=58.0, help="total seconds to run in --loop (default 58)")
    ap.add_argument("--out", type=Path, default=None,
                    help="snapshot path (default $CW_AGENT_STATS_OUT, else "
                         "$CLAUDE_WATCH_STATE_DIR/agent-stats.json, else "
                         "/var/lib/claude-watch/agent-stats.json)")
    ap.add_argument("--prom-file", type=Path, default=None,
                    help="node-exporter textfile-collector path for the Prometheus gauges "
                         "(default $CW_AGENT_STATS_PROM_FILE, else a sibling of "
                         "$CLAUDE_WATCH_PROM_FILE, else /var/lib/node-exporter/textfile/claude_agent_stats.prom)")
    ap.add_argument("--no-prom", action="store_true", help="do not write the Prometheus textfile-collector output")
    ap.add_argument("--projects-dir", type=Path, default=None,
                    help="Claude projects dir (default ~/.claude/projects or $CLAUDE_PROJECTS_DIR)")
    ap.add_argument("--live-window", type=float, default=agentstats.DEFAULT_LIVE_WINDOW_SECS,
                    help="seconds since last transcript write within which an agent counts as live")
    ap.add_argument("--print", dest="do_print", action="store_true", help="print the snapshot JSON to stdout")
    ap.add_argument("--no-write", action="store_true", help="do not write the snapshot file")
    ap.add_argument("-v", "--verbose", action="store_true", help="one status line per tick on stderr")
    args = ap.parse_args(argv)

    out = args.out or _default_out()
    prom_file = args.prom_file or _default_prom_file()
    # Only the HARDCODED fallback (no --prom-file, no CW_AGENT_STATS_PROM_FILE,
    # no CLAUDE_WATCH_PROM_FILE) degrades sanely when its directory is missing
    # -- see the "prom dir missing" handling below. An operator who explicitly
    # named a path (flag or env) is opting in, so a missing parent there still
    # gets auto-created (mkdir(parents=True) in _write_prom) and any failure
    # is a real error, same as always.
    prom_file_is_hardcoded_default = (
        args.prom_file is None
        and not os.environ.get("CW_AGENT_STATS_PROM_FILE", "").strip()
        and not os.environ.get("CLAUDE_WATCH_PROM_FILE", "").strip()
    )
    collector = agentstats.Collector(projects_dir=args.projects_dir, live_window_secs=args.live_window)

    deadline = time.monotonic() + args.duration if args.loop else None
    rc = 0
    prom_dir_missing_warned = False
    while True:
        t0 = time.monotonic()
        snap = collector.tick()
        if not args.no_write:
            try:
                agentstats.write_snapshot(snap, out)
            except OSError as e:
                print(f"cw-agent-stats: cannot write {out}: {e}", file=sys.stderr)
                rc = 1
        if not args.no_prom and prom_file_is_hardcoded_default and not prom_file.parent.is_dir():
            # Fresh host, no node-exporter textfile collector configured (or
            # not installed at all yet): the DEFAULT prom path's directory
            # doesn't exist. Don't force it into existence (this is a system
            # dir owned by the node-exporter package, not ours to create) and
            # don't fail the whole tick over an optional output -- warn once
            # per run and keep writing the snapshot JSON every tick.
            if not prom_dir_missing_warned:
                print(
                    f"cw-agent-stats: {prom_file.parent} does not exist -- skipping "
                    "Prometheus textfile output (still writing the JSON snapshot). "
                    "Install node-exporter's textfile collector, or set "
                    "CW_AGENT_STATS_PROM_FILE / CLAUDE_WATCH_PROM_FILE / --prom-file "
                    "to enable it.",
                    file=sys.stderr,
                )
                prom_dir_missing_warned = True
        elif not args.no_prom:
            try:
                _write_prom(_prom_lines(snap), prom_file)
            except OSError as e:
                print(f"cw-agent-stats: cannot write {prom_file}: {e}", file=sys.stderr)
                rc = 1
        if args.do_print:
            print(json.dumps(snap, indent=1))
        if args.verbose:
            t = snap["totals"]
            print(
                f"cw-agent-stats: agents={t['agents']} calls={t['tool_calls']} "
                f"ctx={t['context_tokens']} out={t['output_tokens']} "
                f"main={(snap.get('main') or {}).get('context_tokens')} "
                f"({(time.monotonic() - t0) * 1000:.0f}ms)",
                file=sys.stderr,
            )
        if deadline is None or time.monotonic() + args.interval > deadline:
            return rc
        time.sleep(max(0.0, args.interval - (time.monotonic() - t0)))


if __name__ == "__main__":
    sys.exit(main())
