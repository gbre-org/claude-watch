#!/usr/bin/env python3
"""event-classify — classify a claude-event source+tag into a tier.

Tier model (4 tiers; this CLI only owns 3 — Signal is intentionally
NOT classified here, see "Signal exclusion" below):

  - ``ambient``    Info-only context. UserPromptSubmit hook injects
                   into the NEXT prompt's context. Non-blocking.
                   No obligation, no gate, no tool-call deferral.

  - ``actionable`` Demands an active response (queue an agent, ack a
                   DM-equivalent, dispatch a fix). Recorded in
                   ``~/.config/claude-events/pending-actions.json``;
                   the ``event_must_act`` obligation evaluator counts
                   consecutive non-exempt Bash tool calls while
                   pending. After N consecutive missed calls (default
                   3) the gate fires and DENIES.

  - ``excluded``   This refactor explicitly does NOT touch this
                   class. Currently only Signal (``signal/*``) is on
                   the excluded list: Signal-DM acks stay on the
                   existing per-thread obligation gate, NOT migrated
                   to the new shared event-must-act infrastructure.
                   Andrew (sig_ts 2026-05-21): "for now keep signal
                   distinct even if it fits conceptually. too mission
                   critical to risk on new shared infra".

PRECEDENCE -- the PRODUCER owns its own classification
=====================================================

An event SOURCE ships its own tier alongside the event (claude-event
``data.tier``); that decision is NOT duplicated here. The table below is
the FALLBACK for producers that ship nothing, plus a place for genuine
CONSUMER policy. Duplicating a producer's decision in a second place is a
two-sources-of-truth bug (Andrew, botchat #2486-#2490: "note that pr watch
sends its classification along w its events" / "that isnt defined in cw or
local config" / "or shouldnt be" / "where possible event sources should
also define their priority" / "w user side overrides as needed").

  0. EXCLUDED consumer policy   ABSOLUTE (signal/* only)
  1. USER-SIDE OVERRIDE         operator file, outranks the producer
  2. PRODUCER-SHIPPED TIER      the event's own ``data.tier``
  3. CLASSIFICATIONS table      consumer-side FALLBACK (below)
  4. fail-LOUD default          ``actionable``, marked UNCLASSIFIED

Rung 3 is DATA (the ``CLASSIFICATIONS`` table below), not hardcoded. But
prefer rung 2: when you own the producer, stamp ``data.tier`` there rather
than adding a row here.

Rung 4 marks the result ``unclassified`` and attaches a directive reason
naming the three fixes, so a missing classification reads as "add a rule /
have the producer ship a tier" rather than as mysterious gating. The
fail-loud default itself is deliberate and unchanged.

Operator overrides (rung 1) live in an OPTIONAL JSON file --
``$EVENT_CLASSIFY_OVERRIDES`` or ``~/.config/claude-events/
tier-overrides.json``, never created by this tool. Schema + examples: see
``load_user_overrides`` below, or run ``event-classify --list-rules``.

Source/tag schema is documented in
``tools/claude-event/claude-event``'s ``VALID_SOURCES`` (``cron``,
``alertmanager``, ``queue``, ``torrent``, ``security``, ``manual``,
``claude-watch``).

Usage:

  event-classify --source <src> --tag <tag> [--message <text>]
                 [--json] [--default <tier>]

  Exit 0 with the tier name on stdout (``ambient`` / ``actionable``
  / ``excluded`` / ``unknown``). When ``--json`` is set, emit a JSON
  object with the source / tag / tier / reason fields instead.

  ``--default`` picks the tier when no rule matches (default
  ``actionable`` — fail-LOUD stance: a genuinely unknown
  (source, tag) pair should PRESS the loop to handle it or add a
  classifier rule, never be silently swallowed as ambient context.
  Every deliberately-ambient pair already has an explicit rule
  above the catch-alls, so only TRULY-unmatched pairs hit this).

Self-tests: ``event-classify --self-test``. Embedded suite covers
every entry in ``CLASSIFICATIONS``, the full precedence ladder above,
the override-file parser, the UNCLASSIFIED marking, and the
message-substring conditional rule (``pr-status-change`` is actionable
iff the message contains "CI failure" or "mergeable=conflicting" [a merge
CONFLICT]; ambient otherwise — incl. "CI success" and a conflict
RESOLUTION "mergeable=mergeable (was: conflicting)").
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Callable

# --- Tier vocabulary ------------------------------------------------------

AMBIENT = "ambient"
ACTIONABLE = "actionable"
EXCLUDED = "excluded"
UNKNOWN = "unknown"
VALID_TIERS = {AMBIENT, ACTIONABLE, EXCLUDED, UNKNOWN}


# --- Classification table (DATA) ------------------------------------------
#
# Each entry: (source_pattern, tag_pattern, predicate, tier, reason).
#
#   source_pattern: exact string or "*" (any source)
#   tag_pattern:    exact string, "*" (any tag), or "<prefix>*" prefix
#   predicate:      None or a callable(message: str) -> bool. When set,
#                   the rule matches only if the predicate returns True
#                   for the message. Used for message-conditional rules
#                   like pr-status-change (actionable iff "CI failure" or
#                   "mergeable=conflicting" in message; ambient otherwise).
#   tier:           "ambient" / "actionable" / "excluded"
#   reason:         human-readable docstring; surfaced in --json output.
#
# Order matters: first match wins. Excluded rules go FIRST so Signal
# can never accidentally match an ambient/actionable rule.
#
# --- ADD A NEW EVENT SOURCE BY APPENDING TO THIS TABLE --------------------

def _contains_any(*needles: str) -> Callable[[str], bool]:
    def _pred(msg: str) -> bool:
        m = msg or ""
        return any(n in m for n in needles)
    return _pred


def _normalize_shipped_tier(value: str | None) -> str | None:
    """Coerce a PRODUCER-SHIPPED tier value to a canonical routing tier, or
    None if absent/invalid. Accepts actionable/ambient/excluded
    (case-insensitive, surrounding whitespace tolerated). Anything else -- an
    empty string, a severity word like "high"/"urgent" (the distinct top-level
    claude-event `priority` field), or a typo -- returns None so the event
    falls through to the consumer-side table rather than being silently
    mis-routed. UNKNOWN is not a routing tier and is treated as absent."""
    if not value:
        return None
    v = str(value).strip().lower()
    if v in (ACTIONABLE, AMBIENT, EXCLUDED):
        return v
    return None


# --- User-side override layer (OPERATOR, highest non-absolute rung) -------
#
# Andrew (botchat #2489/#2490): "where possible event sources should also
# define their priority" ... "w user side overrides as needed". The operator
# must be able to re-tier a producer that classifies badly WITHOUT editing
# that producer and WITHOUT editing this file. Overrides therefore outrank
# both the producer-shipped tier and the CLASSIFICATIONS table.
#
# The file is OPTIONAL and is NEVER created by this tool. Absent file (the
# normal state) == no overrides == unchanged behavior.
#
# Path: $EVENT_CLASSIFY_OVERRIDES, else ~/.config/claude-events/
# tier-overrides.json.
#
# Schema -- either a bare list of rules, or {"overrides": [ ... ]}:
#
#   {"overrides": [
#      {"source": "cron", "tag": "pr-ci-red", "tier": "ambient",
#       "reason": "the first nudge is noise; I watch PRs myself"},
#      {"source": "*", "tag": "pr-status-change", "contains": "merged",
#       "tier": "ambient"}
#   ]}
#
#   source / tag  same pattern grammar as CLASSIFICATIONS (exact, "*",
#                 "<prefix>*"). Missing key defaults to "*".
#   contains      OPTIONAL message substring; the rule matches only when
#                 the message contains it. Data, not code -- an operator
#                 config never executes a predicate.
#   tier          actionable | ambient | excluded (required, validated).
#   reason        OPTIONAL human note, surfaced in --json output.
#
# Rules are evaluated in file order; first match wins. A malformed file is
# IGNORED wholesale (default-open: a typo in operator config must never
# break event routing) -- run `event-classify --list-rules` to see the
# parse error.

DEFAULT_OVERRIDES_PATH = "~/.config/claude-events/tier-overrides.json"

# Cache: (resolved_path, mtime_ns) -> (rules, error). Keeps the per-event
# classify() call from re-reading + re-parsing the file every time, while
# still picking up an operator edit without a restart.
_OVERRIDES_CACHE: dict = {}


def overrides_path() -> "os.PathLike[str] | str":
    """Resolved path of the operator override file (never created here)."""
    env = os.environ.get("EVENT_CLASSIFY_OVERRIDES", "").strip()
    return Path(env).expanduser() if env else Path(
        DEFAULT_OVERRIDES_PATH).expanduser()


def _coerce_override(raw: object, idx: int) -> tuple[dict | None, str | None]:
    """Validate one raw override entry -> (rule, error)."""
    if not isinstance(raw, dict):
        return None, f"override[{idx}]: not an object"
    tier = _normalize_shipped_tier(raw.get("tier"))
    if tier is None:
        return None, (f"override[{idx}]: tier={raw.get('tier')!r} is not one "
                      f"of actionable/ambient/excluded")
    src = raw.get("source", "*")
    tag = raw.get("tag", "*")
    if not isinstance(src, str) or not isinstance(tag, str):
        return None, f"override[{idx}]: source/tag must be strings"
    contains = raw.get("contains")
    if contains is not None and not isinstance(contains, str):
        return None, f"override[{idx}]: contains must be a string"
    reason = raw.get("reason")
    if reason is not None and not isinstance(reason, str):
        return None, f"override[{idx}]: reason must be a string"
    return {"source": src or "*", "tag": tag or "*", "tier": tier,
            "contains": contains, "reason": reason or ""}, None


def load_user_overrides(path=None) -> tuple[list[dict], str | None]:
    """Load + validate the operator override file.

    Returns ``(rules, error)``. A missing file is the normal case and
    returns ``([], None)``. Any parse/validation problem returns
    ``([], "<message>")`` -- overrides are dropped WHOLESALE rather than
    partially applied, so a half-valid file can't silently re-tier some
    events and not others. Default-open by design."""
    p = Path(path).expanduser() if path is not None else Path(overrides_path())
    try:
        st = p.stat()
    except OSError:
        return [], None  # absent == no overrides (the normal state)

    ck = (str(p), st.st_mtime_ns, st.st_size)
    hit = _OVERRIDES_CACHE.get(ck)
    if hit is not None:
        return hit

    try:
        doc = json.loads(p.read_text())
    except (json.JSONDecodeError, ValueError, OSError) as exc:
        res: tuple[list[dict], str | None] = ([], f"{p}: unreadable JSON ({exc})")
        _OVERRIDES_CACHE[ck] = res
        return res

    if isinstance(doc, dict):
        raw_rules = doc.get("overrides", [])
    elif isinstance(doc, list):
        raw_rules = doc
    else:
        res = ([], f"{p}: top level must be a list or an object with "
                   f"an 'overrides' key")
        _OVERRIDES_CACHE[ck] = res
        return res

    if not isinstance(raw_rules, list):
        res = ([], f"{p}: 'overrides' must be a list")
        _OVERRIDES_CACHE[ck] = res
        return res

    rules: list[dict] = []
    for i, raw in enumerate(raw_rules):
        rule, err = _coerce_override(raw, i)
        if err is not None:
            res = ([], f"{p}: {err}")
            _OVERRIDES_CACHE[ck] = res
            return res
        rules.append(rule)  # type: ignore[arg-type]

    res = (rules, None)
    _OVERRIDES_CACHE[ck] = res
    return res


