    # conflict RESOLUTION, plain "mergeable", "merged". The conditional
    # ACTIONABLE rule above catches CI FAILURE and merge CONFLICT
    # (mergeable=conflicting); this catches everything else.
    ("*", "pr-status-change", None, AMBIENT,
        "Routine PR status (push/pending/CI success/mergeable); "
        "context only."),

    # Workload routine.
    ("*", "workload-done", None, AMBIENT,
        "Workload finished; context only."),

    # Host-job routine (hostjob runner; parallels workload-done).
    ("*", "hostjob-done", None, AMBIENT,
        "Host job finished; context only."),

    # Watcher routine events.
    ("*", "watcher-cleanup", None, AMBIENT,
        "Watcher cleanup tick; context only."),
]


# --- Matching engine ------------------------------------------------------

def _match_pattern(pattern: str, value: str) -> bool:
    """Match value against a simple pattern: exact, '*' (any),
    or '<prefix>*' (prefix). Case-sensitive on both sides."""
    if pattern == "*":
        return True
    if pattern.endswith("*"):
        return value.startswith(pattern[:-1])
    return pattern == value


UNCLASSIFIED_MARK = "UNCLASSIFIED"


def _unclassified_reason(src: str, tag: str, tier: str) -> str:
    """The 'add a rule' signal (botchat #2483). Rendered wherever an
    unclassified event surfaces: --json output, pending-actions.json, and
    the event-must-act deny banner."""
    return (
        f"{UNCLASSIFIED_MARK}: no rule matched ({src}/{tag}) AND the producer "
        f"shipped no data.tier -> fail-loud default ({tier}). "
        f"Acking clears this event, NOT the cause. Fix one of: "
        f"(1) PREFERRED - have the producer stamp data.tier="
        f"actionable|ambient on the event (classification belongs with the "
        f"source); (2) add a rule to CLASSIFICATIONS in event-classify; "
        f"(3) add a user override in {overrides_path()}."
    )


def classify(source: str, tag: str, message: str = "",
             shipped_tier: str | None = None,
             default_tier: str = ACTIONABLE,
             overrides: list[dict] | None = None) -> dict:
    """Classify one event. Returns a dict with keys ``tier``, ``reason``,
    ``matched`` and ``unclassified``.

    PRECEDENCE (highest first) -- the PRODUCER is the source of truth for
    its own events; this table is a FALLBACK plus an operator escape hatch
    (Andrew, botchat #2486-#2490):

      0. EXCLUDED consumer policy  -- ABSOLUTE (signal/*; see below)
      1. USER-SIDE OVERRIDE        -- operator file, outranks the producer
      2. PRODUCER-SHIPPED TIER     -- the event's own ``data.tier``
      3. CLASSIFICATIONS table     -- consumer-side FALLBACK
      4. ``default_tier``          -- fail-LOUD default (actionable)

    Rung 0 sits above the operator override on purpose: the Signal
    exclusion is a mission-critical invariant ("too mission critical to
    risk on new shared infra"), so neither a producer NOR an override may
    pull a signal event into the shared gate. An override may still move
    anything else, and may move anything TO ``excluded`` (which only ever
    removes an event from the gate, never adds one).

    The fallback default is ``actionable`` (fail-LOUD): an
    UNKNOWN (source, tag) pair that matches no rule above is surfaced
    in the actionable tier so the loop is pressed to handle it or add
    a classifier rule, rather than silently absorbed as ambient
    context. Every intentionally-ambient pair (keepalive is
    actionable; routine cron / queue-running|done|abandoned /
    memory-reminder / alertmanager / etc.) already has an EXPLICIT
    rule above the catch-alls, so this fallback only changes the fate
    of genuinely-novel pairs — it does NOT reclassify any
    deliberately-ambient event."""
    src = source or ""
    tg = tag or ""
    msg = message or ""

    def _rule_matches(src_pat, tag_pat, pred):
        return (_match_pattern(src_pat, src)
                and _match_pattern(tag_pat, tg)
                and (pred is None or pred(msg)))

    # (0) EXCLUDED consumer policy is ABSOLUTE: a producer-shipped tier must
    # never be able to un-exclude a signal event ("too mission critical to risk
    # on new shared infra" -- the EXCLUDED rules are ordered first for exactly
    # this reason). Excluded matches therefore win even over a shipped tier.
    for src_pat, tag_pat, pred, tier, reason in CLASSIFICATIONS:
        if tier == EXCLUDED and _rule_matches(src_pat, tag_pat, pred):
            return {"tier": EXCLUDED, "reason": reason,
                    "matched": f"{src_pat}/{tag_pat}", "unclassified": False}

    # (a) USER-SIDE OVERRIDE -- the operator's word beats the producer's.
    # #2490: "w user side overrides as needed". This is the escape hatch for
    # a producer that ships a BAD tier: re-tier it here instead of patching
    # (or waiting on) the producer. Absent file == no overrides.
    if overrides is None:
        overrides, _ = load_user_overrides()
    for rule in overrides or []:
        if not (_match_pattern(rule["source"], src)
                and _match_pattern(rule["tag"], tg)):
            continue
        if rule.get("contains") and rule["contains"] not in msg:
            continue
        note = f": {rule['reason']}" if rule.get("reason") else ""
        return {"tier": rule["tier"],
                "reason": (f"user override ({rule['source']}/{rule['tag']}"
                           f" -> {rule['tier']}){note}"),
                "matched": "user-override", "unclassified": False}

    # (b) Honor a PRODUCER-SHIPPED tier when present + valid. Self-describing
    # events carry their own routing (e.g. a producer stamps data.tier=actionable
    # on nonzero-unresolved-comment events, botchat #3879), so per-PRODUCER
    # knowledge lives with the producer -- NOT as a per-tag catalog in this
    # central classifier.
    st = _normalize_shipped_tier(shipped_tier)
    if st is not None:
        return {"tier": st,
                "reason": f"producer-shipped tier ({st}) honored",
                "matched": "shipped-tier", "unclassified": False}

    # (c) Consumer-side policy table (first match wins). Holds genuine
    # consumer-side overrides (alertmanager/* -> ambient "Andrew gets push";
    # routine cron/queue transitions -> ambient) plus a shrinking set of legacy
    # per-tag rules to be migrated to shipped-priority over time. Excluded rules
    # were already handled in (0) above and cannot re-match here.
    for src_pat, tag_pat, pred, tier, reason in CLASSIFICATIONS:
        if not _rule_matches(src_pat, tag_pat, pred):
            continue
        return {"tier": tier, "reason": reason,
                "matched": f"{src_pat}/{tag_pat}", "unclassified": False}

    # (d) NOTHING matched and the producer shipped nothing -> fail-LOUD
    # default. The default STAYS actionable (deliberate; see the docstring
    # above) -- what changes here is that the event is MARKED
    # ``unclassified`` and carries a directive reason, so an operator sees
    # "add a rule / have the producer ship a tier" instead of a mystery
    # gate. Consumers (event-ack, eval-event-must-act) propagate the flag
    # into pending-actions.json and the deny banner. Observability only --
    # the routing outcome is unchanged (Andrew, botchat #2483).
    return {"tier": default_tier,
            "reason": _unclassified_reason(src, tg, default_tier),
            "matched": None, "unclassified": True}


# --- CLI ------------------------------------------------------------------

def main() -> int:
    p = argparse.ArgumentParser(
        prog="event-classify",
        description="Classify a claude-event source+tag into a tier "
                    "(ambient / actionable / excluded).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--source", help="Event source (e.g. 'cron', 'manual').")
    p.add_argument("--tag", help="Event tag (e.g. 'torrent-completed').")
    p.add_argument("--message", default="",
                   help="Event message body (used by message-conditional "
                        "rules like pr-status-change).")
    p.add_argument("--tier", "--priority", dest="tier", default=None,
                   help="Producer-SHIPPED tier (actionable|ambient|"
                        "excluded). When present + valid it takes "
                        "precedence over the consumer-side table (except an "
                        "absolute EXCLUDED match). Self-describing events "
                        "set this so per-producer knowledge stays with the "
                        "producer, not this classifier.")
    p.add_argument("--default", default=ACTIONABLE, choices=sorted(VALID_TIERS),
                   help="Tier to return when no rule matches "
                        f"(default: {ACTIONABLE} — unknown pairs fail LOUD "
                        "so the loop surfaces them rather than swallowing "
                        "them as ambient).")
    p.add_argument("--json", action="store_true",
                   help="Emit JSON instead of a bare tier name.")
    p.add_argument("--list-rules", action="store_true",
                   help="Print every rule in the classification table "
                        "and exit.")
    p.add_argument("--self-test", action="store_true",
                   help="Run the embedded test suite and exit.")
    args = p.parse_args()

    if args.self_test:
        return _self_test()

    if args.list_rules:
        ov, ov_err = load_user_overrides()
        print(f"# USER OVERRIDES (rung 1, beats producer + table) "
              f"-- {overrides_path()}")
        if ov_err:
            print(f"#   !! IGNORED (all of them): {ov_err}")
        elif not ov:
            print("#   (none -- file absent or empty)")
        for r in ov:
            c = f" [contains {r['contains']!r}]" if r.get("contains") else ""
            note = f"  {r['reason']}" if r.get("reason") else ""
            print(f"{r['source']:>16} / {r['tag']:<24}  -> "
                  f"{r['tier']:<10}{c}{note}")
        print()
        print("# CLASSIFICATIONS table (rung 3, FALLBACK for producers that "
              "ship no data.tier)")
        for src_pat, tag_pat, pred, tier, reason in CLASSIFICATIONS:
            cond = " (conditional)" if pred else ""
            print(f"{src_pat:>16} / {tag_pat:<24}  -> {tier:<10} {reason}{cond}")
        print()
        print(f"# Unmatched + unshipped -> {ACTIONABLE} (fail-loud), marked "
              f"{UNCLASSIFIED_MARK}.")
        return 1 if ov_err else 0

    if not args.source or not args.tag:
        p.error("--source and --tag are required (or use --self-test "
                "/ --list-rules)")
        return 2

    result = classify(args.source, args.tag, args.message,
                      shipped_tier=args.tier,
                      default_tier=args.default)
    if args.json:
        out = {"source": args.source, "tag": args.tag,
               "message": args.message, **result}
        print(json.dumps(out))
    else:
        print(result["tier"])
    return 0


# --- Embedded self-test ---------------------------------------------------

def _self_test() -> int:
    # Isolate from a REAL operator override file: point at a path that
    # cannot exist so the suite tests the shipped defaults, never whatever
    # the host happens to have configured.
    import tempfile
    _iso = Path(tempfile.gettempdir()) / "event-classify-self-test-no-such-file"
    os.environ["EVENT_CLASSIFY_OVERRIDES"] = str(_iso)
    _OVERRIDES_CACHE.clear()

    cases = [
        # Excluded (signal): exact + wildcard
        (("manual", "signal-dm-inbound", ""), EXCLUDED),
        (("manual", "signal-group-inbound", ""), EXCLUDED),
        (("manual", "signal-foo", ""), EXCLUDED),  # signal-* wildcard
        (("cron", "signal-anything", ""), EXCLUDED),  # signal-* across sources

        # Actionable: simple tags
        (("torrent", "torrent-completed", ""), ACTIONABLE),
        (("manual", "request-fulfilled", ""), ACTIONABLE),
        (("queue", "queue-api-dead", ""), ACTIONABLE),
        (("manual", "workbot-prompt", ""), ACTIONABLE),
        (("queue", "queue-stale-ready", ""), ACTIONABLE),
        (("manual", "slack-unread", ""), ACTIONABLE),
        # comment-triage-needed: bot-comment detector. Emitted under
        # source="cron"; MUST route actionable (win over cron/* ambient).
        (("cron", "comment-triage-needed", ""), ACTIONABLE),
        (("manual", "comment-triage-needed", ""), ACTIONABLE),
        # comment-triage-STUCK: escalated fallback (#3610). Distinct tag, still
        # actionable, and MUST win over cron/* ambient.
        (("cron", "comment-triage-STUCK", ""), ACTIONABLE),
        (("manual", "comment-triage-STUCK", ""), ACTIONABLE),
        # queue-owner-unknown: emitted under source="cron"; MUST win
        # over the cron/* ambient catch-all so an ownerless running item
        # actually presses the loop.
        (("cron", "queue-owner-unknown", ""), ACTIONABLE),
        # keepalive is actionable (ack it), and must win over the
        # claude-watch/* ambient catch-all below it.
        (("claude-watch", "keepalive", "keepalive: no event acked recently"),
            ACTIONABLE),
        # ... and so must its legacy tag, for one release.
        (("claude-watch", "heartbeat-tick", "heartbeat tick"), ACTIONABLE),
        # watcher-down is actionable (relaunch the watcher) and MUST win over
        # the claude-watch/* ambient catch-all (incident 2026-08-21).
        (("claude-watch", "watcher-down", "Watcher DOWN"),
            ACTIONABLE),
        # queue-orphaned / queue-stuck are actionable (respawn/resurrect the
        # item) and MUST win over the claude-watch/* ambient catch-all. These
        # are the events `claude-watch queue-check` emits; routing them ambient
        # was the bug that let a recreate-orphaned item never remind the loop.
        (("claude-watch", "queue-orphaned", ""), ACTIONABLE),
        (("claude-watch", "queue-stuck", ""), ACTIONABLE),
        (("queue", "queue-orphaned", ""), ACTIONABLE),
        (("queue", "queue-stuck", ""), ACTIONABLE),

        # claude-watch-alert: conditional. Fatal -> actionable.
        (("claude-watch", "claude-watch-alert", "CONTEXT CRITICALLY LOW"),
            ACTIONABLE),
        (("claude-watch", "claude-watch-alert", "main pane crashed"),
            ACTIONABLE),
        (("claude-watch", "claude-watch-alert", "auto-restart fired"),
            ACTIONABLE),
        # Non-fatal -> ambient
        (("claude-watch", "claude-watch-alert", "test-pane warning"), AMBIENT),
        (("claude-watch", "claude-watch-alert", "cannot-interrupt notice"),
            AMBIENT),

        # pr-status-change: conditional
        (("manual", "pr-status-change", "CI failure on PR #1234"),
            ACTIONABLE),
        # "CI success" is AMBIENT (botchat #2484/#2485). Real producer
        # wording, verified against live traffic.
        (("cron", "pr-status-change",
          "PR owner/repo#642: CI success (was: pending)"), AMBIENT),
        # ...and the matching real FAILURE wording stays ACTIONABLE on the
        # transition itself, so there is no ambient window before the
        # separate red-PR nudge.
        (("cron", "pr-status-change",
          "PR owner/repo#642: CI failure (was: pending)"), ACTIONABLE),
        (("cron", "pr-status-change",
          "PR owner/repo#642: merged (was: open)"), AMBIENT),
        (("manual", "pr-status-change", "new push to branch"), AMBIENT),
        (("manual", "pr-status-change", "CI pending"), AMBIENT),
        (("manual", "pr-status-change", "mergeable"), AMBIENT),
        # Merge CONFLICT is actionable: the producer emits
        # "PR <name>: mergeable=conflicting (was: <old>)" when a tracked
        # PR goes CONFLICTING/DIRTY. The operator must resolve it.
        # (botchat #3583/#2936: conflicts sat unnoticed as ambient.)
        (("cron", "pr-status-change",
          "PR foo/bar#12: mergeable=conflicting (was: mergeable)"),
            ACTIONABLE),
        # Conflict RESOLUTION stays ambient (good news, no action) — the
        # precise "mergeable=conflicting" token does NOT match
        # "mergeable=mergeable (was: conflicting)", so it does not flood.
        (("cron", "pr-status-change",
          "PR foo/bar#12: mergeable=mergeable (was: conflicting)"),
            AMBIENT),

        # Ambient: alertmanager
        (("alertmanager", "alert-firing", ""), AMBIENT),
        (("alertmanager", "alert-resolved", ""), AMBIENT),
        (("alertmanager", "random-tag", ""), AMBIENT),  # alertmanager/* wildcard

        # Ambient: cron
        (("cron", "tv-check", ""), AMBIENT),
        (("cron", "unmatched-torrents", ""), AMBIENT),
        (("cron", "anything-else", ""), AMBIENT),  # cron/* wildcard

        # Ambient: queue routine
        (("queue", "queue-running", ""), AMBIENT),
        (("queue", "queue-done", ""), AMBIENT),
        (("queue", "queue-abandoned", ""), AMBIENT),

        # Ambient: workload + watcher
        (("manual", "workload-done", ""), AMBIENT),
        (("hostjob", "hostjob-done", ""), AMBIENT),
        (("claude-watch", "memory-reminder", ""), AMBIENT),
        (("manual", "watcher-cleanup", ""), AMBIENT),
        # claude-watch/* catch-all stays ambient for non-keepalive tags.
        (("claude-watch", "some-other-tag", ""), AMBIENT),

        # Unknown -> default. The fallback default is now ACTIONABLE
        # (fail-LOUD): a genuinely-novel (source, tag) pair matching no
        # rule above surfaces in the actionable tier so the loop is
        # pressed to handle it or add a rule, rather than silently
        # swallowed as ambient. ("manual" has no */* catch-all, and
        # "novel-future-source" is not a known source, so both fall
        # through to the default.)
        (("manual", "totally-novel-tag", ""), ACTIONABLE),
        (("novel-future-source", "brand-new-tag", ""), ACTIONABLE),
        # "queue" has NO queue/* catch-all, so an unrecognized queue tag
        # also falls through to the actionable default — while the
        # explicit routine queue transitions above STILL classify
        # ambient (asserted earlier: queue-running/done/abandoned).
        (("queue", "queue-some-novel-transition", ""), ACTIONABLE),
    ]
    failures = []
    for (src, tag, msg), expected in cases:
        actual = classify(src, tag, msg)["tier"]
        if actual != expected:
            failures.append(f"  {src}/{tag} (msg={msg!r}): "
                            f"expected={expected} actual={actual}")

    # Excluded-takes-precedence test: a signal-tagged event under a
    # source that ALSO has an ambient/actionable wildcard must still
    # come back excluded.
    res = classify("alertmanager", "signal-something", "")
    if res["tier"] != EXCLUDED:
        failures.append(f"  alertmanager/signal-something: expected="
                        f"{EXCLUDED} actual={res['tier']} -- excluded "
                        f"rule must run BEFORE alertmanager/* wildcard")

    # --default flag honored when no rule matches (explicit ACTIONABLE).
    res2 = classify("torrent", "unknown-tag", default_tier=ACTIONABLE)
    if res2["tier"] != ACTIONABLE:
        failures.append(f"  default-tier override: expected="
                        f"{ACTIONABLE} actual={res2['tier']}")

    # New default is ACTIONABLE: with NO default_tier passed, an
    # unmatched pair falls through to actionable (fail-LOUD).
    res3 = classify("torrent", "unknown-tag")
    if res3["tier"] != ACTIONABLE:
        failures.append(f"  implicit default: expected={ACTIONABLE} "
                        f"actual={res3['tier']} -- unknown pairs must "
                        f"fail LOUD (actionable), not ambient")

    # The default_tier param still honors an explicit AMBIENT override
    # (so callers that WANT the old swallow-as-context stance can ask).
    res4 = classify("torrent", "unknown-tag", default_tier=AMBIENT)
    if res4["tier"] != AMBIENT:
        failures.append(f"  explicit-ambient override: expected="
                        f"{AMBIENT} actual={res4['tier']}")

    # --- Shipped-priority precedence (botchat #3879 redesign) ---------------
    # A PRODUCER-SHIPPED tier wins over the consumer-side table. This is how
    # the producer's unresolved-comment events now route actionable -- via the
    # SHIPPED tier, NOT a message regex in this file.
    r = classify("cron", "pr-status-change",
                 "PR foo/bar#12: 3 unresolved comment(s) (was: 0)",
                 shipped_tier="actionable")
    if r["tier"] != ACTIONABLE or r["matched"] != "shipped-tier":
        failures.append(f"  shipped actionable: expected actionable/shipped-tier "
                        f"got {r['tier']}/{r['matched']}")

    # A shipped tier overrides even an existing consumer-table rule (here a
    # routine 'new push' the table would otherwise call ambient).
    r = classify("manual", "pr-status-change", "new push to branch",
                 shipped_tier="ambient")
    if r["tier"] != AMBIENT or r["matched"] != "shipped-tier":
        failures.append(f"  shipped ambient override: got "
                        f"{r['tier']}/{r['matched']}")

    # An INVALID / severity-style shipped value ("high") is IGNORED -> fall
    # through to the consumer table (routine push stays ambient), never
    # mis-routed on a bad stamp.
    r = classify("manual", "pr-status-change", "new push to branch",
                 shipped_tier="high")
    if r["tier"] != AMBIENT or r["matched"] == "shipped-tier":
        failures.append(f"  invalid shipped ignored: got "
                        f"{r['tier']}/{r['matched']}")

    # No shipped tier -> pure consumer-table behavior (UNCHANGED). The reverted
    # #552 regex is GONE: an unresolved-comment message with NO shipped tier now
    # classifies ambient via the catch-all (routing comes from the producer
    # stamp, not this file).
    r = classify("cron", "pr-status-change",
                 "PR foo/bar#12: 3 unresolved comment(s) (was: 0)")
    if r["tier"] != AMBIENT:
        failures.append(f"  unstamped unresolved-comment: expected ambient "
                        f"(regex reverted) got {r['tier']}")

    # EXCLUDED is ABSOLUTE: a producer must not be able to un-exclude signal.
    r = classify("manual", "signal-dm-inbound", "from alice",
                 shipped_tier="actionable")
    if r["tier"] != EXCLUDED:
        failures.append(f"  shipped cannot un-exclude signal: got {r['tier']}")

    # --- 'add a rule' signal (#2483) ----------------------------------------
    # An unmatched + unshipped pair still routes ACTIONABLE (fail-loud,
    # UNCHANGED) but is now MARKED, with a reason naming the three fixes.
    r = classify("novel-source", "novel-tag", "")
    if r["tier"] != ACTIONABLE or not r.get("unclassified"):
        failures.append(f"  unclassified marking: expected actionable+marked, "
                        f"got {r['tier']}/unclassified={r.get('unclassified')}")
    for needle in (UNCLASSIFIED_MARK, "data.tier", "CLASSIFICATIONS",
                   "user override"):
        if needle not in r["reason"]:
            failures.append(f"  unclassified reason missing {needle!r}: "
                            f"{r['reason']!r}")
    # Every CLASSIFIED path must NOT be marked (no false 'add a rule' noise).
    for args_ in (("cron", "tv-check", ""),
                  ("torrent", "torrent-completed", ""),
                  ("manual", "signal-dm-inbound", "")):
        if classify(*args_).get("unclassified"):
            failures.append(f"  false unclassified mark on {args_}")
    if classify("cron", "anything", "", shipped_tier="ambient").get(
            "unclassified"):
        failures.append("  false unclassified mark on a shipped tier")

    # --- USER OVERRIDES (rung 1, #2490) -------------------------------------
    import tempfile as _tf
    with _tf.TemporaryDirectory() as _td:
        opath = Path(_td) / "tier-overrides.json"

        def _write(doc):
            opath.write_text(json.dumps(doc))
            _OVERRIDES_CACHE.clear()
            return load_user_overrides(opath)

        # 1. Override BEATS a producer-shipped tier -- the whole point of
        #    #2490: re-tier a badly-classifying producer without editing it.
        rules, err = _write({"overrides": [
            {"source": "cron", "tag": "pr-ci-red", "tier": "ambient",
             "reason": "I watch PRs myself"}]})
        if err:
            failures.append(f"  override parse: unexpected error {err}")
        r = classify("cron", "pr-ci-red", "CI still RED",
                     shipped_tier="actionable", overrides=rules)
        if r["tier"] != AMBIENT or r["matched"] != "user-override":
            failures.append(f"  override must beat shipped tier: got "
                            f"{r['tier']}/{r['matched']}")
        if "I watch PRs myself" not in r["reason"]:
            failures.append(f"  override reason not surfaced: {r['reason']!r}")

        # 2. Override BEATS the consumer table too.
        rules, _ = _write([{"tag": "tv-check", "tier": "actionable"}])
        r = classify("cron", "tv-check", "", overrides=rules)
        if r["tier"] != ACTIONABLE or r["matched"] != "user-override":
            failures.append(f"  override must beat table: got "
                            f"{r['tier']}/{r['matched']}")

        # 3. Override CANNOT un-exclude signal (rung 0 is absolute).
        rules, _ = _write([{"tag": "signal-*", "tier": "actionable"}])
        r = classify("manual", "signal-dm-inbound", "from alice",
                     overrides=rules)
        if r["tier"] != EXCLUDED:
            failures.append(f"  override must NOT un-exclude signal: "
                            f"got {r['tier']}")

        # 4. `contains` narrows an override to matching messages only.
        rules, _ = _write([{"tag": "pr-status-change", "contains": "merged",
                            "tier": "actionable"}])
        if classify("cron", "pr-status-change", "PR x#1: merged (was: open)",
                    overrides=rules)["tier"] != ACTIONABLE:
            failures.append("  override 'contains' should have matched")
        if classify("cron", "pr-status-change", "PR x#1: new push",
                    overrides=rules)["tier"] != AMBIENT:
            failures.append("  override 'contains' should NOT have matched")

        # 5. An override can silence the fail-loud default for a known-noisy
        #    pair without touching CLASSIFICATIONS.
        rules, _ = _write([{"source": "queue", "tag": "queue-*",
                            "tier": "ambient"}])
        r = classify("queue", "queue-blocked", "", overrides=rules)
        if r["tier"] != AMBIENT or r.get("unclassified"):
            failures.append(f"  override should pre-empt fail-loud: "
                            f"got {r['tier']}")

        # 6. MALFORMED overrides are dropped WHOLESALE + default-open: bad
        #    operator config must never break routing or partially apply.
        opath.write_text("{ not json")
        _OVERRIDES_CACHE.clear()
        rules, err = load_user_overrides(opath)
        if rules != [] or not err:
            failures.append(f"  bad JSON: expected ([], err) got ({rules}, {err})")
        rules, err = _write({"overrides": [
            {"tag": "a", "tier": "ambient"},
            {"tag": "b", "tier": "urgent"}]})  # 'urgent' is not a tier
        if rules != [] or not err:
            failures.append(f"  invalid tier must drop ALL rules: "
                            f"got ({rules}, {err})")
        # 7. Absent file is the NORMAL state: no overrides, no error.
        rules, err = load_user_overrides(Path(_td) / "nope.json")
        if rules != [] or err is not None:
            failures.append(f"  absent override file: got ({rules}, {err})")

    if failures:
        print(f"FAIL: {len(failures)} case(s):", file=sys.stderr)
        for f in failures:
            print(f, file=sys.stderr)
        return 1
    print(f"OK: {len(cases) + 30} cases pass "
          f"(incl. precedence ladder, overrides, unclassified marking).")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
