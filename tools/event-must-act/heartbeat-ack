#!/usr/bin/env python3
"""heartbeat-ack — COMPATIBILITY SHIM for the ack-driven heartbeat redesign.

REDESIGN (2026-08-21): heartbeat-ack is now folded into event-ack. ANY
event-ack (not just heartbeat-tick acks) refreshes the liveness timestamp,
so there is no longer a distinct "heartbeat ack" category. This script is
a COMPAT SHIM so existing callers (`heartbeat-ack` without args) keep
working during the transition.

The shim delegates to `event-ack ack` for any pending heartbeat-tick
entries. If event-ack is unavailable (stripped deployment, PATH issue),
it exits 0 silently — the ack-driven design tolerates missed acks
(the daemon emits a probe heartbeat-tick, and acking THAT refreshes
liveness).

Exit codes:
  0  success (entries acked, or nothing pending, or event-ack unavailable)
  1  event-ack invocation failed for a reason OTHER than "not found"
     (e.g., corrupt state file after event-ack was found)

Usage:
  heartbeat-ack                 # compat mode: ack pending heartbeat-ticks
  heartbeat-ack --help          # show this help
  heartbeat-ack --version       # show version and exit

The old heartbeat-ack CLI (with --path, --state-dir, --self-test) is
RETIRED. The touch-then-ack contract no longer applies: event-ack
updates the liveness timestamp on every ack, and the daemon checks
that timestamp (not the heartbeat_file mtime) as the primary liveness
signal. The heartbeat_file still exists for fallback/compatibility,
but the main loop no longer needs a distinct "touch + ack" wrapper.

For the full event-ack surface (ingest, add, list, clear, drain-ambient),
invoke `event-ack` directly.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

__version__ = "2.0.0-compat"


def _resolve_event_ack() -> list[str] | None:
    """Command prefix for event-ack, or None if it can't be found."""
    env_bin = os.environ.get("EVENT_ACK_BIN", "").strip()
    if env_bin:
        return [env_bin]
    cli = shutil.which("event-ack")
    if cli:
        return [cli]
    sibling = Path(__file__).resolve().parent / "event-ack"
    if sibling.exists():
        return [sys.executable, str(sibling)]
    return None


def _ack_via_event_ack(state_dir: str | None) -> int:
    """Delegate to event-ack to ack any pending heartbeat-tick entries.

    Returns 0 on success (entries acked, or nothing pending, or event-ack
    not found). Returns 1 if event-ack was found but failed for a reason
    other than "no such entry" (e.g., corrupt state).
    """
    prefix = _resolve_event_ack()
    if prefix is None:
        # event-ack not found — this is a stripped deployment or PATH issue.
        # Exit 0 silently: the ack-driven design tolerates missed acks (the
        # daemon emits a probe heartbeat-tick, and acking THAT refreshes
        # liveness).
        return 0

    # List pending heartbeat-tick entries via event-ack list --json.
    list_cmd = prefix + ["list", "--json"]
    if state_dir:
        list_cmd += ["--state-dir", state_dir]
    try:
        proc = subprocess.run(
            list_cmd, capture_output=True, text=True, timeout=10, check=False
        )
    except (OSError, subprocess.SubprocessError) as exc:
        print(
            f"heartbeat-ack: warning: event-ack list failed: {exc}",
            file=sys.stderr,
        )
        return 0  # Tolerate the failure

    if proc.returncode != 0:
        # event-ack list failed — maybe corrupt state, maybe missing state dir.
        # Tolerate it (exit 0) rather than blocking the main loop.
        detail = (proc.stderr or proc.stdout or "").strip()
        print(
            f"heartbeat-ack: warning: event-ack list exited {proc.returncode}: {detail}",
            file=sys.stderr,
        )
        return 0

    # Parse the JSON to find heartbeat-tick entries.
    import json

    try:
        data = json.loads(proc.stdout)
        pending = data.get("pending", [])
    except (json.JSONDecodeError, ValueError, KeyError):
        print(
            "heartbeat-ack: warning: event-ack list returned unparseable JSON",
            file=sys.stderr,
        )
        return 0

    # Filter to heartbeat-tick entries (key starts with "heartbeat-tick:" or
    # source_event contains "heartbeat-tick").
    hb_keys = []
    for entry in pending:
        if not isinstance(entry, dict):
            continue
        key = entry.get("key", "")
        source = entry.get("source_event", "")
        if (
            key == "heartbeat-tick"
            or key.startswith("heartbeat-tick:")
            or source == "heartbeat-tick"
            or source.endswith("/heartbeat-tick")
        ):
            if key and key not in hb_keys:
                hb_keys.append(key)

    if not hb_keys:
        # No heartbeat-tick entries pending — nothing to do.
        return 0

    # Ack each heartbeat-tick entry via event-ack ack.
    for key in hb_keys:
        ack_cmd = prefix + ["ack", key, "--action", "heartbeat-ack (compat shim)"]
        if state_dir:
            ack_cmd += ["--state-dir", state_dir]
        try:
            proc = subprocess.run(
                ack_cmd, capture_output=True, text=True, timeout=10, check=False
            )
        except (OSError, subprocess.SubprocessError) as exc:
            print(
                f"heartbeat-ack: warning: event-ack ack {key!r} failed: {exc}",
                file=sys.stderr,
            )
            continue
        if proc.returncode != 0:
            detail = (proc.stderr or proc.stdout or "").strip()
            print(
                f"heartbeat-ack: warning: event-ack ack {key!r} exited {proc.returncode}: {detail}",
                file=sys.stderr,
            )
            continue

    return 0


def main(argv: list[str] | None = None) -> int:
    if argv is None:
        argv = sys.argv[1:]

    parser = argparse.ArgumentParser(
        prog="heartbeat-ack",
        description=(
            "Compatibility shim for the ack-driven heartbeat redesign. "
            "Delegates to event-ack to ack pending heartbeat-tick entries."
        ),
        epilog=(
            "The old heartbeat-ack CLI (--path, --state-dir, --self-test) is "
            "retired. Use event-ack directly for the full surface."
        ),
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {__version__}",
    )
    parser.add_argument(
        "--state-dir",
        default=None,
        help="claude-events state dir (default: $CLAUDE_EVENT_STATE_DIR or ~/.config/claude-events).",
    )
    args = parser.parse_args(argv)

    return _ack_via_event_ack(args.state_dir)


if __name__ == "__main__":
    sys.exit(main())
