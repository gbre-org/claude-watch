#!/usr/bin/env bash
# Tests for cw-inbox-delivery-check with a stubbed curl and claude-watch.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$HERE/../cw-inbox-delivery-check"
fails=0
pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n' "$1"; fails=$((fails + 1)); }

setup() {
    SBX="$(mktemp -d)"; BIN="$SBX/bin"; LOG="$SBX/inject.log"; mkdir -p "$BIN"; : > "$LOG"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s"\n' "$LOG" > "$BIN/claude-watch"
    printf '#!/usr/bin/env bash\nif [ -f "%s/fail" ]; then exit 22; fi\ncat "%s/body.json"\n' "$SBX" "$SBX" > "$BIN/curl"
    chmod +x "$BIN/claude-watch" "$BIN/curl"
}
run() {
    env PATH="$BIN:$PATH" CW_INBOX_UNREAD_URL=http://x CLAUDE_EVENT_STATE_DIR="$SBX/state" \
        CW_INBOX_DELIVERY_NOW=10000 "$@" bash "$SCRIPT"
}
count() { grep -c . "$LOG" 2>/dev/null || true; }

setup; echo '{"messages":[{"id":7,"ts":9000,"read_at":null}]}' > "$SBX/body.json"
run >/dev/null 2>&1
[ "$(count)" = 1 ] && grep -q "7 unread" "$LOG" && pass "old unread -> inject naming id" || fail "old unread"
run >/dev/null 2>&1
[ "$(count)" = 1 ] && pass "cooldown suppresses repeat" || fail "cooldown"
rm -rf "$SBX"

setup; echo '{"messages":[{"id":8,"ts":9900,"read_at":null}]}' > "$SBX/body.json"
run >/dev/null 2>&1
[ "$(count)" = 0 ] && pass "fresh unread (<5min) -> no inject" || fail "fresh unread"
rm -rf "$SBX"

setup; echo '{"messages":[{"id":9,"ts":1,"read_at":5}]}' > "$SBX/body.json"
run >/dev/null 2>&1
[ "$(count)" = 0 ] && pass "read message -> no inject" || fail "read"
rm -rf "$SBX"

setup; touch "$SBX/fail"
run >/dev/null 2>&1; rc=$?
[ "$rc" = 0 ] && [ "$(count)" = 0 ] && pass "API failure -> default-open" || fail "api failure"
rm -rf "$SBX"

setup
rc=$(env PATH="$BIN:$PATH" bash "$SCRIPT" >/dev/null 2>&1; echo $?)
[ "$rc" = 0 ] && [ "$(count)" = 0 ] && pass "no API base -> exit 0" || fail "no api base"
rm -rf "$SBX"
[ "$fails" = 0 ] || { echo "$fails failure(s)"; exit 1; }
