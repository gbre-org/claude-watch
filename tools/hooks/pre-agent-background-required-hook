#!/usr/bin/env python3
"""PreToolUse hook for the Agent tool -- reject explicitly-foreground spawns.

Historically the Claude Code harness ran the ``Agent`` tool FOREGROUND
(synchronous, blocking the whole main loop until the sub-agent finishes)
unless the spawn explicitly passed ``run_in_background: true``. A foreground
agent defeats the "main loop is a dispatcher, not a worker" model -- the loop
can't service watchers, queue events, or anything else while it blocks. This
hook existed to make background-spawning a hard invariant.

**Newer harness builds dropped ``run_in_background`` from the Agent tool
schema entirely and background subagents natively** ("Subagents run in the
background; you'll be notified when one completes"). On those builds the
operator cannot express the value this hook used to demand, so requiring it
denied *every* spawn -- 100%, not just the foreground ones -- and forced the
main loop to do all work inline, which is the exact opposite of the invariant
being protected. Observed 2026-08-13 on two independent deployments (host
main loop + workbot container) and confirmed across a full process restart.

**A guard whose satisfying condition the caller can no longer express is not
a guard, it is a wall.** So the check is now capability-aware, keyed on
whether the caller's schema has the parameter at all:

- ``run_in_background`` ABSENT from ``tool_input`` -> ALLOW. Either the
  harness has no such parameter (it backgrounds natively -- nothing to
  guard), or it does and the operator omitted it, in which case the harness
  default applies. Not distinguishable from inside the hook, and on current
  builds the first case is the real one.
- ``run_in_background`` present and truthy -> ALLOW (explicitly backgrounded).
- ``run_in_background`` present and FALSY -> DENY. This is the only case that
  still means what the original check meant: a harness that offers the
  parameter, and a caller that explicitly opted into blocking the main loop.

Decision protocol (matches the other PreToolUse hooks in this directory):
- Exit 0 with empty JSON ``{}`` -> allow silently.
- Exit 0 with ``hookSpecificOutput.permissionDecision == "deny"`` + a banner
  -> block the tool.
- Default-OPEN on any internal error -- a hook bug must never blackhole the
  Agent tool.

Wiring (in ``~/.claude/settings.json``)::

    {"hooks": {"PreToolUse": [{"matcher": "Agent", "hooks": [
        {"type": "command",
         "command": ".../pre-agent-background-required-hook",
         "timeout": 5}]}]}}

Emergency bypass: set ``AGENT_FOREGROUND_OK=1`` in env (audited, best-effort).

Per-prompt opt-out marker: if the Agent prompt contains the literal string
``FOREGROUND_AGENT_OK:`` (uppercase, anywhere), the check is skipped and the
foreground spawn is allowed. The trailing text (to newline / 200 chars) is the
audited reason. Use only for a genuinely-must-block-the-loop case.

Embedded tests: run ``pre-agent-background-required-hook --test``.
"""

from __future__ import annotations

import datetime as _dt
import json
import os
import sys
from pathlib import Path

AGENT_TOOL_NAMES = {"Agent", "Task"}

BYPASS_ENV = "AGENT_FOREGROUND_OK"
MARKER = "FOREGROUND_AGENT_OK:"
MARKER_REASON_MAX = 200

BYPASS_LOG_DIR = Path(os.path.expanduser("~/.config/claude"))
BYPASS_LOG_PATH = BYPASS_LOG_DIR / "agent-foreground-bypass.log"


def _allow() -> dict:
    return {}


def _deny(reason: str, banner: str) -> dict:
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        },
        "systemMessage": banner,
    }


def _banner() -> str:
    return (
        "!! BLOCKED: Agent spawn with run_in_background explicitly false\n"
        "!!\n"
        "!! A foreground agent blocks the entire main loop until the\n"
        "!! sub-agent finishes. The main loop is a dispatcher, not a worker:\n"
        "!! it must stay free to service watchers, queue events, and\n"
        "!! context-warnings while agents run.\n"
        "!!\n"
        "!! Fix: drop the parameter, or re-spawn with\n"
        "!!     run_in_background: true\n"
        "!! You'll be notified when the agent completes.\n"
        "!!\n"
        "!! NOTE: omitting run_in_background entirely is ALLOWED -- newer\n"
        "!! harness builds have no such parameter and background subagents\n"
        "!! natively. Only an explicit false reaches this banner.\n"
        "!!\n"
        "!! Genuinely need a blocking foreground agent? Add this line to the\n"
        "!! prompt (audited):\n"
        "!!     FOREGROUND_AGENT_OK: <one-line reason>\n"
        "!! or set AGENT_FOREGROUND_OK=1 in env (audited).\n"
        "!!\n"
        "!! Hook source: pre-agent-background-required-hook"
    )


def _truthy_background(val) -> bool:
    """True only for an explicit affirmative run_in_background value.

    The harness passes a real bool when the param is set; be lenient about
    string-encoded truthy values too, but treat absent / false / empty as
    foreground.
    """
    if val is True:
        return True
    if isinstance(val, str):
        return val.strip().lower() in ("true", "1", "yes")
    if isinstance(val, (int, float)) and not isinstance(val, bool):
        return val != 0
    return False


def _extract_marker_reason(prompt: str):
    if not prompt or MARKER not in prompt:
        return None
    tail = prompt[prompt.find(MARKER) + len(MARKER):]
    nl = tail.find("\n")
    reason = tail if nl < 0 else tail[:nl]
    return reason.strip()[:MARKER_REASON_MAX]


def _log_bypass(mode: str, reason: str, prompt_preview: str, session_id=None) -> None:
    try:
        BYPASS_LOG_DIR.mkdir(parents=True, exist_ok=True)
        rec = {
            "ts": _dt.datetime.now(_dt.timezone.utc).isoformat(),
            "mode": mode,
            "reason": reason,
            "prompt_preview": (prompt_preview or "")[:200],
            "session_id": session_id,
            "pid": os.getpid(),
        }
        with BYPASS_LOG_PATH.open("a") as fh:
            fh.write(json.dumps(rec) + "\n")
        try:
            BYPASS_LOG_PATH.chmod(0o600)
        except OSError:
            pass
    except Exception:
        pass


def _evaluate(payload: dict) -> dict:
    if not isinstance(payload, dict):
        return _allow()

    if payload.get("tool_name", "") not in AGENT_TOOL_NAMES:
        return _allow()

    tool_input = payload.get("tool_input", {})
    if not isinstance(tool_input, dict):
        tool_input = {}

    prompt = tool_input.get("prompt", "")
    if not isinstance(prompt, str):
        prompt = ""
    session_id = payload.get("session_id")

    # Capability check FIRST: if the caller's schema has no run_in_background
    # parameter at all, there is nothing to demand. Newer harness builds
    # dropped it and background subagents natively; demanding an
    # inexpressible value would deny 100% of spawns. See module docstring.
    if "run_in_background" not in tool_input:
        return _allow()

    # Already background -> allow.
    if _truthy_background(tool_input.get("run_in_background")):
        return _allow()

    # Env bypass (audited).
    if os.environ.get(BYPASS_ENV) == "1":
        _log_bypass("env", os.environ.get(BYPASS_ENV, ""), prompt, session_id)
        return _allow()

    # Per-prompt marker bypass (audited).
    marker_reason = _extract_marker_reason(prompt)
    if marker_reason is not None:
        _log_bypass("marker", marker_reason, prompt, session_id)
        return _allow()

    return _deny(
        "Agent spawned with run_in_background explicitly false -- blocks the main loop.",
        _banner(),
    )


def main() -> int:
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
    except Exception:
        # Default-OPEN: a parse failure must not blackhole the Agent tool.
        print(json.dumps(_allow()))
        return 0
    try:
        decision = _evaluate(payload)
    except Exception:
        decision = _allow()
    print(json.dumps(decision))
    return 0


# --------------------------------------------------------------------------
# Embedded tests: pre-agent-background-required-hook --test
# --------------------------------------------------------------------------
def _run_tests() -> int:
    fails = 0

    def check(name, cond):
        nonlocal fails
        if not cond:
            fails += 1
            print(f"FAIL: {name}")
        else:
            print(f"ok: {name}")

    def is_deny(d):
        return d.get("hookSpecificOutput", {}).get("permissionDecision") == "deny"

    check("non-agent allowed", _evaluate({"tool_name": "Bash", "tool_input": {}}) == {})

    # Capability case: the current harness's Agent schema has NO
    # run_in_background parameter, so a normal spawn carries only
    # prompt/subagent_type/description. Demanding the absent key here is what
    # denied 100% of spawns on 2026-08-13; it must ALLOW.
    check("agent without rib key allowed (schema lacks the param)", _evaluate(
        {"tool_name": "Agent", "tool_input": {
            "prompt": "do x", "subagent_type": "general-purpose",
            "description": "do x"}}) == {})
    check("agent empty input allowed", _evaluate(
        {"tool_name": "Agent", "tool_input": {}}) == {})
    check("task without rib key allowed", _evaluate(
        {"tool_name": "Task", "tool_input": {}}) == {})

    # The residual guard: an explicit falsy value still means the caller had
    # the parameter available and chose to block the loop.
    check("agent rib=false denied", is_deny(_evaluate(
        {"tool_name": "Agent", "tool_input": {"run_in_background": False}})))
    check("agent rib='false' denied", is_deny(_evaluate(
        {"tool_name": "Agent", "tool_input": {"run_in_background": "false"}})))
    check("agent rib=None denied", is_deny(_evaluate(
        {"tool_name": "Agent", "tool_input": {"run_in_background": None}})))

    check("agent rib=true allowed", _evaluate(
        {"tool_name": "Agent", "tool_input": {"run_in_background": True}}) == {})
    check("agent rib='true' allowed", _evaluate(
        {"tool_name": "Agent", "tool_input": {"run_in_background": "true"}}) == {})

    # Bypasses still work on the one case that can still deny.
    check("marker bypass allowed", _evaluate(
        {"tool_name": "Agent", "tool_input": {
            "run_in_background": False,
            "prompt": "FOREGROUND_AGENT_OK: ci-wait shim"}}) == {})
    os.environ[BYPASS_ENV] = "1"
    try:
        check("env bypass allowed", _evaluate(
            {"tool_name": "Agent", "tool_input": {
                "run_in_background": False, "prompt": "x"}}) == {})
    finally:
        del os.environ[BYPASS_ENV]
    check("malformed allowed", _evaluate("not a dict") == {})

    print(f"\n{'PASS' if fails == 0 else 'FAIL'}: {fails} failure(s)")
    return 1 if fails else 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--test":
        sys.exit(_run_tests())
    sys.exit(main())
